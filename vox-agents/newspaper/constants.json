{
  "distances": {
    "adjacent": 4,
    "neighboring": 7,
    "nearby": 15,
    "regional": 25
  },
  "spans": {
    "recent": 5,
    "short": 10,
    "medium": 20,
    "long": 40
  },
  "sizes": {
    "town": 5,
    "largeCity": 15,
    "metropolis": 25
  },
  "shares": {
    "minority": 0.25,
    "majority": 0.5,
    "dominant": 0.75
  },
  "terms": {
    "civilization": "self.knows('name') ? self.name.trim() || undefined : undefined",
    "leader": "self.knows('leader') ? self.leader.trim() || undefined : undefined",
    "civilizationAdjective": "self.knows('name') ? ({ __proto__: null, America: 'American', Arabia: 'Arabian', Assyria: 'Assyrian', Austria: 'Austrian', Babylon: 'Babylonian', Brazil: 'Brazilian', Byzantium: 'Byzantine', Carthage: 'Carthaginian', China: 'Chinese', Denmark: 'Danish', Egypt: 'Egyptian', England: 'English', Ethiopia: 'Ethiopian', France: 'French', Germany: 'German', Greece: 'Greek', India: 'Indian', Indonesia: 'Indonesian', Japan: 'Japanese', Korea: 'Korean', Mongolia: 'Mongolian', Morocco: 'Moroccan', Nubia: 'Nubian', Persia: 'Persian', Poland: 'Polish', Polynesia: 'Polynesian', Portugal: 'Portuguese', Rome: 'Roman', Russia: 'Russian', Siam: 'Siamese', Songhai: 'Songhai', Spain: 'Spanish', Sweden: 'Swedish', 'The Aztecs': 'Aztec', 'The Celts': 'Celtic', 'The Huns': 'Hunnic', 'The Inca': 'Incan', 'The Iroquois': 'Iroquois', 'The Maya': 'Mayan', 'The Netherlands': 'Dutch', 'The Ottomans': 'Ottoman', 'The Shoshone': 'Shoshone', 'The Zulus': 'Zulu', Venice: 'Venetian' })[self.name.trim()] : undefined"
  },
  "types": {
    "settlers": ["Settler", "Pioneer", "Colonist"],
    "workers": ["Worker", "Work Boat"],
    "missionaries": ["Missionary", "Inquisitor", "Great Prophet"],
    "greatPeople": [
      "Great Admiral", "Great Artist", "Great Diplomat", "Great Engineer", "Great General",
      "Great Merchant", "Great Musician", "Great Prophet", "Great Scientist", "Great Writer"
    ],
    "defenses": ["Walls", "Castle", "Arsenal", "Military Base", "Walls of Babylon", "Qila", "Bastion Fort"],
    "ideologies": ["Order", "Freedom", "Autocracy"],
    "worldProjects": [
      "World's Fair", "International Games", "International Space Station", "Global Wargames",
      "Treasure Fleet", "United Nations"
    ],
    "northAmericanCivilizations": ["America", "The Iroquois", "The Shoshone"],
    "mesoamericanCivilizations": ["The Aztecs", "The Maya"],
    "southAmericanCivilizations": ["Brazil", "The Inca"],
    "northwesternEuropeanCivilizations": ["Denmark", "England", "France", "Sweden", "The Celts", "The Netherlands"],
    "centralAndEasternEuropeanCivilizations": ["Austria", "Germany", "Poland", "Russia"],
    "southernEuropeanCivilizations": ["Byzantium", "Greece", "Portugal", "Rome", "Spain", "Venice"],
    "northAfricanCivilizations": ["Carthage", "Egypt", "Morocco", "Nubia"],
    "subSaharanAfricanCivilizations": ["Ethiopia", "Songhai", "The Zulus"],
    "westAsianCivilizations": ["Arabia", "Assyria", "Babylon", "Persia", "The Ottomans"],
    "southAsianCivilizations": ["India"],
    "eastAsianCivilizations": ["China", "Japan", "Korea", "Mongolia"],
    "southeastAsianAndPacificCivilizations": ["Indonesia", "Polynesia", "Siam"],
    "eurasianSteppeCivilizations": ["Mongolia", "The Huns"]
  },
  "shortcuts": {
    "city": {
      "neighbor": "city.foreign && city.distance.own <= neighboring",
      "nearby": "city.foreign && city.distance.own <= nearby",
      "frontier": "city.own && cities.some(c => c.foreign && distance(c, city) <= neighboring)",
      "starving": "city.foodPerTurn < 0 && city.foodStored < -city.foodPerTurn * recent",
      "besieged": "city.owner.atWar && city.hitPoints < city.maxHitPoints",
      "conquered": "city.isOccupied || city.isPuppet",
      "followsAnotherReligion": "city.own && city.knows('majorityReligion') && typeof city.majorityReligion === 'string' && city.majorityReligion.length > 0 && city.majorityReligion !== self.foundedReligion"
    },
    "player": {
      "neighbor": "!player.self && player.distance <= neighboring",
      "nearby": "!player.self && player.distance <= nearby",
      "rival": "player.major && !player.self && !player.friend && !player.ally",
      "alliedCityState": "player.knows('majorAlly') && player.majorAlly !== null && player.majorAlly.self === true",
      "friendlyCityState": "player.knows('cityState') && player.cityState === true && player.knows('majorAlly') && !player.is.alliedCityState && player.relation(self).friend === true",
      "hasFoundedReligion": "player.knows('foundedReligion') && typeof player.foundedReligion === 'string' && player.foundedReligion.length > 0",
      "hasMajorityReligion": "player.knows('majorityReligion') && typeof player.majorityReligion === 'string' && player.majorityReligion.length > 0",
      "northAmerican": "player.major && northAmericanCivilizations.includes(player.name)",
      "mesoamerican": "player.major && mesoamericanCivilizations.includes(player.name)",
      "southAmerican": "player.major && southAmericanCivilizations.includes(player.name)",
      "northwesternEuropean": "player.major && northwesternEuropeanCivilizations.includes(player.name)",
      "centralAndEasternEuropean": "player.major && centralAndEasternEuropeanCivilizations.includes(player.name)",
      "southernEuropean": "player.major && southernEuropeanCivilizations.includes(player.name)",
      "northAfrican": "player.major && northAfricanCivilizations.includes(player.name)",
      "subSaharanAfrican": "player.major && subSaharanAfricanCivilizations.includes(player.name)",
      "westAsian": "player.major && westAsianCivilizations.includes(player.name)",
      "southAsian": "player.major && southAsianCivilizations.includes(player.name)",
      "eastAsian": "player.major && eastAsianCivilizations.includes(player.name)",
      "southeastAsianAndPacific": "player.major && southeastAsianAndPacificCivilizations.includes(player.name)",
      "eurasianSteppe": "player.major && eurasianSteppeCivilizations.includes(player.name)"
    },
    "pair": {
      "foreignWar": "pair.atWar && !pair.involvesSelf && pair.majors"
    },
    "incident": {
      "incomingMajorDeclaration": "incident.directDeclaration && incident.knows('role') && incident.role === 'target' && incident.knows('initiator') && incident.initiator.knows('major') && incident.initiator.major && incident.initiator.knows('id')"
    }
  }
}
