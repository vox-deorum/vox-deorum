[
  {
    "id": "probe-treasury",
    "subject": "player",
    "when": [
      "player.self",
      "player.gold >= probeTreasury"
    ],
    "values": {
      "treasury": "player.gold"
    },
    "importance": 65
  },
  {
    "id": "probe-huns-riding",
    "subject": "event",
    "event": "TeamTechResearched",
    "when": [
      "event.tech == 'Horseback Riding'",
      "!event.knows('changeAmount') || event.changeAmount > 0",
      "event.knows('player') && !['The Huns', 'Huns'].includes(event.player.name)",
      "players.some(p => ['The Huns', 'Huns'].includes(p.name) && distance(event.player, p) <= neighboring)"
    ],
    "values": { "civilization": "event.player.name", "technology": "event.tech" },
    "importance": 65
  },
  {
    "id": "probe-ideology-adopted",
    "subject": "event",
    "event": "PlayerAdoptPolicyBranch",
    "when": ["ideologies.includes(event.branch)"],
    "values": { "civilization": "event.player.name", "ideology": "event.branch" },
    "importance": 65
  },
  {
    "id": "probe-foreign-birth",
    "subject": "event",
    "event": "UnitCreated",
    "when": [
      "event.knows('person')",
      "event.kind == 'born'",
      "event.knows('player') && event.player.knows('name') && !event.player.self"
    ],
    "values": {
      "person": "event.person",
      "civilization": "event.player.name"
    },
    "importance": 70
  },
  {
    "id": "probe-obituary",
    "subject": "event",
    "event": ["GreatPersonExpended", "UnitPrekill"],
    "when": ["event.knows('person')", "event.kind == 'expended' || event.kind == 'died'"],
    "values": {
      "person": "event.person",
      "kind": "event.kind",
      "civilization": "event.knows('player') && event.player.knows('name') ? event.player.name : 'their people'"
    },
    "importance": 75
  },
  {
    "id": "probe-culture-opinion",
    "subject": "city",
    "when": [
      "city.own",
      "city.unhappiness.top == 'culture'",
      "city.unhappiness.culture >= 2"
    ],
    "values": {
      "culture": "city.unhappiness.culture",
      "top": "city.unhappiness.top"
    },
    "tags": ["culture"],
    "importance": 20
  },
  {
    "id": "probe-peace",
    "subject": "pair",
    "when": ["pair.involvesSelf", "pair.atWar == false"],
    "values": { "other": "pair.other.name" },
    "tags": ["international"],
    "importance": 60
  },
  {
    "id": "probe-retraction",
    "subject": "pair",
    "when": [
      "pair.involvesSelf",
      "pair.atWar",
      "printed('probe-peace', pair) && turn - printed('probe-peace', pair).turn <= short"
    ],
    "values": {
      "other": "pair.other.name",
      "sincePeace": "turn - printed('probe-peace', pair).turn"
    },
    "tags": ["international"],
    "importance": 80
  },
  {
    "id": "probe-hundredth-issue",
    "subject": "world",
    "when": ["press.issues == 99"],
    "values": { "issue": "press.issues + 1" },
    "tags": ["domestic"],
    "importance": 60
  },
  {
    "id": "probe-quiet-spell",
    "subject": "world",
    "when": ["press.lastIssueTurn != null && turn - press.lastIssueTurn >= medium"],
    "values": { "gap": "turn - press.lastIssueTurn" },
    "chance": 0.25,
    "tags": ["domestic"],
    "importance": 30
  }
]
