[
  {
    "id": "probe-treasury",
    "subject": "player",
    "when": [
      "player.self",
      "player.gold >= probeTreasury"
    ],
    "values": {
      "treasury": "player.gold"
    },
    "tier": "notable",
    "adjust": "5"
  },
  {
    "id": "probe-huns-riding",
    "subject": "event",
    "event": "TeamTechResearched",
    "when": [
      "event.tech == 'Horseback Riding'",
      "!event.knows('changeAmount') || event.changeAmount > 0",
      "event.knows('player') && !['The Huns', 'Huns'].includes(event.player.name)",
      "players.some(p => ['The Huns', 'Huns'].includes(p.name) && distance(event.player, p) <= neighboring)"
    ],
    "values": { "civilization": "event.player.name", "technology": "event.tech" },
    "tier": "notable",
    "adjust": "5"
  },
  {
    "id": "probe-ideology-adopted",
    "subject": "event",
    "event": "PlayerAdoptPolicyBranch",
    "when": ["ideologies.includes(event.branch)"],
    "values": { "civilization": "event.player.name", "ideology": "event.branch" },
    "tier": "notable",
    "adjust": "5"
  },
  {
    "id": "probe-foreign-birth",
    "subject": "event",
    "event": "UnitCreated",
    "when": [
      "event.knows('person')",
      "event.kind == 'born'",
      "event.knows('player') && event.player.knows('name') && !event.player.self"
    ],
    "values": {
      "person": "event.person",
      "civilization": "event.player.name"
    },
    "tier": "major",
    "adjust": "-5"
  },
  {
    "id": "probe-obituary",
    "subject": "event",
    "event": ["GreatPersonExpended", "UnitPrekill"],
    "when": ["event.knows('person')", "event.kind == 'expended' || event.kind == 'died'"],
    "values": {
      "person": "event.person",
      "kind": "event.kind",
      "civilization": "event.knows('player') && event.player.knows('name') ? event.player.name : 'their people'"
    },
    "tier": "major"
  },
  {
    "id": "probe-culture-opinion",
    "subject": "city",
    "when": [
      "city.own",
      "city.unhappiness.top == 'culture'",
      "city.unhappiness.culture >= 2"
    ],
    "values": {
      "culture": "city.unhappiness.culture",
      "top": "city.unhappiness.top"
    },
    "tags": ["culture"],
    "tier": "filler",
    "adjust": "-10"
  },
  {
    "id": "probe-peace",
    "subject": "pair",
    "when": ["pair.involvesSelf", "pair.atWar == false"],
    "values": { "other": "pair.other.name" },
    "tags": ["international"],
    "tier": "notable"
  },
  {
    "id": "probe-retraction",
    "subject": "pair",
    "when": [
      "pair.involvesSelf",
      "pair.atWar",
      "printed('probe-peace', pair) && turn - printed('probe-peace', pair).turn <= short"
    ],
    "values": {
      "other": "pair.other.name",
      "sincePeace": "turn - printed('probe-peace', pair).turn"
    },
    "tags": ["international"],
    "tier": "major",
    "adjust": "5"
  },
  {
    "id": "probe-hundredth-issue",
    "subject": "world",
    "when": ["press.issues == 99"],
    "values": { "issue": "press.issues + 1" },
    "tags": ["domestic"],
    "tier": "notable"
  },
  {
    "id": "probe-quiet-spell",
    "subject": "world",
    "when": ["press.lastIssueTurn != null && turn - press.lastIssueTurn >= medium"],
    "values": { "gap": "turn - press.lastIssueTurn" },
    "chance": 0.25,
    "tags": ["domestic"],
    "tier": "filler"
  },
  {
    "id": "probe-spy-city-profile",
    "subject": "city",
    "when": [
      "city.foreign",
      "city.ourSpyPresent",
      "city.unhappiness.culture > 0"
    ],
    "values": {
      "boredom": "city.unhappiness.culture"
    },
    "tags": ["international"],
    "tier": "routine"
  },
  {
    "id": "probe-inbound-diplomat",
    "subject": "player",
    "when": [
      "!player.self",
      "player.major",
      "player.theirDiplomatHere == true",
      "player.ourDiplomatThere == false"
    ],
    "values": { "civilization": "player.name" },
    "tags": ["international"],
    "tier": "notable",
    "adjust": "-5"
  },
  {
    "id": "probe-foreign-policies",
    "subject": "player",
    "when": [
      "!player.self",
      "player.major",
      "player.ourDiplomatThere == true",
      "player.knows('policyBranches') && player.policyBranches != null && Object.values(player.policyBranches).some(branch => Array.isArray(branch) && branch.length > 0)"
    ],
    "values": {
      "civilization": "player.name",
      "policyBranch": "(() => { const names = Object.entries(player.policyBranches).filter(([, policies]) => Array.isArray(policies) && policies.length > 0).map(([name]) => name).sort(); const tiers = [ideologies, ['Imperialism', 'Industry', 'Rationalism'], ['Fealty', 'Statecraft', 'Artistry'], ['Tradition', 'Progress', 'Authority']]; const latest = tiers.map(tier => names.filter(name => tier.includes(name))).find(tier => tier.length > 0) ?? names; return latest[(turn + player.id) % latest.length]; })()",
      "policies": "player.policyBranches[policyBranch].join(', ')"
    },
    "tags": ["politics"],
    "tier": "notable",
    "adjust": "-5"
  },
  {
    "id": "probe-espionage-tech",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.perspective == 'source'",
      "event.knows('tech')"
    ],
    "values": {
      "technology": "event.tech",
      "civilization": "event.knows('targetPlayer') && event.targetPlayer.knows('name') ? event.targetPlayer.name : 'a foreign power'",
      "operationSite": "event.knows('cityName') ? event.cityName : 'a foreign city'"
    },
    "tags": ["science"],
    "tier": "major",
    "adjust": "-5"
  },
  {
    "id": "probe-spy-loss",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.perspective == 'source'",
      "event.spyResult == 'Killed' || event.spyResult == 'KilledNotIdentified'"
    ],
    "values": {
      "operationSite": "event.knows('cityName') ? event.cityName : 'a foreign city'"
    },
    "tags": ["military"],
    "tier": "crisis",
    "adjust": "-5"
  },
  {
    "id": "probe-defender-report",
    "subject": "event",
    "event": "EspionageResult",
    "when": ["event.perspective == 'target'"],
    "values": {
      "civilization": "event.knows('sourcePlayer') && event.sourcePlayer.knows('name') && !event.sourcePlayer.self ? event.sourcePlayer.name : 'an unidentified power'",
      "operationSite": "event.knows('cityName') ? event.cityName : 'our territory'"
    },
    "tags": ["international"],
    "tier": "major"
  },
  {
    "id": "probe-election-influence",
    "subject": "event",
    "event": ["ElectionResultSuccess", "ElectionResultFailure"],
    "when": [
      "event.playerId == self.id",
      "event.knows('influenceChange')",
      "event.influenceChange != 0"
    ],
    "values": {
      "change": "event.influenceChange",
      "cityState": "event.knows('cityState') ? event.cityState : 'a city-state'"
    },
    "tags": ["international"],
    "tier": "notable",
    "adjust": "-5"
  },
  {
    "id": "probe-front-zone",
    "subject": "player",
    "when": [
      "player.self",
      "player.knows('tacticalZones')",
      "player.tacticalZones.some(z => z.knows('city') && Object.values(z.units).some(types => Object.values(types).some(count => count > 0)))"
    ],
    "values": {
      "frontIndex": "player.tacticalZones.findIndex(z => z.knows('city') && Object.values(z.units).some(types => Object.values(types).some(count => count > 0)))",
      "turn": "turn",
      "frontCity": "player.tacticalZones[frontIndex].city",
      "domain": "player.tacticalZones[frontIndex].domain.toLowerCase()",
      "posture": "player.tacticalZones[frontIndex].posture",
      "counts": "Object.entries(player.tacticalZones[frontIndex].units).flatMap(([civilization, types]) => Object.entries(types).filter(([, count]) => count > 0).map(([type, count]) => civilization + ' ' + type + ': ' + count)).join('; ')"
    },
    "tags": ["international"],
    "tier": "major",
    "adjust": "5"
  },
  {
    "id": "probe-ship-launch",
    "subject": "city",
    "when": [
      "city.trained.some(t => t.knows('port') && t.knows('unit') && probeNavalTypes.includes(t.unit) && t.knows('withGold') && t.withGold === false && t.knows('withFaith') && t.withFaith === false)"
    ],
    "values": {
      "launchIndex": "city.trained.findIndex(t => t.knows('port') && t.knows('unit') && probeNavalTypes.includes(t.unit) && t.knows('withGold') && t.withGold === false && t.knows('withFaith') && t.withFaith === false)",
      "ship": "city.trained[launchIndex].unit",
      "port": "city.trained[launchIndex].port"
    },
    "tags": ["military"],
    "tier": "major",
    "adjust": "-5"
  }
]
