[
  {
    "id": "stance-wartime-hawkish-national",
    "match": { "stance": ["hawkish", "national"] },
    "when": "self.atWar && story.tags.includes('military')",
    "multiplier": 1.75
  },
  {
    "id": "stance-peacetime-conciliatory",
    "match": { "stance": "conciliatory" },
    "when": "!self.atWar && story.tags.includes('diplomacy')",
    "multiplier": 1.75
  },
  {
    "id": "stance-low-happiness-critical-populist",
    "match": { "stance": ["government-critical", "populist"] },
    "when": "self.happinessPercentage < 50",
    "multiplier": 1.5
  },
  {
    "id": "stance-golden-age-high-happiness",
    "match": { "stance": "pro-government" },
    "when": "self.get('goldenAge')?.endsWith('turns remaining') || self.get('happinessPercentage') >= 60",
    "multiplier": 1.5
  },
  {
    "id": "stance-domestic-cities-local",
    "match": { "stance": "local" },
    "when": "story.tags.includes('cities') && story.tags.includes('domestic')",
    "multiplier": 1.75
  },
  {
    "id": "stance-international-national",
    "match": { "stance": "national" },
    "when": "story.tags.includes('international')",
    "multiplier": 1.5
  },
  {
    "id": "stance-wonders-science-ambitious",
    "match": { "stance": "ambitious" },
    "when": "story.tags.includes('wonders') || story.tags.includes('science')",
    "multiplier": 1.6
  },
  {
    "id": "stance-domestic-cities-populist",
    "match": { "stance": "populist" },
    "when": "story.tags.includes('cities') && story.tags.includes('domestic')",
    "multiplier": 1.5
  },
  {
    "id": "stance-neutral-on-urgent",
    "match": { "stance": "neutral" },
    "when": "story.urgent",
    "multiplier": 1.5
  },
  {
    "id": "stance-devout-traditional-religion",
    "match": { "stance": ["devout", "traditional"] },
    "when": "story.tags.includes('religion')",
    "multiplier": 1.5
  },
  {
    "id": "stance-artistic-wonders",
    "match": { "stance": "artistic" },
    "when": "story.tags.includes('wonders')",
    "multiplier": 1.5
  },
  {
    "id": "stance-rationalist-science",
    "match": { "stance": "rationalist" },
    "when": "story.tags.includes('science')",
    "multiplier": 1.5
  },
  {
    "id": "stance-industrialist-cities",
    "match": { "stance": "industrialist" },
    "when": "story.tags.includes('cities')",
    "multiplier": 1.3
  },
  {
    "id": "stance-tradition-up",
    "match": { "stance": ["traditional", "elitist"] },
    "when": "self.hasBranch('Tradition')",
    "multiplier": 1.3
  },
  {
    "id": "stance-tradition-populist-down",
    "match": { "stance": "populist" },
    "when": "self.hasBranch('Tradition')",
    "multiplier": 0.75
  },
  {
    "id": "stance-progress-up",
    "match": { "stance": ["populist", "local", "ambitious"] },
    "when": "self.hasBranch('Progress')",
    "multiplier": 1.3
  },
  {
    "id": "stance-progress-elitist-down",
    "match": { "stance": "elitist" },
    "when": "self.hasBranch('Progress')",
    "multiplier": 0.75
  },
  {
    "id": "stance-authority-up",
    "match": { "stance": ["hawkish", "national"] },
    "when": "self.hasBranch('Authority')",
    "multiplier": 1.3
  },
  {
    "id": "stance-authority-conciliatory-down",
    "match": { "stance": "conciliatory" },
    "when": "self.hasBranch('Authority')",
    "multiplier": 0.75
  },
  {
    "id": "stance-fealty-up",
    "match": { "stance": ["devout", "traditional", "elitist"] },
    "when": "self.hasBranch('Fealty')",
    "multiplier": 1.3
  },
  {
    "id": "stance-fealty-down",
    "match": { "stance": ["pluralist", "rationalist"] },
    "when": "self.hasBranch('Fealty')",
    "multiplier": 0.75
  },
  {
    "id": "stance-statecraft-up",
    "match": { "stance": ["conciliatory", "pluralist"] },
    "when": "self.hasBranch('Statecraft')",
    "multiplier": 1.3
  },
  {
    "id": "stance-statecraft-hawkish-down",
    "match": { "stance": "hawkish" },
    "when": "self.hasBranch('Statecraft')",
    "multiplier": 0.75
  },
  {
    "id": "stance-artistry-up",
    "match": { "stance": "artistic" },
    "when": "self.hasBranch('Artistry')",
    "multiplier": 1.3
  },
  {
    "id": "stance-artistry-rationalist-down",
    "match": { "stance": "rationalist" },
    "when": "self.hasBranch('Artistry')",
    "multiplier": 0.75
  },
  {
    "id": "stance-industry-up",
    "match": { "stance": ["industrialist", "elitist"] },
    "when": "self.hasBranch('Industry')",
    "multiplier": 1.3
  },
  {
    "id": "stance-industry-down",
    "match": { "stance": ["environmentalist", "populist"] },
    "when": "self.hasBranch('Industry')",
    "multiplier": 0.75
  },
  {
    "id": "stance-imperialism-up",
    "match": { "stance": ["hawkish", "national", "ambitious"] },
    "when": "self.hasBranch('Imperialism')",
    "multiplier": 1.3
  },
  {
    "id": "stance-imperialism-down",
    "match": { "stance": ["local", "conciliatory"] },
    "when": "self.hasBranch('Imperialism')",
    "multiplier": 0.75
  },
  {
    "id": "stance-rationalism-up",
    "match": { "stance": ["rationalist", "pluralist"] },
    "when": "self.hasBranch('Rationalism')",
    "multiplier": 1.3
  },
  {
    "id": "stance-rationalism-down",
    "match": { "stance": ["devout", "traditional"] },
    "when": "self.hasBranch('Rationalism')",
    "multiplier": 0.75
  },
  {
    "id": "stance-freedom-up",
    "match": { "stance": ["elitist", "pluralist", "artistic"] },
    "when": "self.ideology === 'Freedom'",
    "multiplier": 1.5
  },
  {
    "id": "stance-freedom-down",
    "match": { "stance": ["pro-government", "traditional"] },
    "when": "self.ideology === 'Freedom'",
    "multiplier": 0.75
  },
  {
    "id": "stance-order-up",
    "match": { "stance": ["populist", "ambitious", "industrialist"] },
    "when": "self.ideology === 'Order'",
    "multiplier": 1.5
  },
  {
    "id": "stance-order-down",
    "match": { "stance": ["elitist", "devout"] },
    "when": "self.ideology === 'Order'",
    "multiplier": 0.6
  },
  {
    "id": "stance-autocracy-up",
    "match": { "stance": ["pro-government", "hawkish", "national"] },
    "when": "self.ideology === 'Autocracy'",
    "multiplier": 1.5
  },
  {
    "id": "stance-autocracy-critical-conciliatory-down",
    "match": { "stance": ["government-critical", "conciliatory"] },
    "when": "self.ideology === 'Autocracy'",
    "multiplier": 0.6
  },
  {
    "id": "stance-founded-devout-up",
    "match": { "stance": "devout" },
    "when": "self.is.hasFoundedReligion",
    "multiplier": 1.4
  },
  {
    "id": "stance-founded-pluralist-down",
    "match": { "stance": "pluralist" },
    "when": "self.is.hasFoundedReligion",
    "multiplier": 0.75
  },
  {
    "id": "stance-unfounded-pluralist-up",
    "match": { "stance": "pluralist" },
    "when": "self.foundedReligion === null",
    "multiplier": 1.3
  },
  {
    "id": "stance-low-happiness-revolt",
    "match": { "stance": ["government-critical", "populist"] },
    "when": "self.happinessPercentage < 35",
    "multiplier": 1.5
  },
  {
    "id": "stance-low-happiness-pro-government",
    "match": { "stance": "pro-government" },
    "when": "self.happinessPercentage < 50",
    "multiplier": 0.75
  },
  {
    "id": "stance-happiness-revolt-pro-government",
    "match": { "stance": "pro-government" },
    "when": "self.happinessPercentage < 35",
    "multiplier": 0.5
  },
  {
    "id": "stance-golden-age-artistic-ambitious",
    "match": { "stance": ["artistic", "ambitious"] },
    "when": "self.get('goldenAge')?.endsWith('turns remaining')",
    "multiplier": 1.3
  },
  {
    "id": "stance-environmentalist-pre-industrial",
    "match": { "stance": "environmentalist" },
    "when": "self.get('era') && !['Industrial', 'Modern', 'Atomic', 'Information', 'Future'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "stance-war-weariness-hawkish-down",
    "match": { "stance": "hawkish" },
    "when": "self.wars.some(other => self.relation(other).get('warWeariness') >= 50)",
    "multiplier": 0.6
  },
  {
    "id": "stance-war-weariness-conciliatory-up",
    "match": { "stance": "conciliatory" },
    "when": "self.wars.some(other => self.relation(other).get('warWeariness') >= 50)",
    "multiplier": 1.5
  },
  {
    "id": "stance-war-weariness-critical-up",
    "match": { "stance": "government-critical" },
    "when": "self.wars.some(other => self.relation(other).get('warWeariness') >= 50)",
    "multiplier": 1.3
  },
  {
    "id": "stance-losing-war-critical-up",
    "match": { "stance": "government-critical" },
    "when": "self.wars.some(other => self.relation(other).get('warScore') <= -25)",
    "multiplier": 1.3
  },
  {
    "id": "stance-deficit-critical-up",
    "match": { "stance": "government-critical" },
    "when": "self.goldPerTurn < 0",
    "multiplier": 1.3
  },
  {
    "id": "stance-world-leader-up",
    "match": { "stance": ["pro-government", "national"] },
    "when": "self.major && self.rank('score') === 1 && majorsWith('score') >= 3",
    "multiplier": 1.2
  },
  {
    "id": "stance-winning-war-lift",
    "match": { "stance": ["hawkish", "pro-government", "national"] },
    "when": "self.wars.some(other => self.relation(other).get('warScore') >= 25)",
    "multiplier": 1.2
  },
  {
    "id": "stance-losing-war-hawkish-down",
    "match": { "stance": "hawkish" },
    "when": "self.wars.some(other => self.relation(other).get('warScore') <= -25)",
    "multiplier": 0.75
  },
  {
    "id": "stance-losing-war-conciliatory-up",
    "match": { "stance": "conciliatory" },
    "when": "self.wars.some(other => self.relation(other).get('warScore') <= -25)",
    "multiplier": 1.3
  },
  {
    "id": "stance-deficit-populist-up",
    "match": { "stance": "populist" },
    "when": "self.goldPerTurn < 0",
    "multiplier": 1.3
  },
  {
    "id": "stance-faith-under-pressure",
    "match": { "stance": ["devout", "traditional"] },
    "when": "self.is.hasFoundedReligion && self.is.hasMajorityReligion && self.majorityReligion !== self.foundedReligion",
    "multiplier": 1.3
  },
  {
    "id": "stance-last-place-critical-ambitious",
    "match": { "stance": ["government-critical", "ambitious"] },
    "when": "self.major && majorsWith('score') >= 3 && players.every(p => p.get('major') && p.get('score') !== undefined ? p.rank('score') <= self.rank('score') : true)",
    "multiplier": 1.3
  },
  {
    "id": "stance-last-pro-government-down",
    "match": { "stance": "pro-government" },
    "when": "self.major && majorsWith('score') >= 3 && players.every(p => p.get('major') && p.get('score') !== undefined ? p.rank('score') <= self.rank('score') : true)",
    "multiplier": 0.75
  },
  {
    "id": "stance-small-nation-local-up",
    "match": { "stance": "local" },
    "when": "self.cityCount <= 2",
    "multiplier": 1.3
  },
  {
    "id": "stance-small-nation-national-down",
    "match": { "stance": "national" },
    "when": "self.cityCount <= 2",
    "multiplier": 0.75
  },
  {
    "id": "stance-large-nation-national-up",
    "match": { "stance": "national" },
    "when": "self.cityCount >= 8",
    "multiplier": 1.2
  },
  {
    "id": "stance-peacetime-hawkish-down",
    "match": { "stance": "hawkish" },
    "when": "!self.atWar",
    "multiplier": 0.75
  },
  {
    "id": "stance-industrialist-pre-industrial",
    "match": { "stance": "industrialist" },
    "when": "self.get('era') && !['Industrial', 'Modern', 'Atomic', 'Information', 'Future'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.3
  },
  {
    "id": "stance-rationalist-pre-renaissance",
    "match": { "stance": "rationalist" },
    "when": "self.get('era') && !['Renaissance', 'Industrial', 'Modern', 'Atomic', 'Information', 'Future'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.5
  },
  {
    "id": "stance-vassal-critical-traditional",
    "match": { "stance": ["government-critical", "traditional"] },
    "when": "players.some(p => p.id !== self.id && self.relation(p).get('vassalOf'))",
    "multiplier": 1.3
  },
  {
    "id": "stance-vassal-pro-government-down",
    "match": { "stance": "pro-government" },
    "when": "players.some(p => p.id !== self.id && self.relation(p).get('vassalOf'))",
    "multiplier": 0.75
  },
  {
    "id": "stance-master-national-hawkish",
    "match": { "stance": ["national", "hawkish"] },
    "when": "players.some(p => p.id !== self.id && self.relation(p).get('masterOf'))",
    "multiplier": 1.2
  },
  {
    "id": "stance-denounced-hawkish-national",
    "match": { "stance": ["hawkish", "national"] },
    "when": "players.filter(p => p.id !== self.id && self.relation(p).get('denouncedByThem')).length >= 2",
    "multiplier": 1.2
  },
  {
    "id": "stance-poverty-populist-critical",
    "match": { "stance": ["populist", "government-critical"] },
    "when": "self.complaintShare(['gold', 'distress', 'famine']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "stance-poverty-elitist-down",
    "match": { "stance": "elitist" },
    "when": "self.complaintShare(['gold', 'distress', 'famine']) >= 1/3",
    "multiplier": 0.75
  },
  {
    "id": "stance-boredom-artistic-up",
    "match": { "stance": "artistic" },
    "when": "self.complaintShare(['culture']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "stance-illiteracy-rationalist-up",
    "match": { "stance": "rationalist" },
    "when": "self.complaintShare(['science']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "stance-unrest-devout-pluralist-up",
    "match": { "stance": ["devout", "pluralist"] },
    "when": "self.complaintShare(['religion']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "stance-unrest-neutral-down",
    "match": { "stance": "neutral" },
    "when": "self.complaintShare(['religion']) >= 1/3",
    "multiplier": 0.75
  },
  {
    "id": "stance-isolation-local-up",
    "match": { "stance": "local" },
    "when": "self.complaintShare(['isolation']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "stance-isolation-national-down",
    "match": { "stance": "national" },
    "when": "self.complaintShare(['isolation']) >= 1/3",
    "multiplier": 0.75
  },
  {
    "id": "stance-crowding-environmentalist-traditional-up",
    "match": { "stance": ["environmentalist", "traditional"] },
    "when": "self.complaintShare(['specialists']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "stance-crowding-industrialist-down",
    "match": { "stance": "industrialist" },
    "when": "self.complaintShare(['specialists']) >= 1/3",
    "multiplier": 0.75
  },
  {
    "id": "stance-arts-funding-artistic",
    "match": { "stance": "artistic" },
    "when": "activeResolution('Endowment for the Arts')",
    "multiplier": 1.3
  },
  {
    "id": "stance-arts-funding-rationalist-down",
    "match": { "stance": "rationalist" },
    "when": "activeResolution('Endowment for the Arts')",
    "multiplier": 0.75
  },
  {
    "id": "stance-science-funding-rationalist",
    "match": { "stance": "rationalist" },
    "when": "activeResolution('World Science Initiative')",
    "multiplier": 1.3
  },
  {
    "id": "stance-science-funding-artistic-down",
    "match": { "stance": "artistic" },
    "when": "activeResolution('World Science Initiative')",
    "multiplier": 0.75
  },
  {
    "id": "stance-world-religion-devout",
    "match": { "stance": "devout" },
    "when": "activeResolution('World Religion')",
    "multiplier": 1.3
  },
  {
    "id": "stance-world-religion-pluralist-down",
    "match": { "stance": "pluralist" },
    "when": "activeResolution('World Religion')",
    "multiplier": 0.75
  },
  {
    "id": "stance-peace-accords-conciliatory",
    "match": { "stance": "conciliatory" },
    "when": "activeResolution('Global Peace Accords')",
    "multiplier": 1.3
  },
  {
    "id": "stance-peace-accords-hawkish-down",
    "match": { "stance": "hawkish" },
    "when": "activeResolution('Global Peace Accords')",
    "multiplier": 0.75
  },
  {
    "id": "stance-casus-belli-hawkish",
    "match": { "stance": "hawkish" },
    "when": "activeResolution('Casus Belli')",
    "multiplier": 1.3
  },
  {
    "id": "stance-casus-belli-conciliatory-down",
    "match": { "stance": "conciliatory" },
    "when": "activeResolution('Casus Belli')",
    "multiplier": 0.75
  },
  {
    "id": "stance-cold-war-national",
    "match": { "stance": "national" },
    "when": "activeResolution('Cold War')",
    "multiplier": 1.3
  },
  {
    "id": "stance-cold-war-hawkish",
    "match": { "stance": "hawkish" },
    "when": "activeResolution('Cold War')",
    "multiplier": 1.2
  },
  {
    "id": "stance-cold-war-pluralist-down",
    "match": { "stance": "pluralist" },
    "when": "activeResolution('Cold War')",
    "multiplier": 0.75
  },
  {
    "id": "stance-cultural-heritage-traditional-artistic",
    "match": { "stance": ["traditional", "artistic"] },
    "when": "activeResolution('Cultural Heritage Sites') || activeResolution('Historical Landmarks')",
    "multiplier": 1.3
  },
  {
    "id": "stance-natural-heritage-environmentalist",
    "match": { "stance": "environmentalist" },
    "when": "activeResolution('Natural Heritage Sites')",
    "multiplier": 1.3
  },
  {
    "id": "stance-scholars-residence-rationalist",
    "match": { "stance": "rationalist" },
    "when": "activeResolution('Scholars in Residence')",
    "multiplier": 1.3
  },
  {
    "id": "stance-passport-system-pluralist",
    "match": { "stance": "pluralist" },
    "when": "activeResolution('Passport System')",
    "multiplier": 1.3
  },
  {
    "id": "stance-travel-ban-national",
    "match": { "stance": "national" },
    "when": "activeResolution('Travel Ban')",
    "multiplier": 1.3
  },
  {
    "id": "stance-travel-ban-pluralist-down",
    "match": { "stance": "pluralist" },
    "when": "activeResolution('Travel Ban')",
    "multiplier": 0.75
  },
  {
    "id": "stance-decolonization-populist-local",
    "match": { "stance": ["populist", "local"] },
    "when": "activeResolution('Decolonization') || activeResolution('Global Liberation')",
    "multiplier": 1.3
  },
  {
    "id": "stance-decolonization-elitist-down",
    "match": { "stance": "elitist" },
    "when": "activeResolution('Decolonization') || activeResolution('Global Liberation')",
    "multiplier": 0.75
  },
  {
    "id": "stance-world-ideology-pro-government",
    "match": { "stance": "pro-government" },
    "when": "game.knows('congress') && game.congress.get('available') && typeof self.ideology === 'string' && game.congress.get('activeResolutions')?.some(r => typeof r.name === 'string' && r.name.startsWith('World Ideology') && r.name.includes(self.ideology))",
    "multiplier": 1.3
  },
  {
    "id": "stance-world-ideology-critical",
    "match": { "stance": "government-critical" },
    "when": "game.knows('congress') && game.congress.get('available') && typeof self.ideology === 'string' && game.congress.get('activeResolutions')?.some(r => typeof r.name === 'string' && r.name.startsWith('World Ideology') && !r.name.includes(self.ideology))",
    "multiplier": 1.3
  },
  {
    "id": "stance-session-mood-conciliatory",
    "match": { "stance": "conciliatory" },
    "when": "game.knows('congress') && game.congress.get('available') && (game.congress.get('votingNow') || game.congress.get('expectedSessionTurn') <= turn + 3) && (story.tags.includes('international') || story.tags.includes('diplomacy'))",
    "multiplier": 1.2
  }
]
