[
  {
    "id": "genre-jokes-off-big-news",
    "match": { "genre": ["joke", "proverb"] },
    "when": "story.urgent || story.importance >= 80",
    "multiplier": 0.25
  },
  {
    "id": "genre-short-fillers-rise",
    "match": { "genre": ["joke", "proverb", "notice", "ledger"] },
    "when": "story.short",
    "multiplier": 2
  },
  {
    "id": "genre-analysis-editorial-important-news",
    "match": { "genre": ["analysis", "editorial"] },
    "when": "story.importance >= 70",
    "multiplier": 1.6
  },
  {
    "id": "genre-analysis-editorial-not-short",
    "match": { "genre": ["analysis", "editorial"] },
    "when": "story.short",
    "multiplier": 0.5
  },
  {
    "id": "genre-report-for-urgent-news",
    "match": { "genre": "report" },
    "when": "story.urgent",
    "multiplier": 1.5
  },
  {
    "id": "genre-anecdote-on-city-news",
    "match": { "genre": "anecdote" },
    "when": "story.tags.includes('cities')",
    "multiplier": 1.5
  },
  {
    "id": "genre-letter-low-happiness",
    "match": { "genre": "letter" },
    "when": "self.knows('happinessPercentage') && typeof self.happinessPercentage === 'number' && self.happinessPercentage < 50",
    "multiplier": 1.5
  },
  {
    "id": "genre-anecdote-off-urgent",
    "match": { "genre": "anecdote" },
    "when": "story.urgent",
    "multiplier": 0.5
  },
  {
    "id": "genre-fealty-proverb-up",
    "match": { "genre": "proverb" },
    "when": "self.hasBranch('Fealty')",
    "multiplier": 1.3
  },
  {
    "id": "genre-statecraft-analysis-up",
    "match": { "genre": "analysis" },
    "when": "self.hasBranch('Statecraft')",
    "multiplier": 1.3
  },
  {
    "id": "genre-artistry-up",
    "match": { "genre": ["anecdote", "obituary"] },
    "when": "self.hasBranch('Artistry')",
    "multiplier": 1.3
  },
  {
    "id": "genre-industry-ledger-up",
    "match": { "genre": "ledger" },
    "when": "self.hasBranch('Industry')",
    "multiplier": 1.3
  },
  {
    "id": "genre-rationalism-analysis-up",
    "match": { "genre": "analysis" },
    "when": "self.hasBranch('Rationalism')",
    "multiplier": 1.3
  },
  {
    "id": "genre-freedom-up",
    "match": { "genre": ["editorial", "letter"] },
    "when": "self.knows('ideology') && self.ideology === 'Freedom'",
    "multiplier": 1.5
  },
  {
    "id": "genre-order-up",
    "match": { "genre": ["joke", "ledger"] },
    "when": "self.knows('ideology') && self.ideology === 'Order'",
    "multiplier": 1.5
  },
  {
    "id": "genre-autocracy-notice-up",
    "match": { "genre": "notice" },
    "when": "self.knows('ideology') && self.ideology === 'Autocracy'",
    "multiplier": 1.5
  },
  {
    "id": "genre-autocracy-letter-down",
    "match": { "genre": "letter" },
    "when": "self.knows('ideology') && self.ideology === 'Autocracy'",
    "multiplier": 0.6
  },
  {
    "id": "genre-letter-revolt",
    "match": { "genre": "letter" },
    "when": "self.knows('happinessPercentage') && typeof self.happinessPercentage === 'number' && self.happinessPercentage < 35",
    "multiplier": 1.5
  },
  {
    "id": "genre-losing-war-obituary-up",
    "match": { "genre": "obituary" },
    "when": "self.knows('wars') && self.wars.some(other => self.relation(other).knows('warScore') && self.relation(other).warScore <= -25)",
    "multiplier": 1.3
  },
  {
    "id": "genre-deficit-ledger-up",
    "match": { "genre": "ledger" },
    "when": "self.knows('goldPerTurn') && self.goldPerTurn < 0",
    "multiplier": 1.3
  },
  {
    "id": "genre-poverty-letter-up",
    "match": { "genre": "letter" },
    "when": "self.complaintShare(['gold', 'distress', 'famine']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "genre-boredom-anecdote-up",
    "match": { "genre": "anecdote" },
    "when": "self.complaintShare(['culture']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "genre-illiteracy-analysis-up",
    "match": { "genre": "analysis" },
    "when": "self.complaintShare(['science']) >= 1/3",
    "multiplier": 1.3
  },
  {
    "id": "genre-world-ideology-letter",
    "match": { "genre": "letter" },
    "when": "game.knows('congress') && game.congress.available === true && self.knows('ideology') && typeof self.ideology === 'string' && game.congress.knows('activeResolutions') && game.congress.activeResolutions.some(r => typeof r.name === 'string' && r.name.startsWith('World Ideology') && !r.name.includes(self.ideology))",
    "multiplier": 1.3
  },
  {
    "id": "genre-session-mood-analysis-editorial",
    "match": { "genre": ["analysis", "editorial"] },
    "when": "game.knows('congress') && game.congress.available === true && (game.congress.votingNow === true || (game.congress.knows('expectedSessionTurn') && typeof game.congress.expectedSessionTurn === 'number' && game.congress.expectedSessionTurn <= turn + 3)) && (story.tags.includes('international') || story.tags.includes('diplomacy'))",
    "multiplier": 1.3
  }
]
