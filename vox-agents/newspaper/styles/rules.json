[
  {
    "id": "voice-spoken-out-of-era",
    "match": { "voice": "spoken" },
    "when": "self.knows('era') && !['Ancient', 'Classical'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-crier-out-of-era",
    "match": { "voice": "crier" },
    "when": "self.knows('era') && !['Ancient', 'Classical', 'Medieval', 'Renaissance'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-chronicle-out-of-era",
    "match": { "voice": "chronicle" },
    "when": "self.knows('era') && !['Classical', 'Medieval'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-gazette-out-of-era",
    "match": { "voice": "gazette" },
    "when": "self.knows('era') && !['Renaissance', 'Industrial'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-pamphlet-out-of-era",
    "match": { "voice": "pamphlet" },
    "when": "self.knows('era') && !['Renaissance', 'Industrial'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-press-out-of-era",
    "match": { "voice": "press" },
    "when": "self.knows('era') && !['Industrial', 'Modern', 'Atomic'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-tabloid-out-of-era",
    "match": { "voice": "tabloid" },
    "when": "self.knows('era') && !['Industrial', 'Modern', 'Atomic', 'Information', 'Future'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-broadcast-out-of-era",
    "match": { "voice": "broadcast" },
    "when": "self.knows('era') && !['Modern', 'Atomic', 'Information', 'Future'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-feed-out-of-era",
    "match": { "voice": "feed" },
    "when": "self.knows('era') && !['Information', 'Future'].includes(self.era?.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-crier-broadcast-urgent",
    "match": { "voice": ["crier", "broadcast"] },
    "when": "story.urgent",
    "multiplier": 1.5
  },
  {
    "id": "voice-feed-short-fillers",
    "match": { "voice": "feed" },
    "when": "story.short",
    "multiplier": 1.5
  },
  {
    "id": "voice-tabloid-cities-domestic",
    "match": { "voice": "tabloid" },
    "when": "story.tags.includes('cities') && story.tags.includes('domestic')",
    "multiplier": 1.5
  },
  {
    "id": "voice-pamphlet-low-happiness",
    "match": { "voice": "pamphlet" },
    "when": "self.knows('happinessPercentage') && self.happinessPercentage < 50",
    "multiplier": 1.5
  },
  {
    "id": "voice-gazette-press-international",
    "match": { "voice": ["gazette", "press"] },
    "when": "story.tags.includes('international')",
    "multiplier": 1.5
  },
  {
    "id": "genre-jokes-off-urgent-important-news",
    "match": { "genre": ["joke", "proverb"] },
    "when": "story.urgent || story.importance >= 80",
    "multiplier": 0.25
  },
  {
    "id": "genre-short-fillers-rise",
    "match": { "genre": ["joke", "proverb", "notice", "ledger"] },
    "when": "story.short",
    "multiplier": 2
  },
  {
    "id": "genre-analysis-editorial-important-news",
    "match": { "genre": ["analysis", "editorial"] },
    "when": "story.importance >= 70",
    "multiplier": 1.6
  },
  {
    "id": "genre-analysis-editorial-not-short",
    "match": { "genre": ["analysis", "editorial"] },
    "when": "story.short",
    "multiplier": 0.5
  },
  {
    "id": "genre-report-for-urgent-news",
    "match": { "genre": "report" },
    "when": "story.urgent",
    "multiplier": 1.5
  },
  {
    "id": "genre-anecdote-on-city-news",
    "match": { "genre": "anecdote" },
    "when": "story.tags.includes('cities')",
    "multiplier": 1.5
  },
  {
    "id": "genre-letter-low-happiness",
    "match": { "genre": "letter" },
    "when": "self.knows('happinessPercentage') && self.happinessPercentage < 50",
    "multiplier": 1.5
  },
  {
    "id": "genre-anecdote-off-urgent",
    "match": { "genre": "anecdote" },
    "when": "story.urgent",
    "multiplier": 0.5
  },
  {
    "id": "stance-wartime-hawkish-national",
    "match": { "stance": ["hawkish", "national"] },
    "when": "self.knows('atWar') && self.atWar && story.tags.includes('military')",
    "multiplier": 1.75
  },
  {
    "id": "stance-peacetime-conciliatory",
    "match": { "stance": "conciliatory" },
    "when": "self.knows('atWar') && self.atWar === false && story.tags.includes('diplomacy')",
    "multiplier": 1.75
  },
  {
    "id": "stance-low-happiness-government-critical-populist",
    "match": { "stance": ["government-critical", "populist"] },
    "when": "self.knows('happinessPercentage') && self.happinessPercentage < 50",
    "multiplier": 1.5
  },
  {
    "id": "stance-golden-age-or-high-happiness",
    "match": { "stance": "pro-government" },
    "when": "(self.knows('goldenAge') && self.goldenAge) || (self.knows('happinessPercentage') && self.happinessPercentage >= 60)",
    "multiplier": 1.5
  },
  {
    "id": "stance-domestic-cities-local",
    "match": { "stance": "local" },
    "when": "story.tags.includes('cities') && story.tags.includes('domestic')",
    "multiplier": 1.75
  },
  {
    "id": "stance-international-national",
    "match": { "stance": "national" },
    "when": "story.tags.includes('international')",
    "multiplier": 1.5
  },
  {
    "id": "stance-wonders-science-ambitious",
    "match": { "stance": "ambitious" },
    "when": "story.tags.includes('wonders') || story.tags.includes('science')",
    "multiplier": 1.6
  },
  {
    "id": "stance-international-wonders-government-critical",
    "match": { "stance": "government-critical" },
    "when": "story.tags.includes('wonders') && story.tags.includes('international')",
    "multiplier": 1.5
  },
  {
    "id": "stance-domestic-cities-populist",
    "match": { "stance": "populist" },
    "when": "story.tags.includes('cities') && story.tags.includes('domestic')",
    "multiplier": 1.5
  },
  {
    "id": "stance-neutral-on-urgent",
    "match": { "stance": "neutral" },
    "when": "story.urgent",
    "multiplier": 1.5
  },
  {
    "id": "stance-traditional-religion",
    "match": { "stance": "traditional" },
    "when": "story.tags.includes('religion')",
    "multiplier": 1.5
  },
  {
    "id": "stance-elitist-wonders",
    "match": { "stance": "elitist" },
    "when": "story.tags.includes('wonders')",
    "multiplier": 1.5
  }
]
