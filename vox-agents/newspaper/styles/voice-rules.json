[
  {
    "id": "voice-spoken-out-of-era",
    "match": { "voice": "spoken" },
    "when": "self.get('era') && !['Ancient', 'Classical'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-crier-out-of-era",
    "match": { "voice": "crier" },
    "when": "self.get('era') && !['Ancient', 'Classical', 'Medieval', 'Renaissance'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-chronicle-out-of-era",
    "match": { "voice": "chronicle" },
    "when": "self.get('era') && !['Classical', 'Medieval'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-gazette-out-of-era",
    "match": { "voice": "gazette" },
    "when": "self.get('era') && !['Renaissance', 'Industrial'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-pamphlet-out-of-era",
    "match": { "voice": "pamphlet" },
    "when": "self.get('era') && !['Renaissance', 'Industrial'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-press-out-of-era",
    "match": { "voice": "press" },
    "when": "self.get('era') && !['Industrial', 'Modern', 'Atomic'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-tabloid-out-of-era",
    "match": { "voice": "tabloid" },
    "when": "self.get('era') && !['Industrial', 'Modern', 'Atomic', 'Information', 'Future'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-broadcast-out-of-era",
    "match": { "voice": "broadcast" },
    "when": "self.get('era') && !['Modern', 'Atomic', 'Information', 'Future'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-feed-out-of-era",
    "match": { "voice": "feed" },
    "when": "self.get('era') && !['Information', 'Future'].includes(self.era.replace(' Era', ''))",
    "multiplier": 0.05
  },
  {
    "id": "voice-crier-broadcast-urgent",
    "match": { "voice": ["crier", "broadcast"] },
    "when": "story.urgent",
    "multiplier": 1.5
  },
  {
    "id": "voice-tabloid-cities-domestic",
    "match": { "voice": "tabloid" },
    "when": "story.tags.includes('cities') && story.tags.includes('domestic')",
    "multiplier": 1.5
  },
  {
    "id": "voice-pamphlet-low-happiness",
    "match": { "voice": "pamphlet" },
    "when": "self.happinessPercentage < 50",
    "multiplier": 1.5
  },
  {
    "id": "voice-pamphlet-revolt",
    "match": { "voice": "pamphlet" },
    "when": "self.happinessPercentage < 35",
    "multiplier": 1.5
  },
  {
    "id": "voice-gazette-press-international",
    "match": { "voice": ["gazette", "press"] },
    "when": "story.tags.includes('international')",
    "multiplier": 1.5
  },
  {
    "id": "voice-freedom-tabloid-feed",
    "match": { "voice": ["tabloid", "feed"] },
    "when": "self.ideology === 'Freedom'",
    "multiplier": 1.3
  },
  {
    "id": "voice-order-press-pamphlet",
    "match": { "voice": ["press", "pamphlet"] },
    "when": "self.ideology === 'Order'",
    "multiplier": 1.3
  },
  {
    "id": "voice-autocracy-broadcast-crier",
    "match": { "voice": ["broadcast", "crier"] },
    "when": "self.ideology === 'Autocracy'",
    "multiplier": 1.3
  }
]
