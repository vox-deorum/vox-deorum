[
  {
    "id": "winged-sun-papyrus",
    "version": "1",
    "label": "Winged-Sun Papyrus",
    "title": "The Two Lands Register",
    "civilizationTitles": {
      "Nubia": "The Nubian Ledger",
      "Carthage": "The Byrsa Papyri"
    },
    "when": "self.is.northAfrican && ['Ancient', 'Classical'].includes(self.era?.replace(' Era', ''))",
    "weight": {
      "base": 45,
      "adjustments": [
        {
          "when": "['Egypt', 'Nubia'].includes(self.name)",
          "add": 13
        },
        {
          "when": "self.name === 'Egypt'",
          "add": 6
        },
        {
          "when": "self.name === 'Egypt' && self.era?.replace(' Era', '') === 'Ancient'",
          "add": 16
        },
        {
          "when": "self.name === 'Nubia' && self.era?.replace(' Era', '') === 'Ancient'",
          "add": 12
        }
      ]
    },
    "presentation": {
      "schemaVersion": 1,
      "rendererFamily": "folio",
      "tokens": {
        "paperColor": "#f5ead1",
        "inkColor": "#28231b",
        "accentColor": "#964023",
        "bodyFontAssetId": "font-libre-caslon-400",
        "headingFontAssetId": "font-cinzel-700",
        "mastheadFontAssetId": "font-cinzel-700"
      },
      "assets": {
        "ornamentAssetId": "winged-sun-papyrus.ornament"
      }
    },
    "assetDefinitions": [
      {
        "id": "ornament",
        "kind": "ornament",
        "path": "assets/designs/winged-sun-papyrus/ornament.svg",
        "mediaType": "image/svg+xml",
        "width": 260,
        "height": 48,
        "license": "Vox Deorum project asset",
        "attribution": "Authored ornament for the newspaper."
      }
    ],
    "layouts": [
