[
  {
    "id": "oral-accounts",
    "version": "1",
    "title": "Settlement Annals",
    "civilizationTitles": {
      "*": "Annals of {{terms.civilization}}"
    },
    "weight": {
      "base": 10,
      "adjustments": [
        {
          "when": "self.era?.replace(' Era', '') === 'Classical'",
          "add": 5
        },
        {
          "when": "['Medieval', 'Renaissance', 'Industrial', 'Modern', 'Atomic', 'Information', 'Future'].includes(self.era?.replace(' Era', ''))",
          "add": -10
        }
      ]
    },
    "presentation": {
      "schemaVersion": 1,
      "rendererFamily": "inscription",
      "tokens": {
        "paperColor": "#ece3d1",
        "inkColor": "#231a14",
        "accentColor": "#9b2f1f",
        "bodyFontAssetId": "font-cardo-400",
        "headingFontAssetId": "font-cinzel-700"
      }
    },
    "layouts": [
      {
        "id": "account",
        "variant": "ordinary",
        "weight": {
          "base": 10
        }
      },
      {
        "id": "urgent-account",
        "variant": "breaking",
        "weight": {
          "base": 10
        }
      },
      {
        "id": "comparison",
        "variant": "analysis",
        "weight": {
          "base": 2
        }
      }
    ],
    "pageLabels": {
      "front": "The Gathered Account",
      "home": "Our Settlements"
    }
  }
