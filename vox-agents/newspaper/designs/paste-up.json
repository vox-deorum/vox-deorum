[
  {
    "id": "paste-up",
    "version": "1",
    "label": "Photocopied Fanzine",
    "title": "The Paste-Up",
    "when": "['Atomic', 'Information'].includes(self.era?.replace(' Era', ''))",
    "weight": {
      "base": 42,
      "adjustments": [
        {
          "when": "self.era?.replace(' Era', '') === 'Atomic'",
          "add": 6
        }
      ]
    },
    "presentation": {
      "schemaVersion": 1,
      "rendererFamily": "folio",
      "tokens": {
        "paperColor": "#f8f6ee",
        "inkColor": "#25231e",
        "accentColor": "#d9e58b",
        "bodyFontAssetId": "font-inter-400",
        "headingFontAssetId": "font-inter-800"
      }
    },
    "layouts": [
      { "id": "clippings", "variant": "ordinary", "frontSlots": 4, "sectionSlots": 2, "weight": { "base": 12 } },
      { "id": "cover-story", "variant": "breaking", "frontSlots": 4, "weight": { "base": 8 } },
      { "id": "cuttings-file", "variant": "analysis", "frontSlots": 4, "sectionSlots": 2, "weight": { "base": 5 } }
    ],
    "pageLabels": { "front": "Front", "home": "Cities", "economy": "Trade", "abroad": "Abroad" }
  }
]
