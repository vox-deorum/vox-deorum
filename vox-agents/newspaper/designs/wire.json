[
  {
    "id": "wire",
    "version": "1",
    "title": "The Civic Wire",
    "civilizationTitles": {
      "*": "{{terms.civilization}} Wire"
    },
    "when": "['Modern', 'Atomic', 'Information', 'Future'].includes(self.era?.replace(' Era', ''))",
    "weight": {
      "base": 0,
      "adjustments": [
        {
          "when": "self.era?.replace(' Era', '') === 'Modern'",
          "add": 60
        },
        {
          "when": "self.era?.replace(' Era', '') === 'Atomic'",
          "add": 80
        },
        {
          "when": "self.era?.replace(' Era', '') === 'Information'",
          "add": 100
        },
        {
          "when": "self.era?.replace(' Era', '') === 'Future'",
          "add": 100
        }
      ]
    },
    "presentation": {
      "schemaVersion": 1,
      "rendererFamily": "feed",
      "tokens": {
        "paperColor": "#ffffff",
        "inkColor": "#14191f",
        "accentColor": "#1b5fae",
        "bodyFontAssetId": "font-inter-400",
        "headingFontAssetId": "font-inter-800"
      }
    },
    "assetDefinitions": [
      {
        "id": "port",
        "kind": "image",
        "path": "assets/designs/wire/port.png",
        "mediaType": "image/png",
        "width": 1536,
        "height": 1024,
        "license": "Generated for Vox Deorum",
        "attribution": "Generated with the built-in image tool for the newspaper prototype."
      }
    ],
    "layouts": [
      {
        "id": "feed",
        "variant": "ordinary",
        "weight": {
          "base": 10
        }
      },
      {
        "id": "breaking-wire",
        "variant": "breaking",
        "weight": {
          "base": 10
        }
      },
      {
        "id": "data-desk",
        "variant": "analysis",
        "weight": {
          "base": 3
        }
      }
    ],
    "pageLabels": {
      "front": "Headlines",
      "home": "Local",
      "economy": "Economy",
      "abroad": "World"
    }
  }
]
