[
  {
    "id": "victorian",
    "version": "1",
    "label": "Victorian Broadsheet",
    "title": "The Morning Ledger",
    "civilizationTitles": {
      "The Netherlands": "The Dutch Morning Ledger",
      "*": "The Morning Ledger of {{terms.civilization}}"
    },
    "when": "['Industrial', 'Modern'].includes(self.era?.replace(' Era', ''))",
    "weight": {
      "base": 40,
      "adjustments": [
        {
          "when": "self.era?.replace(' Era', '') === 'Industrial'",
          "add": 20
        }
      ]
    },
    "presentation": {
      "schemaVersion": 1,
      "rendererFamily": "broadsheet",
      "tokens": {
        "paperColor": "#f1e8d4",
        "inkColor": "#1f1b16",
        "accentColor": "#7a2a1e",
        "bodyFontAssetId": "font-libre-caslon-400",
        "headingFontAssetId": "font-bodoni-moda-700",
        "mastheadFontAssetId": "font-unifrakturmaguntia-400"
      },
      "assets": {
        "ornamentAssetId": "victorian.scrollwork"
      }
    },
    "assetDefinitions": [
      {
        "id": "scrollwork",
        "kind": "ornament",
        "path": "assets/designs/victorian/scrollwork.svg",
        "mediaType": "image/svg+xml",
        "width": 900,
        "height": 70,
        "license": "Vox Deorum project asset",
        "attribution": "Authored SVG scrollwork cartouche for the Victorian design."
      },
      {
        "id": "harbour",
        "kind": "image",
        "path": "assets/designs/victorian/harbour.png",
        "mediaType": "image/png",
        "width": 1536,
        "height": 1024,
        "license": "Generated for Vox Deorum",
        "attribution": "Generated with the built-in image tool for the newspaper prototype."
      }
    ],
    "layouts": [
      {
        "id": "broadsheet",
        "variant": "ordinary",
        "frontSlots": 5,
        "sectionSlots": 3,
        "weight": {
          "base": 10
        }
      },
      {
        "id": "war-edition",
        "variant": "breaking",
        "frontSlots": 5,
        "weight": {
          "base": 10
        }
      },
      {
        "id": "dispatch",
        "variant": "breaking",
        "frontSlots": 5,
        "weight": {
          "base": 4
        }
      },
      {
        "id": "review",
        "variant": "analysis",
        "frontSlots": 5,
        "sectionSlots": 3,
        "weight": {
          "base": 3
        }
      }
    ],
    "pageLabels": {
      "front": "Front Page",
      "abroad": "Foreign Correspondence"
    }
  }
]
