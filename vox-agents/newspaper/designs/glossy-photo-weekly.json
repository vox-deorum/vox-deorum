[
  {
    "id": "glossy-photo-weekly",
    "version": "1",
    "label": "Glossy Photo Weekly",
    "title": "The National Pictorial",
    "when": "['Modern', 'Atomic'].includes(self.era?.replace(' Era', ''))",
    "weight": {
      "base": 52,
      "adjustments": [
        {
          "when": "self.era?.replace(' Era', '') === 'Modern'",
          "add": 3
        }
      ]
    },
    "presentation": {
      "schemaVersion": 1,
      "rendererFamily": "folio",
      "tokens": {
        "paperColor": "#f9fafb",
        "inkColor": "#15191f",
        "accentColor": "#1742a6",
        "bodyFontAssetId": "font-libre-caslon-400",
        "headingFontAssetId": "font-inter-800"
      }
    },
    "layouts": [
      { "id": "picture-weekly", "variant": "ordinary", "weight": { "base": 10 } },
      { "id": "special-edition", "variant": "breaking", "weight": { "base": 10 } },
      { "id": "in-figures", "variant": "analysis", "weight": { "base": 3 } }
    ],
    "pageLabels": {
      "front": "Cover",
      "home": "National Affairs",
      "abroad": "World Affairs"
    },
    "assetDefinitions": [
      {
        "id": "harbor-tugs",
        "kind": "image",
        "path": "assets/designs/glossy-photo-weekly/harbor-tugs.jpg",
        "mediaType": "image/jpeg",
        "width": 736,
        "height": 576,
        "license": "Public domain",
        "attribution": "Paul Vanderbilt, New York, New York. Two harbor tugs (July 1938), cropped. Library of Congress, Prints & Photographs Division, Farm Security Administration/Office of War Information Black-and-White Negatives. https://www.loc.gov/item/2017868572/"
      }
    ]
  }
]
