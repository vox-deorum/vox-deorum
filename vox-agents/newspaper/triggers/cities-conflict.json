[
  {
    "id": "city-being-razed",
    "subject": "city",
    "when": [
      "city.knows('name') && city.knows('razingTurns') && city.razingTurns > 0 && city.knows('foreign') && city.foreign",
      "city.knows('owner') && city.owner.knows('name')"
    ],
    "values": {
      "civilization": "city.owner.name",
      "population": "city.knows('population') ? city.population : null",
      "turns": "city.razingTurns",
      "distance": "city.knows('distance') && city.distance.knows('own') ? city.distance.own : null"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "military", "international"]
  },
  {
    "id": "city-under-siege",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.is.besieged",
      "city.knows('hitPoints') && Number.isFinite(city.hitPoints)",
      "city.knows('maxHitPoints') && Number.isFinite(city.maxHitPoints) && city.maxHitPoints > 0",
      "(city.maxHitPoints - city.hitPoints) / city.maxHitPoints >= 0.25"
    ],
    "values": {
      "damage": "(city.maxHitPoints - city.hitPoints) / city.maxHitPoints",
      "wallStrength": "city.hitPoints",
      "maxWallStrength": "city.maxHitPoints"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "50 * (damage - 0.25)"],
    "urgent": "damage >= 0.5",
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "city-pillaged-unrest",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('unhappiness')",
      "city.unhappiness.top === 'pillaged'"
    ],
    "values": {
      "pillagedPopulation": "city.unhappiness.pillaged"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "we-raze-a-city",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.knows('razingTurns') && Number.isFinite(city.razingTurns) && city.razingTurns > 0"
    ],
    "values": {
      "population": "city.knows('population') ? city.population : null",
      "turns": "city.razingTurns"
    },
    "tier": "major",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-city-takes-heavy-damage",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign === true && city.knows('name')",
      "city.knows('owner') && city.owner.knows('id') && city.owner.knows('name')",
      "city.owner.knows('enemy') && city.owner.enemy === false",
      "city.knows('hitPoints') && Number.isFinite(city.hitPoints) && city.knows('maxHitPoints') && Number.isFinite(city.maxHitPoints) && city.maxHitPoints > 0",
      "city.knows('before') && city.before.knows('owner') && city.before.owner.knows('id') && city.before.owner.id === city.owner.id",
      "city.before.knows('hitPoints') && Number.isFinite(city.before.hitPoints) && city.before.hitPoints > city.hitPoints",
      "city.before.knows('maxHitPoints') && Number.isFinite(city.before.maxHitPoints) && city.before.maxHitPoints > 0",
      "crossed(1 - city.hitPoints / city.maxHitPoints, 1 - city.before.hitPoints / city.before.maxHitPoints, majority)",
      "!(city.knows('razingTurns') && Number.isFinite(city.razingTurns) && city.razingTurns > 0)"
    ],
    "values": {
      "knownWar": "city.owner.knows('atWar') && city.owner.atWar === true",
      "damage": "(city.maxHitPoints - city.hitPoints) / city.maxHitPoints"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "20 * damage"],
    "tags": ["cities", "military", "international"]
  }
]
