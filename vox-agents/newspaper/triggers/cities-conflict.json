[
  {
    "id": "city-being-razed",
    "subject": "city",
    "when": [
      "city.knows('name') && city.razingTurns > 0 && city.foreign"
    ],
    "values": {
      "civilization": "city.owner.name",
      "population": "city.get('population') ?? null",
      "turns": "city.razingTurns",
      "distance": "city.get('distance.own') ?? null"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "military", "international"]
  },
  {
    "id": "city-under-siege",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.is.besieged",
      "city.damage >= 0.25"
    ],
    "values": {
      "damage": "city.damage",
      "wallStrength": "city.hitPoints",
      "maxWallStrength": "city.maxHitPoints"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "50 * (damage - 0.25)"],
    "urgent": "damage >= 0.5",
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "city-pillaged-unrest",
    "subject": "city",
    "when": [
      "city.own",
      "city.unhappiness.top === 'pillaged'"
    ],
    "values": {
      "pillagedPopulation": "city.unhappiness.pillaged"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "we-raze-a-city",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.razingTurns > 0"
    ],
    "values": {
      "population": "city.get('population') ?? null",
      "turns": "city.razingTurns"
    },
    "tier": "major",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-city-takes-heavy-damage",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign && city.knows('name')",
      "city.get('owner.name') && city.get('owner.enemy') === false",
      "city.get('before.owner.id') === city.owner.id",
      "city.get('before.hitPoints') > city.hitPoints",
      "crossed(city.damage, city.before.damage, majority)",
      "!(city.get('razingTurns') > 0)"
    ],
    "values": {
      "knownWar": "!!city.get('owner.atWar')",
      "damage": "city.damage"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "20 * damage"],
    "tags": ["cities", "military", "international"]
  }
]
