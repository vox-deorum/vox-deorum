[
  {
    "id": "active-war-zone-analysis",
    "subject": "city",
    "when": [
      "city.knows('name')",
      "city.own || (city.foreign && city.get('owner.major') && city.get('owner.name') && city.get('owner.enemy'))",
      "!city.own || self.get('wars')?.some(p => !p.self && p.get('major') && p.get('name'))",
      "(() => { const count = (units, name) => Object.hasOwn(units, name) ? Object.entries(units[name]).reduce((sum, [unit, n]) => Number.isFinite(n) && n > 0 && !settlers.includes(unit) && !workers.includes(unit) && !missionaries.includes(unit) && !greatPeople.includes(unit) ? sum + n : sum, 0) : 0; const opponents = city.own ? self.wars.filter(p => p.get('major') && p.get('name')).map(p => p.name) : [city.owner.name]; return city.tacticalZones()?.some(zone => zone.get('units') && count(zone.units, self.name) >= 2 && opponents.some(name => count(zone.units, name) >= 2)) ?? false; })()"
    ],
    "values": {
      "contact": "(() => { const count = (units, name) => Object.hasOwn(units, name) ? Object.entries(units[name]).reduce((sum, [unit, n]) => Number.isFinite(n) && n > 0 && !settlers.includes(unit) && !workers.includes(unit) && !missionaries.includes(unit) && !greatPeople.includes(unit) ? sum + n : sum, 0) : 0; const opponents = city.own ? self.wars.filter(p => p.get('major') && p.get('name')).map(p => p.name) : [city.owner.name]; let best = null, largest = 0; for (const zone of city.tacticalZones() ?? []) { if (!zone.get('units')) continue; const ours = count(zone.units, self.name); if (ours < 2) continue; for (const name of opponents) { const theirs = count(zone.units, name); if (theirs < 2 || ours + theirs <= largest) continue; largest = ours + theirs; best = { opponent: name, ourUnits: ours, theirUnits: theirs, domain: zone.domain, posture: zone.get('posture') ?? null }; } } return JSON.stringify(best); })()",
      "opponent": "JSON.parse(contact).opponent",
      "ourUnits": "JSON.parse(contact).ourUnits",
      "theirUnits": "JSON.parse(contact).theirUnits",
      "domain": "JSON.parse(contact).domain",
      "posture": "JSON.parse(contact).posture"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "repeat": "medium",
    "tags": ["cities", "military"]
  },
  {
    "id": "barbarians-at-the-gates",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.tacticalZones()?.some(z => z.get('units') && Object.hasOwn(z.units, 'Barbarians') && Object.values(z.units.Barbarians).some(n => Number.isFinite(n) && n > 0))"
    ],
    "values": {
      "barbarians": "city.tacticalZones()?.filter(z => z.get('units') && Object.hasOwn(z.units, 'Barbarians')).flatMap(z => Object.values(z.units.Barbarians)).filter(n => Number.isFinite(n) && n > 0).reduce((sum, n) => sum + n, 0) ?? 0",
      "posture": "city.tacticalZones()?.find(z => z.get('posture'))?.posture ?? null"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(15, 3 * barbarians)"],
    "urgent": "barbarians >= 4",
    "tags": ["cities", "military"]
  },
  {
    "id": "besieged-and-starving",
    "subject": "city",
    "when": [
      "city.own",
      "city.is.besieged",
      "city.is.starving"
    ],
    "values": {
      "damage": "city.damage"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "30 * damage"],
    "urgent": "damage >= 0.5"
  },
  {
    "id": "enemy-city-takes-heavy-damage",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign && city.knows('name')",
      "city.owner.major && city.owner.enemy",
      "city.get('before.owner.id') === city.owner.id",
      "city.get('before.hitPoints') > city.hitPoints",
      "crossed(city.damage, city.before.damage, majority)"
    ],
    "values": {
      "civilization": "city.owner.name",
      "damage": "city.damage",
      "wallStrength": "city.hitPoints",
      "maxWallStrength": "city.maxHitPoints"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "20 * damage"],
    "tags": ["cities", "military", "international"]
  },
  {
    "id": "enemy-front-posture-offensive",
    "subject": "city",
    "when": [
      "city.foreign",
      "city.knows('name')",
      "city.owner.major",
      "city.tacticalPostureChanges.some(c => (c.get('posture') === 'Steamroll' || c.get('posture') === 'Surgical City Strike') && typeof c.get('previousPosture') === 'string' && c.previousPosture !== 'Steamroll' && c.previousPosture !== 'Surgical City Strike' && c.get('owner') && c.get('receiver') && (r => r.get('war'))(c.owner.relation(c.receiver)))"
    ],
    "values": {
      "changeIndex": "city.tacticalPostureChanges.map(c => (c.get('posture') === 'Steamroll' || c.get('posture') === 'Surgical City Strike') && typeof c.get('previousPosture') === 'string' && c.previousPosture !== 'Steamroll' && c.previousPosture !== 'Surgical City Strike' && c.get('owner') && c.get('receiver') && (r => r.get('war'))(c.owner.relation(c.receiver))).lastIndexOf(true)",
      "civilization": "city.owner.name",
      "observedTurn": "city.tacticalPostureChanges[changeIndex].turn",
      "domain": "city.tacticalPostureChanges[changeIndex].domain",
      "previousPosture": "city.tacticalPostureChanges[changeIndex].previousPosture",
      "posture": "city.tacticalPostureChanges[changeIndex].posture"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "repeat": 1,
    "tags": ["cities", "military", "international"]
  },
  {
    "id": "enemy-front-posture-regroup",
    "subject": "city",
    "when": [
      "city.foreign",
      "city.knows('name')",
      "city.owner.major",
      "city.tacticalPostureChanges.some(c => (c.get('posture') === 'Attrition' || c.get('posture') === 'Exploit Flanks') && c.get('previousPosture') === 'Withdraw' && c.get('owner') && c.get('receiver') && (r => r.get('war'))(c.owner.relation(c.receiver)))"
    ],
    "values": {
      "changeIndex": "city.tacticalPostureChanges.map(c => (c.get('posture') === 'Attrition' || c.get('posture') === 'Exploit Flanks') && c.get('previousPosture') === 'Withdraw' && c.get('owner') && c.get('receiver') && (r => r.get('war'))(c.owner.relation(c.receiver))).lastIndexOf(true)",
      "civilization": "city.owner.name",
      "observedTurn": "city.tacticalPostureChanges[changeIndex].turn",
      "domain": "city.tacticalPostureChanges[changeIndex].domain",
      "previousPosture": "city.tacticalPostureChanges[changeIndex].previousPosture",
      "posture": "city.tacticalPostureChanges[changeIndex].posture"
    },
    "tier": "routine",
    "adjust": "city.stake.place",
    "repeat": 1,
    "tags": ["cities", "military", "international"]
  },
  {
    "id": "enemy-front-posture-withdraw",
    "subject": "city",
    "when": [
      "city.foreign",
      "city.knows('name')",
      "city.owner.major",
      "city.tacticalPostureChanges.some(c => c.get('posture') === 'Withdraw' && c.knows('previousPosture') && c.previousPosture !== 'NONE' && c.previousPosture !== 'Withdraw' && c.get('owner') && c.get('receiver') && (r => r.get('war'))(c.owner.relation(c.receiver)))"
    ],
    "values": {
      "changeIndex": "city.tacticalPostureChanges.map(c => c.get('posture') === 'Withdraw' && c.knows('previousPosture') && c.previousPosture !== 'NONE' && c.previousPosture !== 'Withdraw' && c.get('owner') && c.get('receiver') && (r => r.get('war'))(c.owner.relation(c.receiver))).lastIndexOf(true)",
      "civilization": "city.owner.name",
      "observedTurn": "city.tacticalPostureChanges[changeIndex].turn",
      "domain": "city.tacticalPostureChanges[changeIndex].domain",
      "previousPosture": "city.tacticalPostureChanges[changeIndex].previousPosture",
      "posture": "city.tacticalPostureChanges[changeIndex].posture"
    },
    "tier": "routine",
    "adjust": "city.stake.place",
    "repeat": 1,
    "tags": ["cities", "military", "international"]
  },
  {
    "id": "enemy-troops-sighted-near-city",
    "subject": "city",
    "when": [
      "city.own && city.knows('name')",
      "city.tacticalZones()?.some(z => z.get('units') && self.wars.some(p => p.major && p.get('name') && Object.hasOwn(z.units, p.name)))"
    ],
    "values": {
      "enemies": "(() => { const zones = city.tacticalZones()?.filter(z => z.get('units')) ?? []; return self.wars.filter(p => p.major && p.get('name') && zones.some(z => Object.hasOwn(z.units, p.name))).map(p => p.name).join(', '); })()"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "enemy-units-lost-in-combat",
    "subject": "event",
    "event": "UnitKilledInCombat",
    "when": [
      "event.killerPlayer.self",
      "!event.killedPlayer.self",
      "event.killedPlayer.major",
      "event.unit"
    ],
    "values": {
      "unit": "event.unit",
      "victim": "event.killedPlayer.name"
    },
    "group": {
      "by": "event.killedPlayer.id",
      "min": 3
    },
    "tier": "notable",
    "adjust": "Math.min(15, 4 * count)",
    "tags": ["politics", "military"]
  },
  {
    "id": "foreign-capital-falls",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "event.isCapital",
      "event.isConquest",
      "!event.oldOwner.self && !event.newOwner.self",
      "event.get('city.name')",
      "!event.get('distance') || event.distance.own > nearby"
    ],
    "values": {
      "loser": "event.oldOwner.name",
      "winner": "event.newOwner.name",
      "distance": "event.get('distance') ? event.distance.own : null"
    },
    "tier": "notable",
    "adjust": "event.stake.place",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "nearby-capital-falls",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "event.isCapital && event.isConquest",
      "!event.oldOwner.self && !event.newOwner.self",
      "event.get('distance.own') <= nearby"
    ],
    "values": {
      "loser": "event.oldOwner.name",
      "winner": "event.newOwner.name",
      "capitalDescription": "event.city.name === loser ? event.city.name : event.city.name + ' (' + loser + \"'s capital)\""
    },
    "tier": "major",
    "adjust": "event.stake.place"
  },
  {
    "id": "nearby-city-captured",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "event.isConquest",
      "event.isCapital === false",
      "!event.oldOwner.self && !event.newOwner.self",
      "event.get('city.name')"
    ],
    "values": {
      "loser": "event.oldOwner.name",
      "winner": "event.newOwner.name",
      "distance": "event.get('distance') ? event.distance.own : null",
      "near": "event.get('distance.own') <= nearby"
    },
    "tier": "notable",
    "adjust": "event.stake.place",
    "tags": ["cities", "military"]
  },
  {
    "id": "neighbor-army-overtakes",
    "subject": "player",
    "window": "medium",
    "when": [
      "player.is.foreignMajor",
      "player.militaryStrength > self.militaryStrength",
      "player.before.militaryStrength <= self.before.militaryStrength"
    ],
    "values": {
      "neighbor": "player.name",
      "ourStrength": "self.militaryStrength",
      "theirStrength": "player.militaryStrength"
    },
    "tier": "notable",
    "adjust": ["player.stake.relation", "Math.min(20, 20 * (theirStrength / ourStrength - 1))"]
  },
  {
    "id": "our-army-overtakes-neighbor",
    "subject": "player",
    "window": "medium",
    "when": [
      "player.is.foreignMajor",
      "self.militaryStrength > player.militaryStrength",
      "self.before.militaryStrength <= player.before.militaryStrength"
    ],
    "values": {
      "neighbor": "player.name",
      "ourStrength": "self.militaryStrength",
      "theirStrength": "player.militaryStrength"
    },
    "tier": "notable",
    "adjust": ["player.stake.relation", "Math.min(10, 10 * (ourStrength / theirStrength - 1))"],
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "our-city-takes-heavy-damage",
    "subject": "city",
    "when": [
      "city.own",
      "city.damage >= 0.25",
      "city.get('before.hitPoints') > city.hitPoints && city.get('before.owner.self')"
    ],
    "values": {
      "damage": "city.damage",
      "wallStrength": "city.hitPoints",
      "maxWallStrength": "city.maxHitPoints"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "30 * damage"],
    "urgent": "damage >= 0.5",
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "own-front-posture-counterattack",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.tacticalPostureChanges.some(c => c.get('posture') === 'Counterattack' && c.get('previousPosture') === 'Hedgehog')"
    ],
    "values": {
      "changeIndex": "city.tacticalPostureChanges.map(c => c.get('posture') === 'Counterattack' && c.get('previousPosture') === 'Hedgehog').lastIndexOf(true)",
      "observedTurn": "city.tacticalPostureChanges[changeIndex].turn",
      "domain": "city.tacticalPostureChanges[changeIndex].domain",
      "previousPosture": "city.tacticalPostureChanges[changeIndex].previousPosture",
      "posture": "city.tacticalPostureChanges[changeIndex].posture"
    },
    "tier": "routine",
    "adjust": "city.stake.place",
    "repeat": 1,
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "own-front-posture-defensive",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.tacticalPostureChanges.some(c => c.get('posture') === 'Hedgehog' && c.knows('previousPosture') && c.previousPosture !== 'NONE' && c.previousPosture !== 'Hedgehog')"
    ],
    "values": {
      "changeIndex": "city.tacticalPostureChanges.map(c => c.get('posture') === 'Hedgehog' && c.knows('previousPosture') && c.previousPosture !== 'NONE' && c.previousPosture !== 'Hedgehog').lastIndexOf(true)",
      "observedTurn": "city.tacticalPostureChanges[changeIndex].turn",
      "domain": "city.tacticalPostureChanges[changeIndex].domain",
      "previousPosture": "city.tacticalPostureChanges[changeIndex].previousPosture",
      "posture": "city.tacticalPostureChanges[changeIndex].posture"
    },
    "tier": "routine",
    "adjust": "city.stake.place",
    "repeat": 1,
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "units-lost-in-combat",
    "subject": "event",
    "event": "UnitKilledInCombat",
    "when": [
      "event.killedPlayer.self",
      "event.killerPlayer.is.foreignMajor",
      "event.unit"
    ],
    "values": {
      "unit": "event.unit",
      "killer": "event.killerPlayer.name"
    },
    "group": {
      "by": "event.killerPlayer.id",
      "min": 3
    },
    "tier": "notable",
    "adjust": "Math.min(20, 5 * count)",
    "tags": ["politics", "military"]
  }
]
