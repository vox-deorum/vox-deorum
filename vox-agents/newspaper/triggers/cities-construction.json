[
  {
    "id": "building-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.is.ourBuilding",
      "event.is.regularBuilding && event.is.notableBuilding",
      "!event.is.purchased",
      "!event.is.foundingFreebie"
    ],
    "values": {
      "building": "event.building"
    },
    "tier": "filler",
    "adjust": "event.stake.building",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "building-investment-made",
    "subject": "event",
    "event": "CityInvestedBuilding",
    "when": [
      "event.is.ourBuilding",
      "typeof event.building === 'string' && event.building.length > 0",
      "event.invested === true || event.invested === 1",
      "!events.some(e => e.type === 'CityConstructed' && e.knows('player') && e.player.knows('id') && e.player.id === event.player.id && e.knows('building') && e.building === event.building && e.knows('city') && e.city.knows('id') && event.city.knows('id') && e.city.id === event.city.id && e.knows('isGoldPurchase') && e.isGoldPurchase === false && e.knows('isFaithPurchase') && e.isFaithPurchase === false)"
    ],
    "values": {
      "building": "event.building"
    },
    "tier": "filler",
    "adjust": "event.stake.building",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "building-purchased",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.is.ourBuilding",
      "event.is.regularBuilding && event.is.notableBuilding",
      "event.is.purchased"
    ],
    "values": {
      "building": "event.building",
      "currency": "event.isGoldPurchase === true ? 'gold' : 'faith'"
    },
    "tier": "filler",
    "adjust": "event.stake.building",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-defense-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.is.ourBuilding",
      "defenses.includes(event.building)"
    ],
    "values": {
      "building": "event.building"
    },
    "tier": "routine",
    "adjust": "event.stake.building",
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "city-courthouse-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.is.ourBuilding",
      "event.is.courthouseIntegration"
    ],
    "values": {
      "building": "event.building"
    },
    "tier": "notable",
    "adjust": "event.city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-building-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.is.theirBuilding",
      "event.is.regularBuilding && event.is.notableBuilding",
      "!event.is.purchased",
      "!event.is.foundingFreebie"
    ],
    "values": {
      "building": "event.building",
      "owner": "event.city.owner.name"
    },
    "tier": "filler",
    "adjust": ["event.city.owner.stake.relation", "event.city.ourSpyPresent ? 5 : 0"],
    "tags": ["cities", "international"]
  },
  {
    "id": "foreign-building-purchased",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.is.theirBuilding",
      "event.is.regularBuilding && event.is.notableBuilding",
      "event.is.purchased"
    ],
    "values": {
      "building": "event.building",
      "owner": "event.city.owner.name",
      "currency": "event.isGoldPurchase === true ? 'gold' : 'faith'"
    },
    "tier": "filler",
    "adjust": ["event.city.owner.stake.relation", "event.city.ourSpyPresent ? 5 : 0"],
    "tags": ["cities", "international"]
  },
  {
    "id": "foreign-building-investment-made",
    "subject": "event",
    "event": "CityInvestedBuilding",
    "when": [
      "event.is.theirBuilding",
      "event.city.is.nearby",
      "typeof event.building === 'string' && event.building.length > 0",
      "event.invested === true || event.invested === 1",
      "!events.some(e => e.type === 'CityConstructed' && (e.turn > event.turn || (e.turn === event.turn && e.id > event.id)) && e.knows('player') && e.player.knows('id') && e.player.id === event.player.id && e.knows('city') && e.city.knows('id') && event.city.knows('id') && e.city.id === event.city.id && e.knows('building') && e.building === event.building)"
    ],
    "values": {
      "building": "event.building",
      "owner": "event.city.owner.name"
    },
    "tier": "filler",
    "adjust": "event.stake.place",
    "tags": ["cities", "international"]
  },
  {
    "id": "foreign-city-defense-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.is.theirBuilding",
      "event.city.is.nearby",
      "defenses.includes(event.building)",
      "!event.is.foundingFreebie"
    ],
    "values": {
      "building": "event.building",
      "owner": "event.city.owner.name"
    },
    "tier": "routine",
    "adjust": "event.stake.place",
    "tags": ["cities", "military", "international"]
  },
  {
    "id": "foreign-city-courthouse-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.is.theirBuilding",
      "event.city.is.nearby",
      "event.is.courthouseIntegration"
    ],
    "values": {
      "building": "event.building",
      "owner": "event.city.owner.name"
    },
    "tier": "notable",
    "adjust": "event.city.stake.place",
    "tags": ["cities", "international"]
  }
]
