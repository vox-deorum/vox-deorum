[
  {
    "id": "falls-to-last-place",
    "subject": "world",
    "window": "short",
    "when": [
      "self.major",
      "majorsWith('score') >= 3",
      "self.rank('score') === majorsWith('score')",
      "self.get('before.score') !== undefined && self.before.rank('score') < majorsWith('before.score')"
    ],
    "values": {
      "count": "majorsWith('score')"
    },
    "tier": "notable",
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-golden-age-begins",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.player.is.foreignMajor",
      "event.starting"
    ],
    "values": {
      "civilization": "event.player.name"
    },
    "tier": "notable",
    "adjust": "event.player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-golden-age-ends",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.player.is.foreignMajor",
      "event.starting === false"
    ],
    "values": {
      "civilization": "event.player.name"
    },
    "tier": "routine",
    "adjust": "event.player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "golden-age-begins",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.starting",
      "event.player.self",
      "!self.atWar"
    ],
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "golden-age-ends",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.starting === false",
      "event.player.self"
    ],
    "tier": "routine",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "golden-age-in-wartime",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.starting",
      "event.player.self",
      "self.atWar",
      "self.wars.some(p => p.get('name'))"
    ],
    "values": {
      "enemies": "(() => { const names = self.wars.filter(p => p.get('name')).map(p => p.get('name')); return names.length <= 2 ? names.join(' and ') : names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1]; })()"
    },
    "tier": "notable"
  },
  {
    "id": "happiness-recovers",
    "subject": "world",
    "window": "recent",
    "when": "crossed(self.happinessPercentage, self.before.happinessPercentage, 50)",
    "values": {
      "happinessPercentage": "self.happinessPercentage"
    },
    "tier": "routine",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "ideology-adopted",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.ideology",
      "!self.get('before.ideology')"
    ],
    "values": {
      "ideology": "self.ideology"
    },
    "tier": "major",
    "urgent": "true",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "ideology-switched",
    "subject": "event",
    "event": "IdeologySwitched",
    "when": [
      "event.player.major",
      "event.oldBranch",
      "event.newBranch",
      "event.oldBranch !== event.newBranch"
    ],
    "values": {
      "civilization": "event.player.name",
      "formerIdeology": "event.oldBranch",
      "ideology": "event.newBranch",
      "ours": "event.player.self"
    },
    "tier": "ours ? 'major' : 'notable'",
    "urgent": "ours",
    "tags": ["politics", "international"]
  },
  {
    "id": "major-reduced-to-single-city",
    "subject": "player",
    "window": "medium",
    "when": [
      "!player.self && player.major",
      "player.cityCount === 1",
      "player.get('before.cityCount') > 1"
    ],
    "values": {
      "civilization": "player.name",
      "lost": "player.before.cityCount - player.cityCount"
    },
    "tier": "major",
    "adjust": ["player.stake.relation", "Math.min(15, 5 * lost)"],
    "tags": ["politics", "international"]
  },
  {
    "id": "policy-adopted",
    "subject": "event",
    "event": "PlayerAdoptPolicy",
    "when": [
      "event.player.self",
      "event.policy"
    ],
    "values": {
      "policy": "event.policy"
    },
    "tier": "routine",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "policy-branch-opened",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.policyBranches !== null && typeof self.policyBranches === 'object'",
      "self.get('before.policyBranches') !== null && typeof self.get('before.policyBranches') === 'object'",
      "Object.keys(self.policyBranches).filter(branch => !Object.keys(self.before.policyBranches).includes(branch)).length === 1"
    ],
    "values": {
      "branch": "Object.keys(self.policyBranches).find(branch => !Object.keys(self.before.policyBranches).includes(branch))",
      "count": "Object.keys(self.policyBranches).length"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "revolt-threshold-cleared",
    "subject": "world",
    "window": "recent",
    "when": [
      "crossed(self.happinessPercentage, self.before.happinessPercentage, 35)",
      "self.happinessPercentage < 50"
    ],
    "values": {
      "happinessPercentage": "self.happinessPercentage"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "revolt-threshold-crossed",
    "subject": "world",
    "window": "recent",
    "when": "dropped(self.happinessPercentage, self.before.happinessPercentage, 35)",
    "values": {
      "happiness": "self.happinessPercentage"
    },
    "tier": "major",
    "urgent": "true",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "rival-adopts-ideology",
    "subject": "player",
    "when": [
      "player.is.foreignMajor",
      "player.ideology",
      "!player.get('before.ideology')"
    ],
    "values": {
      "rival": "player.name",
      "ideology": "player.ideology",
      "shared": "self.get('ideology') === player.ideology"
    },
    "tier": "self.get('ideology') && self.ideology !== player.ideology ? 'major' : 'notable'",
    "tags": ["politics", "international"]
  },
  {
    "id": "score-leader-changes",
    "subject": "player",
    "window": "short",
    "when": [
      "player.major",
      "player.rank('score') === 1",
      "player.get('before.score') !== undefined && player.before.rank('score') > 1",
      "players.every(p => p.id === player.id || !p.get('major') || p.get('score') !== player.score || p.get('name'))"
    ],
    "values": {
      "civilization": "player.name",
      "tiedName": "players.filter(p => p.id !== player.id && p.get('major') && p.get('score') === player.score).map(p => p.name).join(', ')",
      "tied": "tiedName !== ''"
    },
    "tier": "player.self ? 'major' : 'notable'",
    "tags": ["politics", "international"]
  },
  {
    "id": "unhappiness-sets-in",
    "subject": "world",
    "window": "recent",
    "when": "dropped(self.happinessPercentage, self.before.happinessPercentage, 50)",
    "values": {
      "happiness": "self.happinessPercentage",
      "dropPoints": "self.before.happinessPercentage - self.happinessPercentage"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  }
]
