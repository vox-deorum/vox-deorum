[
  {
    "id": "falls-to-last-place",
    "subject": "world",
    "window": "short",
    "when": [
      "self.knows('major') && self.major === true",
      "self.knows('score') && Number.isFinite(self.score)",
      "self.before.knows('score') && Number.isFinite(self.before.score)",
      "players.filter(p => p.knows('major') && p.major === true && p.knows('score') && Number.isFinite(p.score)).length >= 3",
      "self.rank('score') === players.filter(p => p.knows('major') && p.major === true && p.knows('score') && Number.isFinite(p.score)).length",
      "self.before.rank('score') < players.filter(p => p.before.knows('score') && p.before.knows('major') && p.before.major === true).length"
    ],
    "values": {
      "count": "players.filter(p => p.knows('major') && p.major === true && p.knows('score') && Number.isFinite(p.score)).length"
    },
    "tier": "notable",
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-golden-age-begins",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.knows('player') && !event.player.self && event.player.knows('major') && event.player.major === true",
      "event.knows('starting') && event.starting === true",
      "event.player.knows('name')"
    ],
    "values": {
      "civilization": "event.player.name"
    },
    "tier": "notable",
    "adjust": "event.player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-golden-age-ends",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.knows('player') && !event.player.self && event.player.knows('major') && event.player.major === true",
      "event.knows('starting') && event.starting === false",
      "event.player.knows('name')"
    ],
    "values": {
      "civilization": "event.player.name"
    },
    "tier": "routine",
    "adjust": "event.player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "golden-age-begins",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.starting === true",
      "event.player.self === true",
      "self.knows('atWar')",
      "self.atWar === false"
    ],
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "golden-age-ends",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.starting === false",
      "event.player.self === true"
    ],
    "tier": "routine",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "golden-age-in-wartime",
    "subject": "event",
    "event": "PlayerGoldenAge",
    "when": [
      "event.starting",
      "event.player.self",
      "self.atWar",
      "self.knows('wars') && self.wars.some(p => p.knows('name') && p.name)"
    ],
    "values": {
      "enemies": "(() => { const names = self.wars.filter(p => p.knows('name') && p.name).map(p => p.name); return names.length <= 2 ? names.join(' and ') : names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1]; })()"
    },
    "tier": "notable"
  },
  {
    "id": "happiness-recovers",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('happinessPercentage') && Number.isFinite(self.happinessPercentage)",
      "self.before.knows('happinessPercentage') && Number.isFinite(self.before.happinessPercentage)",
      "crossed(self.happinessPercentage, self.before.happinessPercentage, 50)"
    ],
    "values": {
      "happinessPercentage": "self.happinessPercentage"
    },
    "tier": "routine",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "ideology-adopted",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('ideology') && typeof self.ideology === 'string'",
      "!self.before.knows('ideology') || self.before.ideology === null"
    ],
    "values": {
      "ideology": "self.ideology"
    },
    "tier": "major",
    "urgent": "true",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "ideology-switched",
    "subject": "event",
    "event": "IdeologySwitched",
    "when": [
      "event.knows('player') && event.player.knows('major') && event.player.major === true",
      "event.player.knows('name')",
      "event.knows('oldBranch') && typeof event.oldBranch === 'string'",
      "event.knows('newBranch') && typeof event.newBranch === 'string'",
      "event.oldBranch !== event.newBranch"
    ],
    "values": {
      "civilization": "event.player.name",
      "formerIdeology": "event.oldBranch",
      "ideology": "event.newBranch",
      "ours": "event.player.self === true"
    },
    "tier": "ours ? 'major' : 'notable'",
    "urgent": "ours",
    "tags": ["politics", "international"]
  },
  {
    "id": "major-reduced-to-single-city",
    "subject": "player",
    "window": "medium",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "player.knows('cityCount') && Number.isFinite(player.cityCount)",
      "player.knows('before') && player.before.knows('cityCount') && Number.isFinite(player.before.cityCount)",
      "player.cityCount === 1",
      "player.before.cityCount > 1"
    ],
    "values": {
      "civilization": "player.name",
      "lost": "player.before.cityCount - player.cityCount"
    },
    "tier": "major",
    "adjust": ["player.stake.relation", "Math.min(15, 5 * lost)"],
    "tags": ["politics", "international"]
  },
  {
    "id": "policy-adopted",
    "subject": "event",
    "event": "PlayerAdoptPolicy",
    "when": [
      "event.knows('player') && event.player.self === true",
      "event.knows('policy') && typeof event.policy === 'string' && event.policy.length > 0"
    ],
    "values": {
      "policy": "event.policy"
    },
    "tier": "routine",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "policy-branch-opened",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('policyBranches') && self.policyBranches !== null && typeof self.policyBranches === 'object'",
      "self.before.knows('policyBranches') && self.before.policyBranches !== null && typeof self.before.policyBranches === 'object'",
      "Object.keys(self.policyBranches).filter(branch => !Object.keys(self.before.policyBranches).includes(branch)).length === 1"
    ],
    "values": {
      "branch": "Object.keys(self.policyBranches).find(branch => !Object.keys(self.before.policyBranches).includes(branch))",
      "count": "Object.keys(self.policyBranches).length"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "revolt-threshold-cleared",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('happinessPercentage') && Number.isFinite(self.happinessPercentage)",
      "self.before.knows('happinessPercentage') && Number.isFinite(self.before.happinessPercentage)",
      "crossed(self.happinessPercentage, self.before.happinessPercentage, 35)",
      "self.happinessPercentage < 50"
    ],
    "values": {
      "happinessPercentage": "self.happinessPercentage"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "revolt-threshold-crossed",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('happinessPercentage') && Number.isFinite(self.happinessPercentage)",
      "self.before.knows('happinessPercentage') && Number.isFinite(self.before.happinessPercentage)",
      "self.happinessPercentage < 35",
      "self.before.happinessPercentage >= 35"
    ],
    "values": {
      "happiness": "self.happinessPercentage"
    },
    "tier": "major",
    "urgent": "true",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "rival-adopts-ideology",
    "subject": "player",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "player.knows('ideology') && typeof player.ideology === 'string'",
      "!player.before.knows('ideology') || player.before.ideology === null"
    ],
    "values": {
      "name": "player.name",
      "ideology": "player.ideology",
      "shared": "self.knows('ideology') && typeof self.ideology === 'string' && self.ideology === player.ideology"
    },
    "tier": "self.knows('ideology') && typeof self.ideology === 'string' && self.ideology !== player.ideology ? 'major' : 'notable'",
    "tags": ["politics", "international"]
  },
  {
    "id": "score-leader-changes",
    "subject": "player",
    "window": "short",
    "when": [
      "player.knows('major') && player.major === true",
      "player.knows('name')",
      "player.knows('score') && Number.isFinite(player.score)",
      "player.before.knows('score')",
      "player.rank('score') === 1",
      "player.before.rank('score') > 1",
      "players.every(p => p.id === player.id || !p.knows('major') || p.major !== true || !p.knows('score') || p.score !== player.score || (p.knows('name') && p.name))"
    ],
    "values": {
      "civilization": "player.name",
      "tiedName": "players.filter(p => p.id !== player.id && p.knows('major') && p.major === true && p.knows('score') && p.score === player.score).map(p => p.name).join(', ')",
      "tied": "tiedName !== ''"
    },
    "tier": "player.self ? 'major' : 'notable'",
    "tags": ["politics", "international"]
  },
  {
    "id": "unhappiness-sets-in",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('happinessPercentage') && Number.isFinite(self.happinessPercentage)",
      "self.before.knows('happinessPercentage') && Number.isFinite(self.before.happinessPercentage)",
      "self.happinessPercentage < 50",
      "self.before.happinessPercentage >= 50"
    ],
    "values": {
      "happiness": "self.happinessPercentage",
      "dropPoints": "self.before.happinessPercentage - self.happinessPercentage"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  }
]
