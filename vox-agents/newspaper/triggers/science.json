[
  {
    "id": "friend-enters-new-era",
    "subject": "player",
    "window": "recent",
    "when": [
      "!player.self",
      "player.knows('major') && player.major === true",
      "player.knows('name')",
      "(player.knows('friend') && player.friend === true) || (player.knows('ally') && player.ally === true)",
      "player.knows('era') && typeof player.era === 'string'",
      "player.knows('before') && player.before.knows('era') && typeof player.before.era === 'string'",
      "changed(player, 'era')"
    ],
    "values": {
      "civilization": "player.name",
      "era": "player.era",
      "former": "player.before.era",
      "distance": "player.knows('distance') ? player.distance : null"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "nearby-team-gains-technology",
    "subject": "event",
    "event": "TeamTechResearched",
    "when": [
      "event.knows('tech') && typeof event.tech === 'string' && event.tech.length > 0",
      "!event.knows('changeAmount') || event.changeAmount > 0",
      "event.knows('teamId') && self.knows('teamId') && event.teamId !== self.teamId",
      "event.knows('players') && event.players.some(p => p.knows('major') && p.major === true && p.knows('distance') && p.distance <= nearby && p.knows('name'))",
      "self.hasTechnology(event.tech) !== true"
    ],
    "values": {
      "tech": "event.tech",
      "team": "event.players.filter(p => p.knows('major') && p.major === true && p.knows('name')).map(p => p.name).join(' and ')"
    },
    "tier": "routine",
    "tags": ["science", "international"]
  },
  {
    "id": "nearby-team-gains-known-technology",
    "subject": "event",
    "event": "TeamTechResearched",
    "when": [
      "event.knows('tech') && typeof event.tech === 'string' && event.tech.length > 0",
      "!event.knows('changeAmount') || event.changeAmount > 0",
      "event.knows('teamId') && self.knows('teamId') && event.teamId !== self.teamId",
      "event.knows('players') && event.players.some(p => p.knows('major') && p.major === true && p.knows('distance') && p.distance <= nearby && p.knows('name'))",
      "self.hasTechnology(event.tech) === true"
    ],
    "values": {
      "tech": "event.tech",
      "team": "event.players.filter(p => p.knows('major') && p.major === true && p.knows('name')).map(p => p.name).join(' and ')"
    },
    "tier": "routine",
    "tags": ["science", "international"]
  },
  {
    "id": "new-era",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('era') && typeof self.era === 'string'",
      "self.before.knows('era') && typeof self.before.era === 'string'",
      "changed(self, 'era')"
    ],
    "values": {
      "era": "self.era"
    },
    "tier": "major",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "our-team-gains-technology",
    "subject": "event",
    "event": "TeamTechResearched",
    "when": [
      "event.knows('tech') && typeof event.tech === 'string' && event.tech.length > 0",
      "!event.knows('changeAmount') || event.changeAmount > 0",
      "event.knows('players') && event.players.some(p => p.self === true)"
    ],
    "values": {
      "tech": "event.tech",
      "era": "self.knows('era') ? self.era : null"
    },
    "tier": "notable",
    "tags": ["science", "domestic"]
  },
  {
    "id": "rival-enters-new-era",
    "subject": "player",
    "window": "recent",
    "when": [
      "!player.self",
      "player.knows('major') && player.major === true",
      "player.knows('name')",
      "!((player.knows('friend') && player.friend === true) || (player.knows('ally') && player.ally === true))",
      "player.knows('era') && typeof player.era === 'string'",
      "player.knows('before') && player.before.knows('era') && typeof player.before.era === 'string'",
      "changed(player, 'era')"
    ],
    "values": {
      "civilization": "player.name",
      "era": "player.era",
      "former": "player.before.era",
      "distance": "player.knows('distance') ? player.distance : null"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "technology-leader-changes",
    "subject": "player",
    "window": "short",
    "when": [
      "player.knows('major') && player.major === true",
      "player.knows('name')",
      "player.knows('technologies') && Number.isFinite(player.technologies)",
      "player.knows('before') && player.before.knows('technologies') && Number.isFinite(player.before.technologies)",
      "player.rank('technologies') === 1",
      "player.before.rank('technologies') > 1",
      "players.some(p => p.id !== player.id && p.knows('major') && p.major && p.knows('technologies') && Number.isFinite(p.technologies))"
    ],
    "values": {
      "civilization": "player.name",
      "count": "player.technologies",
      "tied": "players.some(p => p.id !== player.id && p.knows('major') && p.major && p.knows('technologies') && p.technologies === player.technologies)"
    },
    "tier": "player.self ? 'major' : 'notable'"
  }
]
