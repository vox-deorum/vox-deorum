[
  {
    "id": "friend-enters-new-era",
    "subject": "player",
    "window": "recent",
    "when": [
      "!player.self",
      "player.major",
      "player.get('friend') || player.get('ally')",
      "player.era",
      "player.get('before.era')",
      "changed(player, 'era')"
    ],
    "values": {
      "civilization": "player.name",
      "era": "player.era",
      "former": "player.before.era",
      "distance": "player.get('distance') ?? null"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "nearby-team-gains-known-technology",
    "subject": "event",
    "event": "TeamTechResearched",
    "when": [
      "event.is.techGain",
      "event.teamId !== self.teamId",
      "event.players.some(p => p.get('major') && p.get('name'))",
      "self.hasTechnology(event.tech)"
    ],
    "values": {
      "tech": "event.tech",
      "team": "event.players.filter(p => p.get('major') && p.get('name')).map(p => p.name).join(' and ')"
    },
    "tier": "routine",
    "adjust": "Math.max(...event.players.filter(p => p.get('major')).map(p => p.stake.relation))",
    "tags": ["science", "international"]
  },
  {
    "id": "nearby-team-gains-technology",
    "subject": "event",
    "event": "TeamTechResearched",
    "when": [
      "event.is.techGain",
      "event.teamId !== self.teamId",
      "event.players.some(p => p.get('major') && p.get('name'))",
      "!self.hasTechnology(event.tech)"
    ],
    "values": {
      "tech": "event.tech",
      "team": "event.players.filter(p => p.get('major') && p.get('name')).map(p => p.name).join(' and ')"
    },
    "tier": "routine",
    "adjust": "Math.max(...event.players.filter(p => p.get('major')).map(p => p.stake.relation))",
    "tags": ["science", "international"]
  },
  {
    "id": "new-era",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.era",
      "self.get('before.era')",
      "changed(self, 'era')"
    ],
    "values": {
      "era": "self.era"
    },
    "tier": "major",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "our-team-gains-technology",
    "subject": "event",
    "event": "TeamTechResearched",
    "when": [
      "event.is.techGain",
      "event.players.some(p => p.self)"
    ],
    "values": {
      "tech": "event.tech",
      "era": "self.get('era') ?? null"
    },
    "tier": "notable",
    "tags": ["science", "domestic"]
  },
  {
    "id": "rival-enters-new-era",
    "subject": "player",
    "window": "recent",
    "when": [
      "!player.self",
      "player.major",
      "!(player.get('friend') || player.get('ally'))",
      "player.era",
      "player.get('before.era')",
      "changed(player, 'era')"
    ],
    "values": {
      "civilization": "player.name",
      "era": "player.era",
      "former": "player.before.era",
      "distance": "player.get('distance') ?? null"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "technology-leader-changes",
    "subject": "player",
    "window": "short",
    "when": [
      "player.major",
      "player.rank('technologies') === 1",
      "player.get('before.technologies') !== undefined && player.before.rank('technologies') > 1",
      "majorsWith('technologies') > 1"
    ],
    "values": {
      "civilization": "player.name",
      "count": "player.technologies",
      "tied": "players.some(p => p.id !== player.id && p.get('major') && p.get('technologies') === player.technologies)"
    },
    "tier": "player.self ? 'major' : 'notable'"
  }
]
