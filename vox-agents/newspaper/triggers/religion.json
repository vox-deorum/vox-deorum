[
  {
    "id": "faith-drifts",
    "subject": "world",
    "when": [
      "self.knows('foundedReligion') && typeof self.foundedReligion === 'string'",
      "self.foundedReligion.length > 0",
      "self.is.hasMajorityReligion",
      "self.foundedReligion !== self.majorityReligion"
    ],
    "values": {
      "founded": "self.foundedReligion",
      "majorityFaith": "self.majorityReligion"
    },
    "importance": 60,
    "tags": ["politics", "domestic"]
  },
  {
    "id": "faith-reaches-city-state",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign",
      "city.knows('owner') && city.owner.knows('cityState') && city.owner.cityState === true",
      "city.knows('distance') && city.distance.knows('own') && city.distance.own > neighboring",
      "city.knows('majorityReligion') && typeof city.majorityReligion === 'string' && city.majorityReligion.length > 0",
      "city.knows('before') && city.before.knows('majorityReligion')",
      "changed(city, 'majorityReligion')",
      "self.knows('foundedReligion') && typeof self.foundedReligion === 'string' && self.foundedReligion === city.majorityReligion",
      "city.conversions.some(c => c.knows('religion') && c.religion === city.majorityReligion)"
    ],
    "values": { "cityState": "city.knows('owner') && city.owner.knows('name') ? city.owner.name : null", "religion": "city.majorityReligion" },
    "importance": 55,
    "tags": ["politics", "international"]
  },
  {
    "id": "faith-reaches-distant-city",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.knows('foreign') && city.foreign === true",
      "city.knows('owner') && city.owner.major === true",
      "self.is.hasFoundedReligion",
      "city.knows('majorityReligion') && city.majorityReligion === self.foundedReligion",
      "city.knows('before') && city.before.knows('majorityReligion')",
      "changed(city, 'majorityReligion')",
      "city.knows('distance') && city.distance.knows('own') && city.distance.own > neighboring",
      "city.conversions.some(c => c.knows('religion') && c.religion === city.majorityReligion)"
    ],
    "values": {
      "cityName": "city.knows('name') ? city.name : null",
      "civilization": "city.owner.knows('name') ? city.owner.name : null",
      "religion": "city.majorityReligion",
      "distance": "city.distance.own"
    },
    "importance": 55,
    "tags": ["religion", "international"]
  },
  {
    "id": "foreign-faith-deepens",
    "subject": "event",
    "event": ["ReligionEnhanced", "ReligionReformed"],
    "when": [
      "event.knows('player') && event.player.self === false && event.player.knows('major') && event.player.major === true",
      "event.knows('religion') && typeof event.religion === 'string' && event.religion.length > 0"
    ],
    "values": {
      "civilization": "event.player.knows('name') ? event.player.name : null",
      "religion": "event.religion",
      "stage": "event.type === 'ReligionReformed' ? 'reformed' : 'enhanced'"
    },
    "importance": "stage === 'reformed' ? 55 : 45",
    "tags": ["religion", "international"]
  },
  {
    "id": "foreign-major-adopts-our-faith",
    "subject": "player",
    "window": "medium",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.is.hasMajorityReligion",
      "player.knows('before') && player.before.knows('majorityReligion')",
      "(player.before.majorityReligion === null || player.before.majorityReligion === -1 || player.before.majorityReligion === '' || (typeof player.before.majorityReligion === 'string' && player.before.majorityReligion.length > 0 && player.before.majorityReligion !== player.majorityReligion))",
      "self.knows('foundedReligion') && typeof self.foundedReligion === 'string' && self.foundedReligion === player.majorityReligion"
    ],
    "values": {
      "civilization": "player.knows('name') ? player.name : null",
      "religion": "player.majorityReligion"
    },
    "importance": 65,
    "tags": ["politics", "international", "religion"]
  },
  {
    "id": "foreign-religion-founded",
    "subject": "event",
    "event": "ReligionFounded",
    "when": [
      "event.knows('player') && !event.player.self && event.player.major",
      "event.knows('religion') && typeof event.religion === 'string' && event.religion.length > 0"
    ],
    "values": {
      "civilization": "event.player.knows('name') ? event.player.name : null",
      "religion": "event.religion",
      "holyCity": "event.knows('holyCity') && event.holyCity.knows('name') ? event.holyCity.name : null"
    },
    "importance": 55,
    "tags": ["politics", "international"]
  },
  {
    "id": "national-majority-faith-changed",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.is.hasMajorityReligion",
      "self.knows('before') && self.before.knows('majorityReligion')",
      "(typeof self.before.majorityReligion === 'string' && self.before.majorityReligion.length > 0) || self.before.majorityReligion === null || self.before.majorityReligion === -1 || self.before.majorityReligion === ''",
      "self.majorityReligion !== self.before.majorityReligion"
    ],
    "values": {
      "religion": "self.majorityReligion",
      "former": "typeof self.before.majorityReligion === 'string' && self.before.majorityReligion.length > 0 ? self.before.majorityReligion : null",
      "founded": "self.is.hasFoundedReligion ? self.foundedReligion : null"
    },
    "importance": 70,
    "tags": ["politics", "domestic", "religion"]
  },
  {
    "id": "neighbor-majority-faith-changed",
    "subject": "player",
    "when": [
      "!player.self && player.major && player.is.nearby",
      "player.is.hasMajorityReligion",
      "player.knows('before') && player.before.knows('majorityReligion') && typeof player.before.majorityReligion === 'string' && player.before.majorityReligion.length > 0",
      "player.majorityReligion !== player.before.majorityReligion",
      "!(self.knows('foundedReligion') && self.foundedReligion === player.majorityReligion)",
      "!(self.knows('majorityReligion') && self.majorityReligion === player.majorityReligion)"
    ],
    "values": {
      "civilization": "player.knows('name') ? player.name : null",
      "religion": "player.majorityReligion",
      "former": "player.before.majorityReligion"
    },
    "importance": 60,
    "tags": ["politics", "international", "religion"]
  },
  {
    "id": "neighbors-convert",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.is.neighbor",
      "city.majorityReligion && changed(city, 'majorityReligion')"
    ],
    "group": {
      "by": "city.majorityReligion",
      "min": 3
    },
    "importance": "40 + 10 * count"
  },
  {
    "id": "our-faith-deepens",
    "subject": "event",
    "event": [
      "ReligionEnhanced",
      "ReligionReformed"
    ],
    "when": [
      "event.knows('player') && event.player.self === true",
      "event.knows('religion') && typeof event.religion === 'string' && event.religion.length > 0"
    ],
    "values": {
      "religion": "event.religion",
      "stage": "event.type === 'ReligionReformed' ? 'reformed' : 'enhanced'"
    },
    "importance": "stage === 'reformed' ? 70 : 60",
    "tags": ["religion", "domestic"]
  },
  {
    "id": "own-cities-divided-by-faith",
    "subject": "world",
    "when": [
      "self.is.hasFoundedReligion",
      "self.cities.some(c => c.own && c.knows('majorityReligion') && c.majorityReligion === self.foundedReligion)",
      "self.cities.filter(c => c.is.followsAnotherReligion).length >= 2"
    ],
    "values": {
      "founded": "self.foundedReligion",
      "divided": "self.cities.filter(c => c.is.followsAnotherReligion).length",
      "faithful": "self.cities.filter(c => c.own && c.knows('majorityReligion') && c.majorityReligion === self.foundedReligion).length",
      "others": "self.cities.filter(c => c.is.followsAnotherReligion).map(c => c.majorityReligion).filter((r, i, all) => all.indexOf(r) === i).join(', ')"
    },
    "importance": "45 + Math.min(25, 5 * divided)",
    "tags": ["politics", "domestic", "religion"]
  },
  {
    "id": "own-city-converts",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own",
      "city.knows('majorityReligion') && typeof city.majorityReligion === 'string'",
      "city.conversions.some(c => c.knows('religion') && c.religion === city.majorityReligion)"
    ],
    "values": {
      "religion": "city.majorityReligion",
      "ours": "self.knows('foundedReligion') && typeof self.foundedReligion === 'string' && city.majorityReligion === self.foundedReligion"
    },
    "importance": "ours ? 55 : 65",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "pantheon-founded",
    "subject": "event",
    "event": "PantheonFounded",
    "when": [
      "event.knows('player') && event.player.knows('name')",
      "event.player.knows('major') && event.player.major === true"
    ],
    "values": {
      "civilization": "event.player.name",
      "ours": "event.player.self === true",
      "cityName": "event.knows('city') && event.city.knows('name') ? event.city.name : null",
      "belief": "event.knows('beliefType') && typeof event.beliefType === 'string' ? event.beliefType : null"
    },
    "importance": "ours ? 60 : 45",
    "tags": ["religion", "international"]
  },
  {
    "id": "religion-founded",
    "subject": "world",
    "when": [
      "self.knows('foundedReligion') && typeof self.foundedReligion === 'string'",
      "!self.before.knows('foundedReligion') || self.before.foundedReligion === null"
    ],
    "values": {
      "religion": "self.foundedReligion"
    },
    "importance": 75,
    "tags": ["politics", "domestic"]
  }
]
