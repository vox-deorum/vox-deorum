[
  {
    "id": "faith-drifts",
    "subject": "world",
    "when": [
      "self.is.hasFoundedReligion",
      "self.is.hasMajorityReligion",
      "self.foundedReligion !== self.majorityReligion"
    ],
    "values": {
      "founded": "self.foundedReligion",
      "majorityFaith": "self.majorityReligion"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "faith-reaches-city-state",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign",
      "city.knows('name')",
      "city.owner.cityState",
      "city.distance.own > neighboring",
      "city.majorityReligion",
      "city.get('before.majorityReligion') !== undefined",
      "changed(city, 'majorityReligion')",
      "self.is.hasFoundedReligion && self.foundedReligion === city.majorityReligion",
      "city.is.convertedToMajority"
    ],
    "values": { "cityState": "city.owner.name", "religion": "city.majorityReligion" },
    "tier": "notable",
    "adjust": "city.owner.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "faith-reaches-distant-city",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign",
      "city.knows('name')",
      "city.owner.major",
      "self.is.hasFoundedReligion",
      "city.majorityReligion === self.foundedReligion",
      "city.get('before.majorityReligion') !== undefined",
      "changed(city, 'majorityReligion')",
      "city.distance.own > neighboring",
      "city.is.convertedToMajority"
    ],
    "values": {
      "civilization": "city.owner.name",
      "religion": "city.majorityReligion",
      "distance": "city.distance.own"
    },
    "tier": "notable",
    "adjust": "city.owner.stake.relation",
    "tags": ["religion", "international"]
  },
  {
    "id": "foreign-faith-deepens",
    "subject": "event",
    "event": ["ReligionEnhanced", "ReligionReformed"],
    "when": [
      "event.player.is.foreignMajor",
      "event.religion"
    ],
    "values": {
      "civilization": "event.player.name",
      "religion": "event.religion",
      "stage": "event.type === 'ReligionReformed' ? 'reformed' : 'enhanced'"
    },
    "tier": "stage === 'reformed' ? 'notable' : 'routine'",
    "adjust": "event.player.stake.relation",
    "tags": ["religion", "international"]
  },
  {
    "id": "foreign-major-adopts-our-faith",
    "subject": "player",
    "window": "medium",
    "when": [
      "!player.self && player.major",
      "player.is.hasMajorityReligion",
      "player.get('before.majorityReligion') !== undefined",
      "(player.before.majorityReligion === null || player.before.majorityReligion === -1 || player.before.majorityReligion === '' || (typeof player.before.majorityReligion === 'string' && player.before.majorityReligion.length > 0 && player.before.majorityReligion !== player.majorityReligion))",
      "self.foundedReligion === player.majorityReligion"
    ],
    "values": {
      "civilization": "player.name",
      "religion": "player.majorityReligion"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international", "religion"]
  },
  {
    "id": "foreign-religion-founded",
    "subject": "event",
    "event": "ReligionFounded",
    "when": [
      "event.player.is.foreignMajor",
      "event.religion"
    ],
    "values": {
      "civilization": "event.player.name",
      "religion": "event.religion",
      "holyCity": "event.holyCity.name"
    },
    "tier": "notable",
    "adjust": "event.player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "national-majority-faith-changed",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.is.hasMajorityReligion",
      "self.get('before.majorityReligion') !== undefined",
      "(typeof self.before.majorityReligion === 'string' && self.before.majorityReligion.length > 0) || self.before.majorityReligion === null || self.before.majorityReligion === -1 || self.before.majorityReligion === ''",
      "self.majorityReligion !== self.before.majorityReligion"
    ],
    "values": {
      "religion": "self.majorityReligion",
      "former": "typeof self.before.majorityReligion === 'string' && self.before.majorityReligion.length > 0 ? self.before.majorityReligion : null",
      "founded": "self.is.hasFoundedReligion ? self.foundedReligion : null"
    },
    "tier": "major",
    "tags": ["politics", "domestic", "religion"]
  },
  {
    "id": "neighbor-majority-faith-changed",
    "subject": "player",
    "when": [
      "!player.self && player.major",
      "player.is.hasMajorityReligion",
      "typeof player.get('before.majorityReligion') === 'string' && player.before.majorityReligion.length > 0",
      "player.majorityReligion !== player.before.majorityReligion",
      "self.get('foundedReligion') !== player.majorityReligion",
      "self.get('majorityReligion') !== player.majorityReligion"
    ],
    "values": {
      "civilization": "player.name",
      "religion": "player.majorityReligion",
      "former": "player.before.majorityReligion"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international", "religion"]
  },
  {
    "id": "neighbors-convert",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign",
      "city.majorityReligion && changed(city, 'majorityReligion')"
    ],
    "group": {
      "by": "city.majorityReligion",
      "min": 3
    },
    "values": { "place": "city.distance.knows('own') ? city.stake.place : 0" },
    "tier": "notable",
    "adjust": ["Math.max(...matches.map(m => m.values.place))", "Math.min(15, 5 * (count - 3))"]
  },
  {
    "id": "our-faith-deepens",
    "subject": "event",
    "event": [
      "ReligionEnhanced",
      "ReligionReformed"
    ],
    "when": [
      "event.player.self",
      "event.religion"
    ],
    "values": {
      "religion": "event.religion",
      "stage": "event.type === 'ReligionReformed' ? 'reformed' : 'enhanced'"
    },
    "tier": "stage === 'reformed' ? 'major' : 'notable'",
    "tags": ["religion", "domestic"]
  },
  {
    "id": "own-cities-divided-by-faith",
    "subject": "world",
    "when": [
      "self.is.hasFoundedReligion",
      "self.cities.some(c => c.own && c.get('majorityReligion') === self.foundedReligion)",
      "self.cities.filter(c => c.is.followsAnotherReligion).length >= 2"
    ],
    "values": {
      "founded": "self.foundedReligion",
      "divided": "self.cities.filter(c => c.is.followsAnotherReligion).length",
      "faithful": "self.cities.filter(c => c.own && c.get('majorityReligion') === self.foundedReligion).length",
      "others": "self.cities.filter(c => c.is.followsAnotherReligion).map(c => c.majorityReligion).filter((r, i, all) => all.indexOf(r) === i).join(', ')"
    },
    "tier": "notable",
    "adjust": "Math.min(15, 5 * divided)",
    "tags": ["politics", "domestic", "religion"]
  },
  {
    "id": "own-city-converts",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own",
      "typeof city.majorityReligion === 'string'",
      "city.is.convertedToMajority"
    ],
    "values": {
      "religion": "city.majorityReligion",
      "ours": "self.get('foundedReligion') === city.majorityReligion"
    },
    "tier": "ours ? 'routine' : 'notable'",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "pantheon-founded",
    "subject": "event",
    "event": "PantheonFounded",
    "when": [
      "event.player.major",
      "event.city.knows('name')",
      "event.beliefType?.trim()"
    ],
    "values": {
      "civilization": "event.player.name",
      "ours": "event.player.self",
      "belief": "event.beliefType"
    },
    "tier": "ours ? 'notable' : 'routine'",
    "adjust": "event.player.stake.relation",
    "tags": ["religion", "international"]
  },
  {
    "id": "religion-founded",
    "subject": "world",
    "when": [
      "self.is.hasFoundedReligion",
      "!self.get('before.foundedReligion')"
    ],
    "values": {
      "religion": "self.foundedReligion"
    },
    "tier": "major",
    "tags": ["politics", "domestic"]
  }
]
