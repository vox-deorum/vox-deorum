[
  {
    "id": "election-operation",
    "subject": "event",
    "event": ["ElectionResultSuccess", "ElectionResultFailure"],
    "when": [
      "event.player.self",
      "event.cityState.trim()"
    ],
    "values": {
      "success": "event.type === 'ElectionResultSuccess'",
      "cityState": "event.cityState",
      "influence": "event.knows('influenceChange') ? event.influenceChange : null"
    },
    "tier": "success ? 'notable' : 'routine'",
    "tags": ["politics", "international"]
  },
  {
    "id": "our-diplomat-abroad",
    "subject": "player",
    "when": [
      "!player.self && player.major",
      "player.ourDiplomatThere",
      "player.get('before.ourDiplomatThere') === false"
    ],
    "values": {
      "civilization": "player.name",
      "capital": "player.knows('capital') && player.capital.knows('name') ? player.capital.name : null"
    },
    "tier": "routine",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-caught-at-home",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.perspective === 'target'",
      "event.spyResult === 'Identified' || event.spyResult === 'Killed'"
    ],
    "values": {
      "result": "event.spyResult",
      "cityName": "event.knows('cityName') ? event.cityName : null"
    },
    "tier": "event.spyResult === 'Killed' ? 'major' : 'notable'",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-detected-abroad",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.perspective === 'source'",
      "event.spyResult === 'Detected'"
    ],
    "values": {
      "result": "event.spyResult",
      "cityName": "event.knows('cityName') && typeof event.cityName === 'string' ? event.cityName : null",
      "target": "event.knows('targetPlayer') && event.targetPlayer.knows('name') ? event.targetPlayer.name : null",
      "possibleTechnology": "event.knows('tech') && typeof event.tech === 'string' ? event.tech : null"
    },
    "tier": "possibleTechnology ? 'notable' : 'routine'",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-detected-at-home",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.perspective === 'target'",
      "['Detected', 'KilledNotIdentified'].includes(event.spyResult)"
    ],
    "values": {
      "result": "event.spyResult",
      "cityName": "event.knows('cityName') ? event.cityName : null"
    },
    "tier": "result === 'KilledNotIdentified' ? 'notable' : 'routine'",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-exposed-abroad",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.perspective === 'source'",
      "['Identified', 'Killed', 'KilledNotIdentified'].includes(event.spyResult)"
    ],
    "values": {
      "result": "event.spyResult",
      "cityName": "event.knows('cityName') && typeof event.cityName === 'string' ? event.cityName : null",
      "target": "event.knows('targetPlayer') && event.targetPlayer.knows('name') ? event.targetPlayer.name : null",
      "possibleTechnology": "event.knows('tech') && typeof event.tech === 'string' ? event.tech : null"
    },
    "tier": "result === 'Identified' ? 'notable' : 'major'",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-may-gain-technology",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.perspective === 'source'",
      "event.spyResult === 'Undetected'",
      "event.tech"
    ],
    "values": {
      "possibleTechnology": "event.tech",
      "cityName": "event.knows('cityName') ? event.cityName : null",
      "target": "event.knows('targetPlayer') && event.targetPlayer.knows('name') ? event.targetPlayer.name : null"
    },
    "tier": "notable",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-posted-abroad",
    "subject": "city",
    "when": [
      "city.foreign && city.knows('name')",
      "city.ourSpyPresent",
      "city.get('before.ourSpyPresent') === false",
      "city.owner.major && city.get('before.owner.id') === city.owner.id"
    ],
    "values": {
      "civilization": "city.owner.name"
    },
    "tier": "routine",
    "adjust": "city.stake.place",
    "tags": ["politics", "international"]
  },
  {
    "id": "their-diplomat-arrives",
    "subject": "player",
    "when": [
      "!player.self && player.major",
      "player.theirDiplomatHere",
      "player.get('before.theirDiplomatHere') === false"
    ],
    "values": {
      "civilization": "player.name"
    },
    "tier": "routine",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  }
]
