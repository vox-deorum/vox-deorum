[
  {
    "id": "election-operation",
    "subject": "event",
    "event": ["ElectionResultSuccess", "ElectionResultFailure"],
    "when": [
      "event.knows('player') && event.player.self === true",
      "event.knows('cityState') && typeof event.cityState === 'string' && event.cityState.trim().length > 0"
    ],
    "values": {
      "success": "event.type === 'ElectionResultSuccess'",
      "cityState": "event.cityState",
      "influence": "event.knows('influenceChange') ? event.influenceChange : null"
    },
    "importance": "success ? 55 : 45",
    "tags": ["politics", "international"]
  },
  {
    "id": "our-diplomat-abroad",
    "subject": "player",
    "when": [
      "!player.self && player.major",
      "player.knows('name')",
      "player.knows('ourDiplomatThere') && player.ourDiplomatThere === true",
      "player.knows('before') && player.before.knows('ourDiplomatThere') && player.before.ourDiplomatThere === false"
    ],
    "values": {
      "civilization": "player.name",
      "capital": "player.knows('capital') && player.capital.knows('name') ? player.capital.name : null"
    },
    "importance": 50,
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-caught-at-home",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.knows('perspective') && event.perspective === 'target'",
      "event.knows('spyResult') && (event.spyResult === 'Identified' || event.spyResult === 'Killed')"
    ],
    "values": {
      "result": "event.spyResult",
      "cityName": "event.knows('cityName') ? event.cityName : null"
    },
    "importance": "event.spyResult === 'Killed' ? 70 : 60",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-detected-abroad",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.knows('perspective') && event.perspective === 'source'",
      "event.knows('spyResult') && event.spyResult === 'Detected'"
    ],
    "values": {
      "result": "event.spyResult",
      "cityName": "event.knows('cityName') && typeof event.cityName === 'string' ? event.cityName : null",
      "target": "event.knows('targetPlayer') && event.targetPlayer.knows('name') ? event.targetPlayer.name : null",
      "possibleTechnology": "event.knows('tech') && typeof event.tech === 'string' ? event.tech : null"
    },
    "importance": "possibleTechnology ? 55 : 45",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-detected-at-home",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.knows('perspective') && event.perspective === 'target'",
      "event.knows('spyResult') && ['Detected', 'KilledNotIdentified'].includes(event.spyResult)"
    ],
    "values": {
      "result": "event.spyResult",
      "cityName": "event.knows('cityName') ? event.cityName : null"
    },
    "importance": "result === 'KilledNotIdentified' ? 60 : 50",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-exposed-abroad",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.knows('perspective') && event.perspective === 'source'",
      "event.knows('spyResult') && ['Identified', 'Killed', 'KilledNotIdentified'].includes(event.spyResult)"
    ],
    "values": {
      "result": "event.spyResult",
      "cityName": "event.knows('cityName') && typeof event.cityName === 'string' ? event.cityName : null",
      "target": "event.knows('targetPlayer') && event.targetPlayer.knows('name') ? event.targetPlayer.name : null",
      "possibleTechnology": "event.knows('tech') && typeof event.tech === 'string' ? event.tech : null"
    },
    "importance": "result === 'Identified' ? 60 : 70",
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-may-gain-technology",
    "subject": "event",
    "event": "EspionageResult",
    "when": [
      "event.knows('perspective') && event.perspective === 'source'",
      "event.knows('spyResult') && event.spyResult === 'Undetected'",
      "event.knows('tech') && typeof event.tech === 'string' && event.tech.length > 0"
    ],
    "values": {
      "possibleTechnology": "event.tech",
      "cityName": "event.knows('cityName') ? event.cityName : null",
      "target": "event.knows('targetPlayer') && event.targetPlayer.knows('name') ? event.targetPlayer.name : null"
    },
    "importance": 65,
    "tags": ["politics", "international"]
  },
  {
    "id": "spy-posted-abroad",
    "subject": "city",
    "when": [
      "city.foreign && city.knows('name')",
      "city.knows('ourSpyPresent') && city.ourSpyPresent === true",
      "city.knows('before') && city.before.knows('ourSpyPresent') && city.before.ourSpyPresent === false",
      "city.knows('owner') && city.owner.major && city.owner.knows('name') && city.before.knows('owner') && city.before.owner.id === city.owner.id"
    ],
    "values": {
      "cityName": "city.name",
      "civilization": "city.owner.name"
    },
    "importance": 45,
    "tags": ["politics", "international"]
  },
  {
    "id": "their-diplomat-arrives",
    "subject": "player",
    "when": [
      "!player.self && player.major",
      "player.knows('name')",
      "player.knows('theirDiplomatHere') && player.theirDiplomatHere === true",
      "player.knows('before') && player.before.knows('theirDiplomatHere') && player.before.theirDiplomatHere === false"
    ],
    "values": {
      "civilization": "player.name"
    },
    "importance": 45,
    "tags": ["politics", "international"]
  }
]
