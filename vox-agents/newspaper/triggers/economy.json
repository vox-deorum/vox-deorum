[
  {
    "id": "treasury-falls-into-deficit",
    "subject": "world",
    "window": "recent",
    "when": "dropped(self.goldPerTurn, self.before.goldPerTurn, 0)",
    "values": {
      "deficit": "-self.goldPerTurn"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "treasury-milestone",
    "subject": "world",
    "window": "recent",
    "when": "crossed(self.gold, self.before.gold, 1000)",
    "values": {
      "gold": "self.gold",
      "gain": "self.gold - self.before.gold"
    },
    "tier": "routine",
    "repeat": "once",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "treasury-reserve-recovers",
    "subject": "world",
    "when": [
      "self.gold >= 0",
      "self.goldPerTurn < 0",
      "self.gold / -self.goldPerTurn > short",
      "self.get('before.goldPerTurn') < 0",
      "self.get('before.gold') >= 0",
      "self.before.gold / -self.before.goldPerTurn <= short"
    ],
    "values": {
      "gold": "self.gold",
      "deficit": "-self.goldPerTurn",
      "turnsLeft": "Math.floor(self.gold / -self.goldPerTurn)"
    },
    "tier": "routine",
    "tags": ["economy", "domestic"]
  },
  {
    "id": "treasury-reserve-runs-short",
    "subject": "world",
    "when": [
      "self.gold >= 0",
      "self.goldPerTurn < 0",
      "self.gold / -self.goldPerTurn <= short",
      "self.get('before.goldPerTurn') < 0"
    ],
    "values": {
      "gold": "self.gold",
      "deficit": "-self.goldPerTurn",
      "turnsLeft": "Math.floor(self.gold / -self.goldPerTurn)"
    },
    "tier": "turnsLeft <= recent ? 'major' : 'notable'",
    "tags": ["economy", "domestic"]
  },
  {
    "id": "treasury-returns-to-surplus",
    "subject": "world",
    "window": "recent",
    "when": "crossed(self.goldPerTurn, self.before.goldPerTurn, 0)",
    "values": {
      "goldPerTurn": "self.goldPerTurn"
    },
    "tier": "routine",
    "tags": ["politics", "domestic"]
  }
]
