[
  {
    "id": "treasury-falls-into-deficit",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('goldPerTurn') && Number.isFinite(self.goldPerTurn)",
      "self.before.knows('goldPerTurn') && Number.isFinite(self.before.goldPerTurn)",
      "self.goldPerTurn < 0",
      "self.before.goldPerTurn >= 0"
    ],
    "values": {
      "deficit": "-self.goldPerTurn"
    },
    "tier": "notable",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "treasury-milestone",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('gold') && Number.isFinite(self.gold)",
      "self.knows('before') && self.before.knows('gold') && Number.isFinite(self.before.gold)",
      "crossed(self.gold, self.before.gold, 1000)"
    ],
    "values": {
      "gold": "self.gold",
      "gain": "self.gold - self.before.gold"
    },
    "tier": "routine",
    "repeat": "once",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "treasury-reserve-recovers",
    "subject": "world",
    "when": [
      "Number.isFinite(self.gold) && self.gold >= 0",
      "Number.isFinite(self.goldPerTurn) && self.goldPerTurn < 0",
      "self.gold / -self.goldPerTurn > short",
      "self.knows('before') && Number.isFinite(self.before.goldPerTurn) && self.before.goldPerTurn < 0",
      "self.before.knows('gold') && Number.isFinite(self.before.gold) && self.before.gold >= 0",
      "self.before.gold / -self.before.goldPerTurn <= short"
    ],
    "values": {
      "gold": "self.gold",
      "deficit": "-self.goldPerTurn",
      "turnsLeft": "Math.floor(self.gold / -self.goldPerTurn)"
    },
    "tier": "routine",
    "tags": ["economy", "domestic"]
  },
  {
    "id": "treasury-reserve-runs-short",
    "subject": "world",
    "when": [
      "Number.isFinite(self.gold) && self.gold >= 0",
      "Number.isFinite(self.goldPerTurn) && self.goldPerTurn < 0",
      "self.gold / -self.goldPerTurn <= short",
      "self.knows('before') && Number.isFinite(self.before.goldPerTurn) && self.before.goldPerTurn < 0"
    ],
    "values": {
      "gold": "self.gold",
      "deficit": "-self.goldPerTurn",
      "turnsLeft": "Math.floor(self.gold / -self.goldPerTurn)"
    },
    "tier": "turnsLeft <= recent ? 'major' : 'notable'",
    "tags": ["economy", "domestic"]
  },
  {
    "id": "treasury-returns-to-surplus",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('goldPerTurn') && Number.isFinite(self.goldPerTurn)",
      "self.before.knows('goldPerTurn') && Number.isFinite(self.before.goldPerTurn)",
      "crossed(self.goldPerTurn, self.before.goldPerTurn, 0)"
    ],
    "values": {
      "goldPerTurn": "self.goldPerTurn"
    },
    "tier": "routine",
    "tags": ["politics", "domestic"]
  }
]
