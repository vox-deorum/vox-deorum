[
  {
    "id": "city-capture-involving-us",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "event.get('coveredByDeal') === undefined",
      "event.get('city.name')",
      "(event.newOwner.self && event.get('oldOwner.name')) || (event.oldOwner.self && event.get('newOwner.name'))"
    ],
    "values": {
      "formerOwner": "event.get('oldOwner.name') ?? null",
      "captor": "event.get('newOwner.name') ?? null",
      "gained": "event.newOwner.self",
      "capital": "event.get('isCapital') ?? null",
      "conquest": "event.get('isConquest') ?? null"
    },
    "tier": "!gained || capital ? 'crisis' : 'major'",
    "adjust": "!gained && capital ? 5 : 0",
    "urgent": "event.get('oldOwner.self') && event.get('isConquest')",
    "tags": ["cities", "military"]
  },
  {
    "id": "city-flips",
    "subject": "event",
    "event": "CityFlipped",
    "when": [
      "event.oldOwner.self || event.newOwner.self",
      "event.get('city.name')"
    ],
    "values": {
      "formerOwner": "event.oldOwner.name",
      "newOwner": "event.newOwner.name",
      "gained": "event.newOwner.self"
    },
    "tier": "gained ? 'major' : 'crisis'",
    "tags": ["cities", "politics"]
  },
  {
    "id": "city-liberated",
    "subject": "event",
    "event": "PlayerLiberated",
    "when": [
      "event.player.self || event.liberatedPlayer.self"
    ],
    "values": {
      "liberator": "event.player.name",
      "liberated": "event.liberatedPlayer.name",
      "returned": "event.liberatedPlayer.self"
    },
    "tier": "returned ? 'major' : 'notable'",
    "adjust": "event.stake.place",
    "urgent": "returned",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "neighbor-puppet-annexed",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign && city.knows('name')",
      "city.get('owner.name')",
      "city.get('before.isPuppet')",
      "!city.isPuppet && city.isOccupied",
      "city.get('before.owner.id') == city.owner.id"
    ],
    "values": {
      "distance": "city.distance.own"
    },
    "tier": "notable",
    "adjust": "city.stake.place"
  },
  {
    "id": "city-puppet-annexed",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.knows('name') && city.own",
      "city.get('before.owner.id') == city.owner.id",
      "city.get('before.isPuppet')",
      "!city.isPuppet && city.isOccupied"
    ],
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "occupied-city-resists",
    "subject": "city",
    "when": [
      "city.knows('name') && city.own",
      "city.isOccupied",
      "city.resistanceTurns > 0"
    ],
    "values": {
      "turns": "city.resistanceTurns",
      "population": "city.get('population') ?? null",
      "formerOwner": "city.get('formerOwner.name') ?? null",
      "unrestPoints": "city.get('happinessDelta') ?? null"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(10, 2 * turns)"],
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-city-flips",
    "subject": "event",
    "event": "CityFlipped",
    "when": [
      "event.get('oldOwner.id') !== undefined && !event.oldOwner.self",
      "event.get('newOwner.id') !== undefined && !event.newOwner.self",
      "event.get('city.id') !== undefined && event.get('city.name') && event.get('city.foreign')",
      "!events.some(e => e.type === 'CityCaptureComplete' && e.turn === event.turn && e.get('city.name') && e.get('oldOwner.id') !== undefined && e.get('newOwner.id') !== undefined && e.oldOwner.id === event.oldOwner.id && e.newOwner.id === event.newOwner.id && e.get('isConquest') && e.knows('plot') && event.knows('plot') && e.plot.x === event.plot.x && e.plot.y === event.plot.y)"
    ],
    "values": {
      "newOwner": "event.newOwner.name",
      "oldOwner": "event.oldOwner.name"
    },
    "tier": "notable",
    "adjust": "event.city.stake.place",
    "tags": ["cities", "politics", "international"]
  },
  {
    "id": "foreign-city-liberated",
    "subject": "event",
    "event": "PlayerLiberated",
    "when": [
      "event.get('player.self') === false",
      "event.get('liberatedPlayer.self') === false"
    ],
    "values": {
      "owner": "event.player.name",
      "liberated": "event.liberatedPlayer.name"
    },
    "tier": "notable",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "foreign-occupied-city-resists",
    "subject": "city",
    "when": [
      "city.foreign && city.knows('name')",
      "city.get('owner.id') !== undefined && city.get('owner.name')",
      "city.isOccupied",
      "city.resistanceTurns > 0",
      "!(city.get('razingTurns') > 0)",
      "!city.events.some(e => e.type === 'CityFlipped' && e.get('oldOwner.name') && e.get('newOwner.name') && e.get('newOwner.id') === city.owner.id)",
      "!city.events.some(e => e.type === 'CityCaptureComplete' && e.get('oldOwner.name') && e.get('newOwner.id') === city.owner.id && e.get('city.name') && ((e.oldOwner.self && e.get('newOwner.name')) || (e.oldOwner.self === false && e.newOwner.self === false && e.get('isConquest'))))"
    ],
    "values": {
      "turns": "city.resistanceTurns"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(10, 2 * turns)"],
    "tags": ["cities", "international"]
  }
]
