[
  {
    "id": "city-capture-involving-us",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "!event.knows('coveredByDeal')",
      "event.knows('city') && event.city.knows('name')",
      "(event.newOwner.self === true && event.oldOwner.knows('name')) || (event.oldOwner.self === true && event.newOwner.knows('name'))"
    ],
    "values": {
      "formerOwner": "event.oldOwner.knows('name') ? event.oldOwner.name : null",
      "captor": "event.newOwner.knows('name') ? event.newOwner.name : null",
      "gained": "event.newOwner.self === true",
      "capital": "event.knows('isCapital') ? event.isCapital : null",
      "conquest": "event.knows('isConquest') ? event.isConquest : null"
    },
    "tier": "!gained || capital ? 'crisis' : 'major'",
    "adjust": "!gained && capital ? 5 : 0",
    "urgent": "event.knows('oldOwner') && event.oldOwner.self === true && event.knows('isConquest') && event.isConquest === true",
    "tags": ["cities", "military"]
  },
  {
    "id": "city-flips",
    "subject": "event",
    "event": "CityFlipped",
    "when": [
      "event.knows('oldOwner') && event.oldOwner.knows('name') && event.knows('newOwner') && event.newOwner.knows('name')",
      "event.oldOwner.self || event.newOwner.self",
      "event.knows('city') && event.city.knows('name')"
    ],
    "values": {
      "formerOwner": "event.oldOwner.name",
      "newOwner": "event.newOwner.name",
      "gained": "event.newOwner.self === true"
    },
    "tier": "gained ? 'major' : 'crisis'",
    "tags": ["cities", "politics"]
  },
  {
    "id": "city-liberated",
    "subject": "event",
    "event": "PlayerLiberated",
    "when": [
      "event.knows('player') && event.player.knows('name') && event.knows('liberatedPlayer') && event.liberatedPlayer.knows('name')",
      "event.player.self || event.liberatedPlayer.self"
    ],
    "values": {
      "liberator": "event.player.name",
      "liberated": "event.liberatedPlayer.name",
      "returned": "event.liberatedPlayer.self"
    },
    "tier": "returned ? 'major' : 'notable'",
    "adjust": "event.stake.place",
    "urgent": "returned",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "neighbor-puppet-annexed",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign && city.knows('name')",
      "city.knows('owner') && city.owner.knows('name')",
      "city.before.isPuppet",
      "!city.isPuppet && city.isOccupied",
      "city.before.owner.id == city.owner.id"
    ],
    "values": {
      "distance": "city.distance.own"
    },
    "tier": "notable",
    "adjust": "city.stake.place"
  },
  {
    "id": "city-puppet-annexed",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.knows('name') && city.knows('own') && city.own === true",
      "city.knows('owner') && city.owner.knows('id')",
      "city.knows('before') && city.before.knows('owner') && city.before.owner.knows('id') && city.before.owner.id == city.owner.id",
      "city.before.knows('isPuppet') && city.before.isPuppet === true",
      "city.knows('isPuppet') && city.isPuppet === false && city.knows('isOccupied') && city.isOccupied === true"
    ],
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "occupied-city-resists",
    "subject": "city",
    "when": [
      "city.knows('name') && city.knows('own') && city.own === true",
      "city.knows('isOccupied') && city.isOccupied === true",
      "city.knows('resistanceTurns') && Number.isFinite(city.resistanceTurns) && city.resistanceTurns > 0"
    ],
    "values": {
      "turns": "city.resistanceTurns",
      "population": "city.knows('population') && Number.isFinite(city.population) ? city.population : null",
      "formerOwner": "city.knows('formerOwner') && city.formerOwner.knows('name') ? city.formerOwner.name : null",
      "unrestPoints": "city.knows('happinessDelta') && Number.isFinite(city.happinessDelta) ? city.happinessDelta : null"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(10, 2 * turns)"],
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-city-flips",
    "subject": "event",
    "event": "CityFlipped",
    "when": [
      "event.knows('oldOwner') && event.oldOwner.knows('id') && event.oldOwner.knows('name') && event.oldOwner.self === false",
      "event.knows('newOwner') && event.newOwner.knows('id') && event.newOwner.knows('name') && event.newOwner.self === false",
      "event.knows('city') && event.city.knows('name') && event.city.knows('id') && event.city.foreign === true",
      "!events.some(e => e.type === 'CityCaptureComplete' && e.turn === event.turn && e.knows('city') && e.city.knows('name') && e.knows('oldOwner') && e.oldOwner.knows('id') && e.knows('newOwner') && e.newOwner.knows('id') && e.oldOwner.id === event.oldOwner.id && e.newOwner.id === event.newOwner.id && e.knows('isConquest') && e.isConquest === true && e.knows('plot') && event.knows('plot') && e.plot.x === event.plot.x && e.plot.y === event.plot.y)"
    ],
    "values": {
      "newOwner": "event.newOwner.name",
      "oldOwner": "event.oldOwner.name"
    },
    "tier": "notable",
    "adjust": "event.city.stake.place",
    "tags": ["cities", "politics", "international"]
  },
  {
    "id": "foreign-city-liberated",
    "subject": "event",
    "event": "PlayerLiberated",
    "when": [
      "event.knows('player') && event.player.knows('id') && event.player.knows('name') && event.player.self === false",
      "event.knows('liberatedPlayer') && event.liberatedPlayer.knows('name') && event.liberatedPlayer.self === false"
    ],
    "values": {
      "owner": "event.player.name",
      "liberated": "event.liberatedPlayer.name"
    },
    "tier": "notable",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "foreign-occupied-city-resists",
    "subject": "city",
    "when": [
      "city.foreign === true && city.knows('name')",
      "city.knows('owner') && city.owner.knows('id') && city.owner.knows('name')",
      "city.knows('isOccupied') && city.isOccupied === true",
      "city.knows('resistanceTurns') && Number.isFinite(city.resistanceTurns) && city.resistanceTurns > 0",
      "!(city.knows('razingTurns') && Number.isFinite(city.razingTurns) && city.razingTurns > 0)",
      "city.knows('events')",
      "!city.events.some(e => e.type === 'CityFlipped' && e.knows('oldOwner') && e.oldOwner.knows('name') && e.knows('newOwner') && e.newOwner.knows('name') && e.newOwner.knows('id') && e.newOwner.id === city.owner.id)",
      "!city.events.some(e => e.type === 'CityCaptureComplete' && e.knows('oldOwner') && e.oldOwner.knows('name') && e.knows('newOwner') && e.newOwner.knows('id') && e.newOwner.id === city.owner.id && e.knows('city') && e.city.knows('name') && ((e.oldOwner.self === true && e.newOwner.knows('name')) || (e.oldOwner.self === false && e.newOwner.self === false && e.knows('isConquest') && e.isConquest === true)))"
    ],
    "values": {
      "turns": "city.resistanceTurns"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(10, 2 * turns)"],
    "tags": ["cities", "international"]
  }
]
