[
  {
    "id": "building-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.knows('player') && event.player.knows('id') && event.player.self === true",
      "event.knows('city') && event.city.knows('name') && event.city.knows('owner') && event.city.owner.knows('id') && event.city.own === true",
      "event.player.id === event.city.owner.id",
      "event.knows('building') && !defenses.includes(event.building)",
      "event.city.knows('importantBuildings') && Array.isArray(event.city.importantBuildings)",
      "event.city.importantBuildings.includes(event.building)",
      "event.knows('isGoldPurchase') && event.isGoldPurchase === false && event.knows('isFaithPurchase') && event.isFaithPurchase === false",
      "!events.some(e => (e.type === 'PlayerCityFounded' || e.type === 'UnitCityFounded') && e.turn === event.turn && e.knows('plot') && event.knows('plot') && e.plot.x === event.plot.x && e.plot.y === event.plot.y)"
    ],
    "values": {
      "building": "event.building",
      "cityName": "event.city.name"
    },
    "tier": "filler",
    "adjust": "event.stake.building",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "building-investment-made",
    "subject": "event",
    "event": "CityInvestedBuilding",
    "when": [
      "event.knows('player') && event.player.knows('id') && event.player.self === true",
      "event.knows('city') && event.city.knows('name') && event.city.knows('owner') && event.city.owner.knows('id') && event.city.own === true",
      "event.player.id === event.city.owner.id",
      "event.knows('building')",
      "event.knows('invested') && (event.invested === true || event.invested === 1)",
      "!events.some(e => e.type === 'CityConstructed' && e.knows('player') && e.player.knows('id') && e.player.id === event.player.id && e.knows('building') && e.building === event.building && e.knows('city') && e.city.knows('id') && event.city.knows('id') && e.city.id === event.city.id && e.knows('isGoldPurchase') && e.isGoldPurchase === false && e.knows('isFaithPurchase') && e.isFaithPurchase === false)"
    ],
    "values": {
      "building": "event.building",
      "cityName": "event.city.name"
    },
    "tier": "filler",
    "adjust": "event.stake.building",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "building-purchased",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.knows('player') && event.player.knows('id') && event.player.self === true",
      "event.knows('city') && event.city.knows('name') && event.city.knows('owner') && event.city.owner.knows('id') && event.city.own === true",
      "event.player.id === event.city.owner.id",
      "event.knows('building') && !defenses.includes(event.building)",
      "event.city.knows('importantBuildings') && Array.isArray(event.city.importantBuildings)",
      "event.city.importantBuildings.includes(event.building)",
      "(event.knows('isGoldPurchase') && event.isGoldPurchase === true) || (event.knows('isFaithPurchase') && event.isFaithPurchase === true)"
    ],
    "values": {
      "building": "event.building",
      "cityName": "event.city.name",
      "currency": "event.knows('isGoldPurchase') && event.isGoldPurchase === true ? 'gold' : 'faith'"
    },
    "tier": "filler",
    "adjust": "event.stake.building",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "capital-outgrown",
    "subject": "world",
    "when": [
      "self.knows('capital') && Number.isFinite(self.capital.population)",
      "self.cities.some(c => c.knows('population') && c.population > self.capital.population)"
    ],
    "values": {
      "largestPopulation": "Math.max(...self.cities.filter(c => c.knows('population') && Number.isFinite(c.population)).map(c => c.population))",
      "largest": "(() => { const names = self.cities.filter(c => c.knows('population') && c.population === largestPopulation).map(c => c.name); return names.length <= 2 ? names.join(' and ') : names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1]; })()",
      "tied": "self.cities.filter(c => c.knows('population') && c.population === largestPopulation).length > 1",
      "capital": "self.capital.name"
    },
    "tier": "routine"
  },
  {
    "id": "cities-share-grievance",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('unhappiness')",
      "city.unhappiness.top !== null"
    ],
    "group": {
      "by": "city.unhappiness.top",
      "min": 3
    },
    "tier": "notable",
    "adjust": "10 * (count - 3)",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-being-razed",
    "subject": "city",
    "when": [
      "city.knows('name') && city.knows('razingTurns') && city.razingTurns > 0 && city.knows('foreign') && city.foreign",
      "city.knows('owner') && city.owner.knows('name')"
    ],
    "values": {
      "cityName": "city.name",
      "civilization": "city.owner.name",
      "population": "city.knows('population') ? city.population : null",
      "turns": "city.razingTurns",
      "distance": "city.knows('distance') && city.distance.knows('own') ? city.distance.own : null"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "military", "international"]
  },
  {
    "id": "city-capture-involving-us",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "event.knows('city') && event.city.knows('name')",
      "event.knows('oldOwner') && event.knows('newOwner')",
      "(event.newOwner.self === true && event.oldOwner.knows('name')) || (event.oldOwner.self === true && event.newOwner.knows('name'))"
    ],
    "values": {
      "cityName": "event.city.name",
      "formerOwner": "event.oldOwner.knows('name') ? event.oldOwner.name : null",
      "captor": "event.newOwner.knows('name') ? event.newOwner.name : null",
      "gained": "event.newOwner.self === true",
      "capital": "event.knows('isCapital') ? event.isCapital : null",
      "conquest": "event.knows('isConquest') ? event.isConquest : null"
    },
    "tier": "!gained || capital ? 'crisis' : 'major'",
    "adjust": "!gained && capital ? 5 : 0",
    "urgent": "event.knows('oldOwner') && event.oldOwner.self === true && event.knows('isConquest') && event.isConquest === true",
    "tags": ["cities", "military"]
  },
  {
    "id": "city-defense-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.knows('building') && defenses.includes(event.building)",
      "event.knows('player') && event.player.self === true",
      "event.knows('city') && event.city.knows('name') && event.city.own === true"
    ],
    "values": {
      "building": "event.building",
      "cityName": "event.city.name"
    },
    "tier": "routine",
    "adjust": "event.stake.building",
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "city-famine-unrest",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('unhappiness')",
      "city.unhappiness.top === 'famine'"
    ],
    "values": {
      "faminePopulation": "city.unhappiness.famine"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-flips",
    "subject": "event",
    "event": "CityFlipped",
    "when": [
      "event.knows('oldOwner') && event.oldOwner.knows('name') && event.knows('newOwner') && event.newOwner.knows('name')",
      "event.oldOwner.self || event.newOwner.self",
      "event.knows('city') && event.city.knows('name')"
    ],
    "values": {
      "cityName": "event.city.name",
      "formerOwner": "event.oldOwner.name",
      "newOwner": "event.newOwner.name",
      "gained": "event.newOwner.self === true"
    },
    "tier": "gained ? 'major' : 'crisis'",
    "tags": ["cities", "politics"]
  },
  {
    "id": "city-growth-milestone",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.knows('population') && city.population >= largeCity && city.knows('own') && city.own",
      "city.knows('before') && city.before.knows('population') && Number.isFinite(city.before.population)",
      "city.before.knows('owner') && city.before.owner.self",
      "crossed(city.population, city.before.population, largeCity) || crossed(city.population, city.before.population, metropolis)"
    ],
    "values": {
      "milestone": "crossed(city.population, city.before.population, metropolis) ? 'metropolis' : 'large city'",
      "population": "city.population",
      "cityName": "city.name"
    },
    "tier": "milestone === 'metropolis' ? 'notable' : 'routine'",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-liberated",
    "subject": "event",
    "event": "PlayerLiberated",
    "when": [
      "event.knows('player') && event.player.knows('name') && event.knows('liberatedPlayer') && event.liberatedPlayer.knows('name')",
      "event.player.self || event.liberatedPlayer.self"
    ],
    "values": {
      "liberator": "event.player.name",
      "liberated": "event.liberatedPlayer.name",
      "returned": "event.liberatedPlayer.self"
    },
    "tier": "returned ? 'crisis' : 'major'",
    "urgent": "returned",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "city-pillaged-unrest",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('unhappiness')",
      "city.unhappiness.top === 'pillaged'"
    ],
    "values": {
      "pillagedPopulation": "city.unhappiness.pillaged"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-under-siege",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.is.besieged",
      "city.knows('hitPoints') && Number.isFinite(city.hitPoints)",
      "city.knows('maxHitPoints') && Number.isFinite(city.maxHitPoints) && city.maxHitPoints > 0",
      "(city.maxHitPoints - city.hitPoints) / city.maxHitPoints >= 0.25"
    ],
    "values": {
      "cityName": "city.name",
      "damage": "(city.maxHitPoints - city.hitPoints) / city.maxHitPoints",
      "wallStrength": "city.hitPoints",
      "maxWallStrength": "city.maxHitPoints"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "50 * (damage - 0.25)"],
    "urgent": "damage >= 0.5",
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "distant-colony-founded",
    "subject": "event",
    "event": "PlayerCityFounded",
    "when": [
      "event.knows('player') && event.player.self === true",
      "event.knows('city') && event.city.knows('name')",
      "event.city.knows('distance') && event.city.distance.knows('capital')",
      "event.city.distance.capital >= nearby"
    ],
    "values": {
      "cityName": "event.city.name",
      "distance": "event.city.distance.capital"
    },
    "tier": "notable",
    "adjust": "Math.min(20, distance - nearby)",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-building-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.knows('player') && event.player.knows('id') && event.player.self === false",
      "event.knows('city') && event.city.knows('name') && event.city.knows('owner') && event.city.owner.knows('id') && event.city.owner.knows('name') && event.city.foreign === true",
      "event.player.id === event.city.owner.id",
      "event.city.is.nearby",
      "event.knows('building') && !defenses.includes(event.building)",
      "event.city.knows('importantBuildings') && Array.isArray(event.city.importantBuildings)",
      "event.city.importantBuildings.includes(event.building)",
      "event.knows('isGoldPurchase') && event.isGoldPurchase === false && event.knows('isFaithPurchase') && event.isFaithPurchase === false",
      "!events.some(e => (e.type === 'PlayerCityFounded' || e.type === 'UnitCityFounded') && e.turn === event.turn && e.knows('plot') && event.knows('plot') && e.plot.x === event.plot.x && e.plot.y === event.plot.y)"
    ],
    "values": {
      "building": "event.building",
      "cityName": "event.city.name",
      "civilization": "event.city.owner.name"
    },
    "tier": "filler",
    "adjust": "event.stake.place",
    "tags": ["cities", "international"]
  },
  {
    "id": "foreign-building-purchased",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.knows('player') && event.player.knows('id') && event.player.self === false",
      "event.knows('city') && event.city.knows('name') && event.city.knows('owner') && event.city.owner.knows('id') && event.city.owner.knows('name') && event.city.foreign === true",
      "event.player.id === event.city.owner.id",
      "event.city.is.nearby",
      "event.knows('building') && !defenses.includes(event.building)",
      "event.city.knows('importantBuildings') && Array.isArray(event.city.importantBuildings)",
      "event.city.importantBuildings.includes(event.building)",
      "(event.knows('isGoldPurchase') && event.isGoldPurchase === true) || (event.knows('isFaithPurchase') && event.isFaithPurchase === true)"
    ],
    "values": {
      "building": "event.building",
      "cityName": "event.city.name",
      "civilization": "event.city.owner.name",
      "currency": "event.knows('isGoldPurchase') && event.isGoldPurchase === true ? 'gold' : 'faith'"
    },
    "tier": "filler",
    "adjust": "event.stake.place",
    "tags": ["cities", "international"]
  },
  {
    "id": "forward-settle",
    "subject": "event",
    "event": "PlayerCityFounded",
    "when": [
      "event.knows('player') && event.player.is.rival && event.player.knows('name')",
      "event.knows('city') && event.city.knows('name') && event.city.knows('nearestOwn') && event.city.nearestOwn.knows('name')",
      "event.distance.own <= adjacent"
    ],
    "values": {
      "ours": "event.city.nearestOwn.name",
      "distance": "event.distance.own"
    },
    "tier": "notable",
    "adjust": "5 * (adjacent - distance)",
    "urgent": "distance <= 2"
  },
  {
    "id": "neighbor-puppet-annexed",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.is.neighbor",
      "city.before.isPuppet",
      "!city.isPuppet && city.isOccupied",
      "city.before.owner.id == city.owner.id"
    ],
    "values": {
      "distance": "city.distance.own"
    },
    "tier": "notable",
    "adjust": "city.stake.place"
  },
  {
    "id": "occupied-city-resists",
    "subject": "city",
    "when": [
      "city.knows('name') && city.knows('own') && city.own === true",
      "city.knows('isOccupied') && city.isOccupied === true",
      "city.knows('resistanceTurns') && Number.isFinite(city.resistanceTurns) && city.resistanceTurns > 0"
    ],
    "values": {
      "cityName": "city.name",
      "turns": "city.resistanceTurns",
      "population": "city.knows('population') && Number.isFinite(city.population) ? city.population : null",
      "formerOwner": "city.knows('formerOwner') && city.formerOwner.knows('name') ? city.formerOwner.name : null",
      "unrestPoints": "city.knows('happinessDelta') && Number.isFinite(city.happinessDelta) ? city.happinessDelta : null"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(10, 2 * turns)"],
    "tags": ["cities", "domestic"]
  },
  {
    "id": "our-city-founded",
    "subject": "event",
    "event": ["PlayerCityFounded", "UnitCityFounded"],
    "when": [
      "event.knows('player') && event.player.self === true && event.knows('city') && event.city.knows('name')",
      "event.type === 'PlayerCityFounded' || !event.knows('plot') || !events.some(e => e.type === 'PlayerCityFounded' && e.turn === event.turn && e.knows('player') && e.player.self && e.knows('plot') && e.plot.x === event.plot.x && e.plot.y === event.plot.y)"
    ],
    "values": {
      "cityName": "event.city.name"
    },
    "tier": "routine",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "settler-departure",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own",
      "city.population < city.before.population",
      "city.trained.some(t => settlers.includes(t.unit))",
      "city.foodPerTurn > 0"
    ],
    "values": {
      "lost": "city.before.population - city.population"
    },
    "tier": "routine",
    "adjust": "10 * lost"
  },
  {
    "id": "starvation-without-siege",
    "subject": "city",
    "when": [
      "city.own",
      "self.knows('atWar') && self.atWar === false",
      "city.knows('unhappiness') && city.unhappiness.knows('top') && city.unhappiness.top !== 'famine'",
      "city.knows('foodPerTurn') && Number.isFinite(city.foodPerTurn) && city.foodPerTurn < 0",
      "city.knows('foodStored') && Number.isFinite(city.foodStored)",
      "city.is.starving"
    ],
    "values": {
      "foodPerTurn": "city.foodPerTurn",
      "foodStored": "city.foodStored",
      "shortfall": "-city.foodPerTurn"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(20, 5 * shortfall)"],
    "tags": ["cities", "domestic"]
  },
  {
    "id": "we-raze-a-city",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('name')",
      "city.knows('razingTurns') && Number.isFinite(city.razingTurns) && city.razingTurns > 0"
    ],
    "values": {
      "cityName": "city.name",
      "population": "city.knows('population') ? city.population : null",
      "turns": "city.razingTurns"
    },
    "tier": "major",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  }
]
