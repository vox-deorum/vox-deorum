[
  {
    "id": "neighbor-puppet-annexed",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.is.neighbor",
      "city.before.isPuppet",
      "!city.isPuppet && city.isOccupied",
      "city.before.owner.id == city.owner.id"
    ],
    "values": {
      "distance": "city.distance.own"
    },
    "importance": "70 - 3 * distance"
  },
  {
    "id": "settler-departure",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own",
      "city.population < city.before.population",
      "city.trained.some(t => settlers.includes(t.unit))",
      "city.foodPerTurn > 0"
    ],
    "values": {
      "lost": "city.before.population - city.population"
    },
    "importance": "30 + 10 * lost"
  }
]
