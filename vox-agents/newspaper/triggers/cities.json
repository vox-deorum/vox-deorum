[
  {
    "id": "neighbor-puppet-annexed",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.is.neighbor",
      "city.before.isPuppet",
      "!city.isPuppet && city.isOccupied",
      "city.before.owner.id == city.owner.id"
    ],
    "values": {
      "distance": "city.distance.own"
    },
    "importance": "70 - 3 * distance"
  },
  {
    "id": "settler-departure",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own",
      "city.population < city.before.population",
      "city.trained.some(t => settlers.includes(t.unit))",
      "city.foodPerTurn > 0"
    ],
    "values": {
      "lost": "city.before.population - city.population"
    },
    "importance": "30 + 10 * lost"
  },
  {
    "id": "forward-settle",
    "subject": "event",
    "event": "PlayerCityFounded",
    "when": [
      "event.player.is.rival",
      "event.distance.own <= adjacent"
    ],
    "values": {
      "ours": "event.knows('city') && event.city.knows('nearestOwn') && event.city.nearestOwn.knows('name') ? event.city.nearestOwn.name : null",
      "distance": "event.distance.own"
    },
    "importance": "90 - 10 * distance",
    "urgent": "distance <= 2"
  },
  {
    "id": "cities-share-grievance",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('unhappiness')",
      "city.unhappiness.top !== null"
    ],
    "group": {
      "by": "city.unhappiness.top",
      "min": 3
    },
    "importance": "40 + 10 * count",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-pillaged-unrest",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('unhappiness')",
      "city.unhappiness.top === 'pillaged'"
    ],
    "values": {
      "pillaged": "city.unhappiness.pillaged"
    },
    "importance": 60,
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-famine-unrest",
    "subject": "city",
    "when": [
      "city.own",
      "city.knows('unhappiness')",
      "city.unhappiness.top === 'famine'"
    ],
    "values": {
      "famine": "city.unhappiness.famine"
    },
    "importance": 60,
    "tags": ["cities", "domestic"]
  },
  {
    "id": "our-city-founded",
    "subject": "event",
    "event": ["PlayerCityFounded", "UnitCityFounded"],
    "when": [
      "event.knows('player') && event.player.self === true",
      "event.type === 'PlayerCityFounded' || !event.knows('plot') || !events.some(e => e.type === 'PlayerCityFounded' && e.turn === event.turn && e.knows('player') && e.player.self && e.knows('plot') && e.plot.x === event.plot.x && e.plot.y === event.plot.y)"
    ],
    "values": {
      "cityName": "event.knows('city') && event.city.knows('name') ? event.city.name : null"
    },
    "importance": 50,
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-capture-involving-us",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "(event.knows('oldOwner') && event.oldOwner.self === true) || (event.knows('newOwner') && event.newOwner.self === true)"
    ],
    "values": {
      "cityName": "event.knows('city') && event.city.knows('name') ? event.city.name : null",
      "formerOwner": "event.knows('oldOwner') && event.oldOwner.knows('name') ? event.oldOwner.name : null",
      "captor": "event.knows('newOwner') && event.newOwner.knows('name') ? event.newOwner.name : null",
      "gained": "event.knows('newOwner') && event.newOwner.self === true",
      "capital": "event.knows('isCapital') ? event.isCapital : null",
      "conquest": "event.knows('isConquest') ? event.isConquest : null"
    },
    "importance": "gained ? (capital ? 90 : 78) : (capital ? 98 : 92)",
    "urgent": "event.knows('oldOwner') && event.oldOwner.self === true && event.knows('isConquest') && event.isConquest === true",
    "tags": ["cities", "military"]
  },
  {
    "id": "starvation-without-siege",
    "subject": "city",
    "when": [
      "city.own",
      "self.knows('atWar') && self.atWar === false",
      "city.knows('unhappiness') && city.unhappiness.knows('top') && city.unhappiness.top !== 'famine'",
      "city.knows('foodPerTurn') && Number.isFinite(city.foodPerTurn) && city.foodPerTurn < 0",
      "city.knows('foodStored') && Number.isFinite(city.foodStored)",
      "city.is.starving"
    ],
    "values": {
      "foodPerTurn": "city.foodPerTurn",
      "foodStored": "city.foodStored",
      "shortfall": "-city.foodPerTurn"
    },
    "importance": "50 + Math.min(30, 10 * shortfall)",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "capital-outgrown",
    "subject": "world",
    "when": [
      "self.knows('capital') && Number.isFinite(self.capital.population)",
      "self.cities.some(c => c.knows('population') && c.population > self.capital.population)"
    ],
    "values": {
      "largestPopulation": "Math.max(...self.cities.filter(c => c.knows('population') && Number.isFinite(c.population)).map(c => c.population))",
      "largest": "(() => { const names = self.cities.filter(c => c.knows('population') && c.population === largestPopulation).map(c => c.name); return names.length <= 2 ? names.join(' and ') : names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1]; })()",
      "tied": "self.cities.filter(c => c.knows('population') && c.population === largestPopulation).length > 1",
      "capital": "self.capital.name"
    },
    "importance": 45
  }
]
