[
  {
    "id": "gold-trade-deal",
    "subject": "event",
    "event": "DealMade",
    "when": [
      "event.knows('fromPlayer') && event.knows('toPlayer') && (event.fromPlayer.self || event.toPlayer.self)",
      "event.knows('fromGives') && Array.isArray(event.fromGives) && event.fromGives.length > 0",
      "event.knows('toGives') && Array.isArray(event.toGives) && event.toGives.length > 0",
      "event.knows('tradedItems') && Array.isArray(event.tradedItems)",
      "event.tradedItems.some(item => item.knows('itemType') && (item.itemType === 'Gold' || item.itemType === 'GoldPerTurn'))",
      "!event.tradedItems.some(item => item.knows('itemType') && item.itemType === 'PeaceTreaty')"
    ],
    "values": {
      "partner": "(() => { const p = event.fromPlayer.self ? event.toPlayer : event.fromPlayer; return p.knows('name') ? p.name : null; })()",
      "weGive": "(event.fromPlayer.self ? event.fromGives : event.toGives).join(', ')",
      "weGet": "(event.fromPlayer.self ? event.toGives : event.fromGives).join(', ')"
    },
    "importance": 60,
    "tags": ["economy", "trade", "international"]
  },
  {
    "id": "incoming-trade-route-plundered",
    "subject": "event",
    "event": "PlayerPlunderedTradeRoute",
    "when": [
      "event.knows('destinationOwner') && event.destinationOwner.self === true",
      "event.knows('originOwner') && event.originOwner.self === false",
      "event.knows('plunderingPlayerId') && event.plunderingPlayerId !== self.id"
    ],
    "values": {
      "origin": "event.originOwner.knows('name') ? event.originOwner.name : null",
      "plunderer": "event.knows('plunderingPlayer') && event.plunderingPlayer.knows('name') ? event.plunderingPlayer.name : null",
      "gold": "event.knows('plunderGoldValue') && Number.isFinite(event.plunderGoldValue) ? event.plunderGoldValue : null"
    },
    "importance": 55,
    "tags": ["economy", "trade"]
  },
  {
    "id": "last-trade-route-ends",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('outgoingTradeRouteCount')",
      "self.knows('before') && self.before.knows('outgoingTradeRouteCount')",
      "self.before.outgoingTradeRouteCount > 0",
      "self.outgoingTradeRouteCount === 0"
    ],
    "values": {
      "routes": "self.before.outgoingTradeRouteCount"
    },
    "importance": "55 + 5 * routes",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "long-trade-route-completed",
    "subject": "event",
    "event": "PlayerTradeRouteCompleted",
    "when": [
      "event.knows('originPlayer') && event.knows('destinationPlayer')",
      "(event.originPlayer.self === true) !== (event.destinationPlayer.self === true)",
      "event.knows('originCity') && event.knows('destinationCity')",
      "event.originCity.knows('name') && event.destinationCity.knows('name')",
      "distance(event.originCity, event.destinationCity) >= regional"
    ],
    "values": {
      "partner": "(() => { const other = event.originPlayer.self === true ? event.destinationPlayer : event.originPlayer; return other.knows('name') ? other.name : null; })()",
      "ourCity": "event.originPlayer.self === true ? event.originCity.name : event.destinationCity.name",
      "theirCity": "event.originPlayer.self === true ? event.destinationCity.name : event.originCity.name",
      "routeDistance": "distance(event.originCity, event.destinationCity)",
      "outgoing": "event.originPlayer.self === true"
    },
    "importance": "outgoing ? 50 : 45",
    "tags": ["economy", "trade", "international"]
  },
  {
    "id": "our-trade-route-plundered",
    "subject": "event",
    "event": "PlayerPlunderedTradeRoute",
    "when": [
      "event.knows('originOwner') && event.originOwner.self === true",
      "event.knows('plunderingPlayerId') && event.plunderingPlayerId !== self.id"
    ],
    "values": {
      "plunderer": "event.knows('plunderingPlayer') && event.plunderingPlayer.knows('name') ? event.plunderingPlayer.name : null",
      "gold": "event.knows('plunderGoldValue') && Number.isFinite(event.plunderGoldValue) ? event.plunderGoldValue : null",
      "destination": "event.knows('destinationOwner') && event.destinationOwner.knows('name') ? event.destinationOwner.name : null"
    },
    "importance": 70,
    "tags": ["economy", "trade"]
  },
  {
    "id": "trade-network-opens",
    "subject": "world",
    "when": [
      "self.knows('before')",
      "self.knows('outgoingTradeRouteCount')",
      "(self.before.knows('outgoingTradeRouteCount') && self.before.outgoingTradeRouteCount === 0) || (self.before.knows('outgoingTradeRoutes') && Array.isArray(self.before.outgoingTradeRoutes) && self.before.outgoingTradeRoutes.length === 0)",
      "self.outgoingTradeRouteCount > 0"
    ],
    "values": {
      "routes": "self.outgoingTradeRouteCount"
    },
    "importance": 55,
    "tags": ["economy", "trade"]
  },
  {
    "id": "we-plunder-foreign-trade-route",
    "subject": "event",
    "event": "PlayerPlunderedTradeRoute",
    "when": [
      "event.knows('plunderingPlayerId') && event.plunderingPlayerId === self.id",
      "event.knows('originOwner') && event.originOwner.self === false"
    ],
    "values": {
      "origin": "event.originOwner.knows('name') ? event.originOwner.name : null",
      "gold": "event.knows('plunderGoldValue') && Number.isFinite(event.plunderGoldValue) ? event.plunderGoldValue : null",
      "destination": "event.knows('destinationOwner') && event.destinationOwner.knows('name') ? event.destinationOwner.name : null"
    },
    "importance": 55,
    "tags": ["economy", "trade"]
  }
]
