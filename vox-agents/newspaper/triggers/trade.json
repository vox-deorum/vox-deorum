[
  {
    "id": "trade-deal",
    "summary": "We completed a deal in which both sides gave goods or gold.",
    "subject": "event",
    "event": "DealMade",
    "when": [
      "event.deal.kind === 'trade-deal'",
      "event.is.dealPartnerNamed"
    ],
    "values": {
      "partner": "event.fromPlayer.self ? event.toPlayer.name : event.fromPlayer.name",
      "weGive": "event.deal.weGive",
      "weGet": "event.deal.weGet"
    },
    "tier": "notable",
    "adjust": "event.fromPlayer.self ? event.toPlayer.stake.relation : event.fromPlayer.stake.relation",
    "tags": ["economy", "trade", "international"]
  },
  {
    "id": "trade-gift",
    "summary": "We gave or received goods or gold in a deal with no terms from the other side.",
    "subject": "event",
    "event": "DealMade",
    "when": [
      "event.deal.kind === 'trade-gift'",
      "event.is.dealPartnerNamed"
    ],
    "values": {
      "partner": "event.fromPlayer.self ? event.toPlayer.name : event.fromPlayer.name",
      "weGive": "event.deal.weGive",
      "weGet": "event.deal.weGet"
    },
    "tier": "notable",
    "adjust": "event.fromPlayer.self ? event.toPlayer.stake.relation : event.fromPlayer.stake.relation",
    "tags": ["economy", "trade", "international"]
  },
  {
    "id": "incoming-trade-route-plundered",
    "subject": "event",
    "event": "PlayerPlunderedTradeRoute",
    "when": [
      "event.destinationOwner.self === true",
      "event.originOwner.self === false && event.originOwner.knows('name')",
      "event.plunderingPlayerId !== self.id",
      "event.plunderingPlayer.knows('name')"
    ],
    "values": {
      "originCity": "event.knows('originCity') && event.originCity.knows('name') ? event.originCity.name : null",
      "originCiv": "event.originOwner.name",
      "destinationCity": "event.knows('destinationCity') && event.destinationCity.knows('name') ? event.destinationCity.name : null",
      "destinationCiv": "event.destinationOwner.knows('name') ? event.destinationOwner.name : null",
      "plunderer": "event.plunderingPlayer.name",
      "gold": "event.knows('plunderGoldValue') && Number.isFinite(event.plunderGoldValue) ? event.plunderGoldValue : null"
    },
    "tier": "notable",
    "adjust": "event.originOwner.stake.relation",
    "tags": ["economy", "trade"]
  },
  {
    "id": "last-trade-route-ends",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('outgoingTradeRouteCount')",
      "self.knows('before') && self.before.knows('outgoingTradeRouteCount')",
      "self.before.outgoingTradeRouteCount > 0",
      "self.outgoingTradeRouteCount === 0"
    ],
    "values": {
      "routes": "self.before.outgoingTradeRouteCount"
    },
    "tier": "notable",
    "adjust": "Math.min(15, 5 * (routes - 1))",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "long-trade-route-completed",
    "subject": "event",
    "event": "PlayerTradeRouteCompleted",
    "when": [
      "(event.originPlayer.self === true) !== (event.destinationPlayer.self === true)",
      "event.originCity.knows('name') && event.destinationCity.knows('name')",
      "distance(event.originCity, event.destinationCity) >= regional"
    ],
    "values": {
      "originCity": "event.originCity.name",
      "originCiv": "event.originPlayer.knows('name') ? event.originPlayer.name : null",
      "destinationCity": "event.destinationCity.name",
      "destinationCiv": "event.destinationPlayer.knows('name') ? event.destinationPlayer.name : null",
      "routeDistance": "distance(event.originCity, event.destinationCity)",
      "outgoing": "event.originPlayer.self === true"
    },
    "tier": "routine",
    "tags": ["economy", "trade", "international"]
  },
  {
    "id": "our-trade-route-plundered",
    "subject": "event",
    "event": "PlayerPlunderedTradeRoute",
    "when": [
      "event.originOwner.self === true",
      "event.plunderingPlayerId !== self.id",
      "event.plunderingPlayer.knows('name')",
      "event.destinationOwner.knows('name')"
    ],
    "values": {
      "originCity": "event.knows('originCity') && event.originCity.knows('name') ? event.originCity.name : null",
      "originCiv": "event.originOwner.knows('name') ? event.originOwner.name : null",
      "destinationCity": "event.knows('destinationCity') && event.destinationCity.knows('name') ? event.destinationCity.name : null",
      "destinationCiv": "event.destinationOwner.name",
      "plunderer": "event.plunderingPlayer.name",
      "gold": "event.knows('plunderGoldValue') && Number.isFinite(event.plunderGoldValue) ? event.plunderGoldValue : null"
    },
    "tier": "major",
    "adjust": "event.plunderingPlayer.stake.relation",
    "tags": ["economy", "trade"]
  },
  {
    "id": "trade-network-opens",
    "subject": "world",
    "when": [
      "self.knows('before')",
      "self.knows('outgoingTradeRouteCount')",
      "(self.before.knows('outgoingTradeRouteCount') && self.before.outgoingTradeRouteCount === 0) || (self.before.knows('outgoingTradeRoutes') && Array.isArray(self.before.outgoingTradeRoutes) && self.before.outgoingTradeRoutes.length === 0)",
      "self.outgoingTradeRouteCount > 0"
    ],
    "values": {
      "routes": "self.outgoingTradeRouteCount"
    },
    "tier": "notable",
    "tags": ["economy", "trade"]
  },
  {
    "id": "we-plunder-foreign-trade-route",
    "subject": "event",
    "event": "PlayerPlunderedTradeRoute",
    "when": [
      "event.plunderingPlayerId === self.id",
      "event.originOwner.self === false && event.originOwner.knows('name')"
    ],
    "values": {
      "originCity": "event.knows('originCity') && event.originCity.knows('name') ? event.originCity.name : null",
      "originCiv": "event.originOwner.name",
      "destinationCity": "event.knows('destinationCity') && event.destinationCity.knows('name') ? event.destinationCity.name : null",
      "destinationCiv": "event.knows('destinationOwner') && event.destinationOwner.knows('name') ? event.destinationOwner.name : null",
      "gold": "event.knows('plunderGoldValue') && Number.isFinite(event.plunderGoldValue) ? event.plunderGoldValue : null"
    },
    "tier": "notable",
    "adjust": "event.originOwner.stake.relation",
    "tags": ["economy", "trade"]
  }
]
