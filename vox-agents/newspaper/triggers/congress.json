[
  {
    "id": "congress-new-proposals",
    "subject": "world",
    "when": [
      "game.knows('congress')",
      "game.congress.available === true",
      "game.congress.knows('newProposals')",
      "game.congress.newProposals.length > 0"
    ],
    "values": {
      "count": "game.congress.newProposals.length",
      "proposal": "game.congress.newProposals[0].name",
      "ours": "self.knows('name') && game.congress.newProposals.some(p => p.knows('proposer') && p.proposer === self.name)"
    },
    "tier": "ours ? 'notable' : 'routine'",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-resolution-defeated",
    "subject": "event",
    "event": "ResolutionResult",
    "when": [
      "event.passed === false",
      "event.knows('resolutionType') && typeof event.resolutionType === 'string' && event.resolutionType.trim().length > 0",
      "event.knows('isEnact') && typeof event.isEnact === 'boolean'"
    ],
    "values": {
      "resolution": "event.resolutionType",
      "isEnact": "event.isEnact",
      "proposer": "event.knows('proposerName') ? event.proposerName : null",
      "ours": "event.knows('player') && event.player.self === true"
    },
    "tier": "ours ? 'notable' : 'routine'",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-resolution-passed",
    "subject": "event",
    "event": "ResolutionResult",
    "when": [
      "event.passed === true",
      "event.knows('resolutionType') && typeof event.resolutionType === 'string' && event.resolutionType.trim().length > 0",
      "event.knows('isEnact') && typeof event.isEnact === 'boolean'"
    ],
    "values": {
      "resolution": "event.resolutionType",
      "isEnact": "event.isEnact",
      "proposer": "event.knows('proposerName') ? event.proposerName : null",
      "ours": "event.knows('player') && event.player.self === true"
    },
    "tier": "ours ? 'major' : 'notable'",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-sanctions-on-us",
    "subject": "world",
    "when": [
      "game.knows('congress')",
      "game.congress.available === true",
      "game.congress.knows('activeResolutions')",
      "self.knows('name')",
      "game.congress.activeResolutions.some(r => r.name.startsWith('Sanction') && r.name.includes(self.name))"
    ],
    "values": {
      "resolution": "game.congress.activeResolutions.find(r => r.name.startsWith('Sanction') && r.name.includes(self.name)).name"
    },
    "tier": "crisis",
    "urgent": "true",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-session-approaching",
    "subject": "world",
    "when": [
      "game.knows('congress')",
      "game.congress.available === true",
      "game.congress.knows('expectedSessionTurn')",
      "Number.isFinite(game.congress.expectedSessionTurn)",
      "game.congress.expectedSessionTurn <= turn + recent",
      "game.congress.expectedSessionTurn !== turn + 1",
      "!game.congress.votingNow"
    ],
    "values": {
      "league": "game.congress.knows('league') ? game.congress.league : null",
      "turnsUntil": "game.congress.expectedSessionTurn - turn",
      "count": "game.congress.knows('proposals') ? game.congress.proposals.length : 0"
    },
    "tier": "routine",
    "adjust": "Math.round(10 * (recent - turnsUntil) / recent)",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-session-imminent",
    "subject": "world",
    "when": [
      "game.knows('congress')",
      "game.congress.available === true",
      "game.congress.knows('expectedSessionTurn')",
      "game.congress.expectedSessionTurn === turn + 1"
    ],
    "values": {
      "league": "game.congress.knows('league') ? game.congress.league : null",
      "count": "game.congress.knows('proposals') ? game.congress.proposals.length : 0"
    },
    "tier": "notable",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-votes-changed",
    "subject": "world",
    "window": "recent",
    "when": [
      "game.knows('congress')",
      "game.congress.available === true",
      "self.knows('votes') && Number.isFinite(self.votes)",
      "self.knows('before') && self.before.knows('votes') && Number.isFinite(self.before.votes)",
      "self.votes !== self.before.votes"
    ],
    "values": {
      "votes": "self.votes",
      "previous": "self.before.votes",
      "change": "self.votes - self.before.votes"
    },
    "tier": "Math.abs(change) >= 2 ? 'notable' : 'routine'",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-voting-opens",
    "subject": "world",
    "when": [
      "game.knows('congress')",
      "game.congress.available === true",
      "game.congress.votingNow === true"
    ],
    "values": {
      "league": "game.congress.knows('league') ? game.congress.league : null",
      "count": "game.congress.knows('proposals') ? game.congress.proposals.length : 0"
    },
    "tier": "notable",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-world-ideology",
    "subject": "world",
    "when": [
      "activeResolution('World Ideology')"
    ],
    "values": {
      "resolution": "activeResolution('World Ideology')?.name",
      "ours": "self.knows('ideology') && typeof self.ideology === 'string' && resolution.includes(self.ideology)"
    },
    "tier": "major",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-world-project",
    "subject": "world",
    "when": [
      "game.knows('congress')",
      "game.congress.available === true",
      "(game.congress.knows('activeResolutions') && game.congress.activeResolutions.some(r => worldProjects.includes(r.name))) || (game.congress.knows('proposals') && game.congress.proposals.some(p => worldProjects.includes(p.name)))"
    ],
    "values": {
      "project": "(() => { const active = game.congress.knows('activeResolutions') ? game.congress.activeResolutions.find(r => worldProjects.includes(r.name)) : undefined; const proposal = game.congress.knows('proposals') ? game.congress.proposals.find(p => worldProjects.includes(p.name)) : undefined; return active ? active.name : proposal.name; })()"
    },
    "tier": "notable",
    "tags": ["international", "congress"]
  },
  {
    "id": "congress-world-religion",
    "subject": "world",
    "when": [
      "activeResolution('World Religion')"
    ],
    "values": {
      "resolution": "activeResolution('World Religion')?.name",
      "ours": "(self.knows('foundedReligion') && typeof self.foundedReligion === 'string' && resolution.includes(self.foundedReligion)) || (self.knows('majorityReligion') && typeof self.majorityReligion === 'string' && resolution.includes(self.majorityReligion))"
    },
    "tier": "notable",
    "tags": ["international", "congress"]
  },
  {
    "id": "sanction-proposed",
    "subject": "world",
    "when": [
      "game.knows('congress') && game.congress.available === true",
      "game.congress.knows('newProposals')",
      "game.congress.newProposals.some(p => p.isEnact === true && p.name.startsWith('Sanction'))"
    ],
    "values": {
      "resolution": "game.congress.newProposals.find(p => p.isEnact === true && p.name.startsWith('Sanction')).name"
    },
    "tier": "major",
    "tags": ["international", "congress"]
  },
  {
    "id": "sanction-repeal-proposed",
    "subject": "world",
    "when": [
      "game.knows('congress') && game.congress.available === true",
      "game.congress.knows('newProposals')",
      "game.congress.newProposals.some(p => p.isEnact === false && p.name.startsWith('Sanction'))"
    ],
    "values": {
      "resolution": "game.congress.newProposals.find(p => p.isEnact === false && p.name.startsWith('Sanction')).name"
    },
    "tier": "notable",
    "tags": ["international", "congress"]
  },
  {
    "id": "travel-ban-proposed",
    "subject": "world",
    "when": [
      "game.knows('congress') && game.congress.available === true",
      "game.congress.knows('newProposals') && game.congress.newProposals.some(p => p.isEnact && p.name.startsWith('Travel Ban'))"
    ],
    "values": {
      "resolution": "game.congress.newProposals.find(p => p.isEnact && p.name.startsWith('Travel Ban')).name",
      "proposer": "(() => { const p = game.congress.newProposals.find(p => p.isEnact && p.name.startsWith('Travel Ban')); return p.knows('proposer') ? p.proposer : null; })()"
    },
    "tier": "notable",
    "tags": ["international", "congress", "culture"]
  },
  {
    "id": "travel-ban-repeal-proposed",
    "subject": "world",
    "when": [
      "game.knows('congress') && game.congress.available === true",
      "game.congress.knows('newProposals') && game.congress.newProposals.some(p => p.isEnact === false && p.name.startsWith('Travel Ban'))"
    ],
    "values": {
      "resolution": "game.congress.newProposals.find(p => p.isEnact === false && p.name.startsWith('Travel Ban')).name",
      "proposer": "(() => { const p = game.congress.newProposals.find(p => p.isEnact === false && p.name.startsWith('Travel Ban')); return p.knows('proposer') ? p.proposer : null; })()"
    },
    "tier": "notable",
    "tags": ["international", "congress", "culture"]
  }
]
