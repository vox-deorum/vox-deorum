    "adjust": ["city.stake.place", "30 * damage"],
    "urgent": "damage >= 0.5"
  },
  {
    "id": "enemy-city-takes-heavy-damage",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign && city.knows('name')",
      "city.knows('owner') && city.owner.major && city.owner.knows('enemy') && city.owner.enemy",
      "city.knows('hitPoints') && Number.isFinite(city.hitPoints) && city.knows('maxHitPoints') && Number.isFinite(city.maxHitPoints) && city.maxHitPoints > 0",
      "city.knows('before') && city.before.knows('owner') && city.before.owner.id === city.owner.id",
      "city.before.knows('hitPoints') && Number.isFinite(city.before.hitPoints) && city.before.hitPoints > city.hitPoints",
      "city.before.knows('maxHitPoints') && Number.isFinite(city.before.maxHitPoints) && city.before.maxHitPoints > 0",
      "crossed(1 - city.hitPoints / city.maxHitPoints, 1 - city.before.hitPoints / city.before.maxHitPoints, majority)"
    ],
    "values": {
      "cityName": "city.name",
      "civilization": "city.owner.knows('name') ? city.owner.name : null",
      "damage": "(city.maxHitPoints - city.hitPoints) / city.maxHitPoints",
      "wallStrength": "city.hitPoints",
      "maxWallStrength": "city.maxHitPoints"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "20 * damage"],
    "tags": ["cities", "military", "international"]
  },
  {
