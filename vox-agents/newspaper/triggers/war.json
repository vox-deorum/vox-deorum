      "cityName": "city.name",
      "domain": "city.tacticalPostureChanges.filter(c => c.turn === observedTurn).at(-1)?.domain",
      "previousPosture": "city.tacticalPostureChanges.filter(c => c.turn === observedTurn).at(-1)?.previousPosture",
      "posture": "city.tacticalPostureChanges.filter(c => c.turn === observedTurn).at(-1)?.posture"
    },
    "tier": "routine",
    "adjust": "city.stake.place",
    "repeat": 1,
    "tags": ["cities", "military", "domestic"]
  },
  {
    "id": "peace-capitulation",
    "subject": "incident",
    "when": [
      "incident.kind === 'peace'",
      "incident.knows('capitulation') && incident.capitulation === true",
      "incident.knows('initiator') && incident.initiator.knows('name')",
      "incident.knows('target') && incident.target.knows('name')",
      "incident.initiator.major && incident.target.major"
    ],
    "values": {
      "initiator": "incident.initiator.name",
      "target": "incident.target.name",
      "role": "incident.knows('role') ? incident.role : null"
    },
    "tier": "role !== null && role !== 'none' ? 'major' : 'notable'",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "peace-concessions",
    "subject": "incident",
    "when": [
      "incident.kind === 'peace'",
      "incident.knows('concessions') && Array.isArray(incident.concessions) && incident.concessions.length > 0"
    ],
    "values": { "concessions": "incident.concessions.join(', ')", "count": "incident.concessions.length", "role": "incident.knows('role') ? incident.role : null", "initiator": "incident.knows('initiator') && incident.initiator.knows('name') ? incident.initiator.name : null", "target": "incident.knows('target') && incident.target.knows('name') ? incident.target.name : null" },
    "tier": "role !== null && role !== 'none' ? 'major' : 'routine'",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "peace-on-one-front",
    "subject": "incident",
    "when": [
      "incident.kind === 'peace'",
      "incident.knows('role') && (incident.role === 'initiator' || incident.role === 'target')",
      "incident.knows('initiator') && incident.initiator.knows('name')",
      "incident.knows('target') && incident.target.knows('name')",
      "self.knows('wars') && self.wars.some(p => p.major && p.knows('name') && p.id !== (incident.role === 'initiator' ? incident.target.id : incident.initiator.id))"
    ],
    "values": {
      "settled": "incident.role === 'initiator' ? incident.target.name : incident.initiator.name",
      "remaining": "self.wars.filter(p => p.major && p.knows('name') && p.id !== (incident.role === 'initiator' ? incident.target.id : incident.initiator.id)).map(p => p.name).join(', ')"
    },
    "tier": "major",
    "adjust": "self.stake.war",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "peace-returns",
    "subject": "world",
    "window": "recent",
    "when": [
      "self.knows('atWar') && self.atWar === false",
      "self.knows('before')",
      "players.some(rival => !rival.self && rival.knows('major') && rival.major === true && rival.knows('before') && self.before.relation(rival).knows('war') && self.before.relation(rival).war === true)"
    ],
    "tier": "major",
    "tags": ["politics", "military"]
  },
  {
    "id": "units-lost-in-combat",
    "subject": "event",
    "event": "UnitKilledInCombat",
    "when": [
      "event.knows('killedPlayer') && event.killedPlayer.self === true",
      "event.knows('killerPlayer') && event.killerPlayer.major && !event.killerPlayer.self && event.killerPlayer.knows('name')",
      "event.knows('unit') && typeof event.unit === 'string' && event.unit.length > 0"
    ],
    "values": {
      "unit": "event.unit",
      "killer": "event.killerPlayer.name"
    },
    "group": {
      "by": "event.killerPlayer.id",
      "min": 3
    },
    "tier": "notable",
    "adjust": "Math.min(20, 5 * count)",
    "tags": ["politics", "military"]
  },
  {
    "id": "vassals-join-war",
    "subject": "incident",
    "when": [
      "incident.kind == 'war'",
      "incident.participants.some(p => p.reason == 'vassal')"
    ],
    "values": {
      "hostileAllies": "(() => { const names = incident.hostileCityStateAllies.filter(entry => entry.player.knows('name')).map(entry => entry.player.name); return names.length ? ' Hostile city-state allies: ' + names.join(', ') + '.' : ''; })()",
      "vassals": "incident.participants.filter(p => p.reason == 'vassal').map(p => p.player.name).join(', ')",
      "initiator": "incident.initiator.name",
      "target": "incident.target.name"
    },
    "tier": "incident.knows('role') && incident.role !== 'none' ? 'major' : 'routine'",
    "urgent": "incident.role == 'target'"
  },
  {
    "id": "war-advantage-stalls",
    "subject": "pair",
    "window": "long",
    "when": [
      "pair.involvesSelf && pair.atWar",
      "pair.history.some(s => s.warScore >= 25)",
      "held(pair, s => Math.abs(s.warScore - pair.warScore) <= 5, short)"
    ],
    "values": { "opponent": "pair.other.name" },
    "tier": "routine",
    "adjust": "pair.other.stake.front",
    "repeat": "medium"
  },
  {
    "id": "war-between-friends",
    "subject": "incident",
    "when": [
      "incident.kind === 'war'",
      "incident.knows('role') && incident.role === 'none'",
      "incident.knows('initiator') && incident.initiator.knows('major') && incident.initiator.major === true",
      "incident.knows('target') && incident.target.knows('major') && incident.target.major === true",
      "incident.initiator.knows('name') && incident.target.knows('name')",
      "incident.initiator.knows('at') && incident.target.knows('at') && turn - incident.turn < long",
      "incident.initiator.at(turn - incident.turn + 1).relation(self).friend === true && incident.target.at(turn - incident.turn + 1).relation(self).friend === true"
    ],
    "values": {
      "first": "incident.initiator.name",
      "second": "incident.target.name"
    },
    "tier": "notable",
    "adjust": "incident.pair.stake.relation",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "war-duration-milestone",
    "subject": "pair",
    "when": [
      "pair.involvesSelf && pair.majors && pair.atWar",
      "Number.isFinite(pair.warTurns) && Number.isFinite(pair.before.warTurns)",
      "crossed(pair.warTurns, pair.before.warTurns, medium)"
    ],
    "values": {
      "opponent": "pair.other.knows('name') ? pair.other.name : null",
      "turns": "pair.warTurns"
    },
    "tier": "notable",
    "adjust": "pair.other.stake.front",
    "tags": ["politics", "military"]
  },
  {
    "id": "war-involving-us",
    "subject": "incident",
    "when": [
      "incident.kind == 'war'",
      "incident.knows('role') && incident.role != 'none'",
      "incident.knows('initiator') && incident.initiator.knows('name')",
      "incident.knows('target') && incident.target.knows('name')"
    ],
    "values": { "role": "incident.role", "reason": "incident.knows('reason') ? incident.reason : null", "initiator": "incident.initiator.name", "target": "incident.target.name", "hostileAllies": "(() => { const names = incident.hostileCityStateAllies.filter(entry => entry.player.knows('name')).map(entry => entry.player.name); return names.length ? ' Hostile city-state allies: ' + names.join(', ') + '.' : ''; })()" },
    "tier": "role == 'target' ? 'crisis' : 'major'",
    "adjust": "self.stake.war",
    "urgent": "role == 'target'",
    "tags": ["politics", "military"]
  },
  {
    "id": "war-on-three-fronts",
    "subject": "world",
    "when": [
      "self.knows('atWar') && self.atWar === true",
      "self.knows('wars') && Array.isArray(self.wars)",
      "(() => { const opponents = self.wars.filter(p => !p.self && p.knows('major') && p.major === true); return opponents.length >= 3 && opponents.every(p => p.knows('name')); })()"
    ],
    "values": {
      "count": "self.wars.filter(p => !p.self && p.knows('major') && p.major === true).length",
      "enemies": "(() => { const names = self.wars.filter(p => !p.self && p.knows('major') && p.major === true).map(p => p.name); return names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1]; })()"
    },
    "tier": "major",
    "adjust": "self.stake.war",
    "repeat": "medium",
    "tags": ["politics", "military"]
  },
  {
    "id": "war-turns-against-us",
    "subject": "pair",
    "when": [
      "pair.involvesSelf && pair.atWar === true",
      "pair.knows('warScore')",
      "Number.isFinite(pair.warScore)",
      "pair.warScore <= -25"
    ],
    "values": {
      "opponent": "pair.other.name",
      "score": "pair.warScore"
    },
    "tier": "notable",
    "adjust": "pair.other.stake.front",
    "tags": ["politics", "military"]
  },
  {
    "id": "war-turns-our-way",
    "subject": "pair",
    "when": [
      "pair.involvesSelf && pair.atWar === true",
      "pair.knows('warScore')",
      "Number.isFinite(pair.warScore)",
      "pair.warScore >= 25"
    ],
    "values": {
      "opponent": "pair.other.name",
      "score": "pair.warScore"
    },
    "tier": "notable",
    "adjust": "pair.other.stake.front",
    "tags": ["politics", "military"]
  },
  {
    "id": "war-weariness-eases",
    "subject": "pair",
    "window": "recent",
    "when": [
      "pair.involvesSelf && pair.majors && pair.atWar === true",
      "pair.knows('warTurns') && pair.warTurns >= recent",
      "self.relation(pair.other).knows('warWeariness') && self.relation(pair.other).warWeariness < 50",
      "self.knows('before') && self.before.relation(pair.other).knows('warWeariness') && self.before.relation(pair.other).warWeariness >= 50"
    ],
    "values": {
      "opponent": "pair.other.knows('name') ? pair.other.name : null",
      "wearinessPercent": "self.relation(pair.other).warWeariness"
    },
    "tier": "routine",
    "adjust": "pair.other.stake.front",
    "tags": ["politics", "military"]
  },
  {
    "id": "war-weariness-sets-in",
    "subject": "pair",
    "when": [
      "pair.involvesSelf && pair.atWar === true",
      "self.relation(pair.other).knows('warWeariness')",
      "Number.isFinite(self.relation(pair.other).warWeariness)",
      "self.relation(pair.other).warWeariness >= 50"
    ],
    "values": {
      "opponent": "pair.other.name",
      "wearinessPercent": "self.relation(pair.other).warWeariness"
    },
    "tier": "notable",
    "adjust": "pair.other.stake.front",
    "tags": ["politics", "military"]
  },
  {
    "id": "incoming-war-wave",
    "subject": "incident",
    "when": "incident.is.incomingMajorDeclaration && incident.knows('initiator') && incident.initiator.knows('name')",
    "group": {
      "by": "incident.turn",
      "min": 3
    },
    "tier": "crisis",
    "adjust": "Math.min(10, 2 * (count - 3))",
    "urgent": "true",
    "tags": [
      "politics",
      "military"
    ]
  }
]
