[
  {
    "id": "active-war-zone-analysis",
    "subject": "city",
    "when": [
      "city.knows('own') && city.knows('name') && self.knows('name')",
      "city.own === true || (city.foreign === true && city.knows('owner') && city.owner.knows('major') && city.owner.major === true && city.owner.knows('name') && city.owner.knows('enemy') && city.owner.enemy === true)",
      "city.own !== true || (self.knows('wars') && self.wars.some(p => !p.self && p.knows('major') && p.major === true && p.knows('name')))",
      "(() => { const count = (units, name) => { if (!units || !Object.hasOwn(units, name)) return 0; return Object.entries(units[name]).reduce((sum, [unit, n]) => types.settlers.includes(unit) || types.workers.includes(unit) || types.missionaries.includes(unit) || types.greatPeople.includes(unit) || !Number.isFinite(n) || n <= 0 ? sum : sum + n, 0); }; const zones = city.tacticalZones()?.filter(z => z.knows('units') && z.knows('zoneID') && z.knows('domain')); if (!zones) return false; const names = city.own === true ? self.wars.filter(p => !p.self && p.knows('major') && p.major === true && p.knows('name')).map(p => p.name) : [city.owner.name]; return zones.some(zone => { const ours = count(zone.units, self.name); if (ours < 2) return false; return names.some(name => count(zone.units, name) >= 2); }); })()"
    ],
    "values": {
      "opponent": "(() => { const count = (units, name) => { if (!units || !Object.hasOwn(units, name)) return 0; return Object.entries(units[name]).reduce((sum, [unit, n]) => types.settlers.includes(unit) || types.workers.includes(unit) || types.missionaries.includes(unit) || types.greatPeople.includes(unit) || !Number.isFinite(n) || n <= 0 ? sum : sum + n, 0); }; const zones = city.tacticalZones()?.filter(z => z.knows('units') && z.knows('zoneID') && z.knows('domain')) ?? []; const names = city.own === true ? self.wars.filter(p => !p.self && p.knows('major') && p.major === true && p.knows('name')).map(p => p.name) : [city.owner.name]; let best = null, bestCombined = -1; for (const name of [...new Set(names)]) for (const zone of zones) { const ours = count(zone.units, self.name), theirs = count(zone.units, name); const combined = ours + theirs; if (ours < 2 || theirs < 2 || combined <= bestCombined) continue; bestCombined = combined; best = name; } return best; })()",
      "zoneID": "(() => { const count = (units, name) => { if (!units || !Object.hasOwn(units, name)) return 0; return Object.entries(units[name]).reduce((sum, [unit, n]) => types.settlers.includes(unit) || types.workers.includes(unit) || types.missionaries.includes(unit) || types.greatPeople.includes(unit) || !Number.isFinite(n) || n <= 0 ? sum : sum + n, 0); }; const zones = city.tacticalZones()?.filter(z => z.knows('units') && z.knows('zoneID') && z.knows('domain')) ?? []; let best = null, bestCombined = -1; for (const zone of zones) { const ours = count(zone.units, self.name), theirs = count(zone.units, opponent); const combined = ours + theirs; if (ours < 2 || theirs < 2 || combined <= bestCombined) continue; bestCombined = combined; best = zone.zoneID; } return best; })()",
      "cityName": "city.name",
      "ourUnits": "(() => { const zone = city.tacticalZones()?.find(z => z.zoneID === zoneID); if (!zone || !zone.knows('units') || !Object.hasOwn(zone.units, self.name)) return 0; return Object.entries(zone.units[self.name]).reduce((sum, [unit, n]) => types.settlers.includes(unit) || types.workers.includes(unit) || types.missionaries.includes(unit) || types.greatPeople.includes(unit) || !Number.isFinite(n) || n <= 0 ? sum : sum + n, 0); })()",
      "theirUnits": "(() => { const zone = city.tacticalZones()?.find(z => z.zoneID === zoneID); if (!zone || !zone.knows('units') || opponent === null || !Object.hasOwn(zone.units, opponent)) return 0; return Object.entries(zone.units[opponent]).reduce((sum, [unit, n]) => types.settlers.includes(unit) || types.workers.includes(unit) || types.missionaries.includes(unit) || types.greatPeople.includes(unit) || !Number.isFinite(n) || n <= 0 ? sum : sum + n, 0); })()",
      "domain": "city.tacticalZones()?.find(z => z.zoneID === zoneID)?.domain ?? null",
      "posture": "(() => { const zone = city.tacticalZones()?.find(z => z.zoneID === zoneID); return zone?.knows('posture') ? zone.posture : null; })()"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "repeat": "medium",
    "tags": ["cities", "military"]
  },
  {
    "id": "ally-joins-our-war",
    "subject": "incident",
    "when": [
      "incident.kind === 'war'",
      "incident.knows('role') && (incident.role === 'initiator' || incident.role === 'target')",
      "incident.knows('initiator') && incident.initiator.knows('name')",
      "incident.knows('target') && incident.target.knows('name')",
      "incident.participants.some(p => p.reason === 'pact' && p.side === incident.role && !p.player.self && p.player.knows('name'))"
    ],
    "values": {
      "hostileAllies": "(() => { const names = incident.hostileCityStateAllies.filter(entry => entry.player.knows('name')).map(entry => entry.player.name); return names.length ? ' Hostile city-state allies: ' + names.join(', ') + '.' : ''; })()",
      "allies": "incident.participants.filter(p => p.reason === 'pact' && p.side === incident.role && !p.player.self && p.player.knows('name')).map(p => p.player.name).join(', ')",
      "opponent": "incident.role === 'initiator' ? incident.target.name : incident.initiator.name"
    },
    "tier": "major",
    "adjust": "self.stake.war",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "barbarians-at-the-gates",
    "subject": "city",
    "when": [
      "city.knows('own') && city.own === true",
      "city.knows('name')",
      "city.tacticalZones()?.some(z => z.knows('units') && Object.hasOwn(z.units, 'Barbarians') && Object.values(z.units.Barbarians).some(n => Number.isFinite(n) && n > 0))"
    ],
    "values": {
      "cityName": "city.name",
      "barbarians": "city.tacticalZones()?.filter(z => z.knows('units') && Object.hasOwn(z.units, 'Barbarians')).flatMap(z => Object.values(z.units.Barbarians)).filter(n => Number.isFinite(n) && n > 0).reduce((sum, n) => sum + n, 0) ?? 0",
      "posture": "city.tacticalZones()?.find(z => z.knows('posture'))?.posture ?? null"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(15, 3 * barbarians)"],
    "urgent": "barbarians >= 4",
    "tags": ["cities", "military"]
  },
  {
    "id": "besieged-and-starving",
    "subject": "city",
    "when": [
      "city.own",
      "city.is.besieged",
      "city.is.starving"
    ],
    "values": {
