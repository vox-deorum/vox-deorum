[
  {
    "id": "nearby-capital-falls",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "event.isCapital && event.isConquest",
      "!event.oldOwner.self && !event.newOwner.self",
      "event.distance.own <= nearby"
    ],
    "values": { "loser": "event.oldOwner.name", "winner": "event.newOwner.name" },
    "importance": "75"
  },
  {
    "id": "enemy-wonder-nearby",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.owner.enemy",
      "city.distance.own <= nearby",
      "city.built.some(b => city.wonders.includes(b.building))"
    ],
    "values": { "wonder": "city.built.find(b => city.wonders.includes(b.building)).building" },
    "importance": "55"
  },
  {
    "id": "city-state-ally-defects",
    "subject": "event",
    "event": "SetAlly",
    "when": [
      "event.oldAllyPlayer.self",
      "event.newAllyPlayer.is.rival",
      "event.minorPlayer.distance <= nearby"
    ],
    "values": { "cityState": "event.minorPlayer.name", "rival": "event.newAllyPlayer.name" },
    "importance": "65"
  },
  {
    "id": "vassals-join-war",
    "subject": "incident",
    "when": [
      "incident.kind == 'war'",
      "incident.participants.some(p => p.reason == 'vassal')"
    ],
    "values": {
      "vassals": "incident.participants.filter(p => p.reason == 'vassal').map(p => p.player.name).join(', ')",
      "initiator": "incident.initiator.name",
      "target": "incident.target.name"
    },
    "importance": "incident.role == 'none' ? 45 : 80",
    "urgent": "incident.role == 'target'"
  },
  {
    "id": "war-advantage-stalls",
    "subject": "pair",
    "window": "long",
    "when": [
      "pair.involvesSelf && pair.atWar",
      "pair.history.some(s => s.warScore >= 25)",
      "held(pair, s => Math.abs(s.warScore - pair.warScore) <= 5, short)"
    ],
    "values": { "opponent": "pair.other.name" },
    "importance": "50",
    "repeat": "medium"
  },
  {
    "id": "city-state-ally-gained",
    "subject": "event",
    "event": "SetAlly",
    "when": [
      "event.knows('newAllyPlayer') && event.newAllyPlayer.self === true",
      "event.knows('minorPlayer')",
      "!(event.knows('oldAllyPlayer') && event.oldAllyPlayer.self)"
    ],
    "values": { "cityState": "event.minorPlayer.knows('name') ? event.minorPlayer.name : null", "distance": "event.minorPlayer.knows('distance') ? event.minorPlayer.distance : null", "replaced": "event.knows('oldAllyPlayer') && event.oldAllyPlayer.knows('name') ? event.oldAllyPlayer.name : null" },
    "importance": "distance !== null && distance <= nearby ? 70 : 60",
    "tags": ["politics", "international"]
  },
  {
    "id": "war-involving-us",
    "subject": "incident",
    "when": [
      "incident.kind == 'war'",
      "incident.knows('role') && incident.role != 'none'"
    ],
    "values": { "role": "incident.role", "reason": "incident.knows('reason') ? incident.reason : null", "initiator": "incident.knows('initiator') && incident.initiator.knows('name') ? incident.initiator.name : null", "target": "incident.knows('target') && incident.target.knows('name') ? incident.target.name : null" },
    "importance": "role == 'target' ? 95 : role == 'initiator' ? 85 : 75",
    "urgent": "role == 'target'",
    "tags": ["politics", "military"]
  },
  {
    "id": "peace-concessions",
    "subject": "incident",
    "when": [
      "incident.kind === 'peace'",
      "incident.knows('concessions') && Array.isArray(incident.concessions) && incident.concessions.length > 0"
    ],
    "values": { "concessions": "incident.concessions.join(', ')", "count": "incident.concessions.length", "role": "incident.knows('role') ? incident.role : null", "initiator": "incident.knows('initiator') && incident.initiator.knows('name') ? incident.initiator.name : null", "target": "incident.knows('target') && incident.target.knows('name') ? incident.target.name : null" },
    "importance": "role !== null && role !== 'none' ? 75 : 50",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "ally-city-state-attacked",
    "subject": "incident",
    "when": [
      "incident.kind == 'war'",
      "incident.knows('role') && incident.role === 'none'",
      "incident.knows('target') && incident.target.knows('cityState') && incident.target.cityState === true",
      "incident.target.knows('at') && turn - incident.turn < long",
      "(() => { const target = incident.target.at(turn - incident.turn + 1); return target.knows('majorAlly') && target.majorAlly !== null && target.majorAlly.self === true; })()"
    ],
    "values": { "ally": "incident.knows('target') && incident.target.knows('name') ? incident.target.name : null", "aggressor": "incident.knows('initiator') && incident.initiator.knows('name') ? incident.initiator.name : null" },
    "importance": 80,
    "tags": ["politics", "military"]
  },
  {
    "id": "faith-reaches-city-state",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign",
      "city.knows('owner') && city.owner.knows('cityState') && city.owner.cityState === true",
      "city.knows('distance') && city.distance.knows('own') && city.distance.own > neighboring",
      "city.knows('majorityReligion') && typeof city.majorityReligion === 'string' && city.majorityReligion.length > 0",
      "city.knows('before') && city.before.knows('majorityReligion')",
      "changed(city, 'majorityReligion')",
      "self.knows('foundedReligion') && typeof self.foundedReligion === 'string' && self.foundedReligion === city.majorityReligion",
      "city.conversions.some(c => c.knows('religion') && c.religion === city.majorityReligion)"
    ],
    "values": { "cityState": "city.knows('owner') && city.owner.knows('name') ? city.owner.name : null", "religion": "city.majorityReligion" },
    "importance": 55,
    "tags": ["politics", "international"]
  }
]
