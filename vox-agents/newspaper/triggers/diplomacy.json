[
  {
    "id": "becomes-vassal",
    "subject": "player",
    "when": [
      "player.is.foreignMajor",
      "self.relation(player).vassalOf",
      "!self.get('before') || !player.get('before') || (!self.before.relation(player).vassalOf && !self.relation(player).coveredByAgreement('vassalOf', self.before.relation(player)))"
    ],
    "values": {
      "master": "player.name"
    },
    "tier": "crisis",
    "urgent": "true",
    "tags": ["politics", "international"]
  },
  {
    "id": "defensive-pact-ends",
    "subject": "pair",
    "when": [
      "pair.involvesSelf && pair.majors && !pair.atWar && !pair.pact",
      "pair.get('before.pact')"
    ],
    "values": {
      "ally": "pair.other.name"
    },
    "tier": "notable",
    "adjust": "pair.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "defensive-pact-signed",
    "summary": "We entered a defensive pact with another civilization.",
    "subject": "pair",
    "when": [
      "pair.involvesSelf",
      "pair.majors",
      "pair.pact",
      "pair.get('before.pact') === false",
      "!pair.coveredByAgreement('pact', pair.before)"
    ],
    "values": {
      "ally": "pair.other.name"
    },
    "tier": "notable",
    "adjust": "pair.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "denounced-by-major",
    "subject": "player",
    "when": [
      "player.is.foreignMajor",
      "self.relation(player).denouncedByThem"
    ],
    "values": {
      "civilization": "player.name"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "first-contact",
    "subject": "event",
    "event": "TeamMeet",
    "when": [
      "event.currentTeamId != event.otherTeamId",
      "event.currentTeamId == self.teamId || event.otherTeamId == self.teamId",
      "players.some(p => !p.self && p.get('teamId') === (event.currentTeamId === self.teamId ? event.otherTeamId : event.currentTeamId) && p.get('name'))"
    ],
    "values": {
      "otherTeam": "event.currentTeamId == self.teamId ? event.otherTeamId : event.currentTeamId",
      "stranger": "players.filter(p => !p.self && p.get('teamId') === otherTeam && p.get('name')).map(p => p.name).join(' and ')",
      "metMajor": "players.some(p => !p.self && p.get('teamId') == otherTeam && p.get('major'))"
    },
    "tier": "metMajor ? 'notable' : 'routine'",
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-defensive-pact",
    "subject": "pair",
    "when": [
      "!pair.involvesSelf && pair.majors && pair.pact",
      "pair.get('before.pact') === false"
    ],
    "values": {
      "first": "pair.a.name",
      "second": "pair.b.name",
      "withFriend": "!!pair.a.get('friend') || !!pair.b.get('friend')",
      "withEnemy": "!!pair.a.get('enemy') || !!pair.b.get('enemy')"
    },
    "tier": "notable",
    "adjust": "pair.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-defensive-pact-ends",
    "subject": "pair",
    "when": [
      "!pair.involvesSelf && pair.majors && !pair.atWar && !pair.pact",
      "pair.get('before.pact')"
    ],
    "values": {
      "first": "pair.a.name",
      "second": "pair.b.name",
      "withFriend": "!!pair.a.get('friend') || !!pair.b.get('friend')",
      "withEnemy": "!!pair.a.get('enemy') || !!pair.b.get('enemy')"
    },
    "tier": "notable",
    "adjust": "pair.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "friendship-begins",
    "summary": "We declared friendship with another civilization.",
    "subject": "pair",
    "window": "recent",
    "when": [
      "pair.involvesSelf",
      "pair.majors",
      "pair.friends",
      "pair.get('before.friends') === false",
      "!pair.coveredByAgreement('friends', pair.before)",
      "!(pair.get('pact') && pair.get('before.pact') === false && !pair.coveredByAgreement('pact', pair.before))"
    ],
    "values": {
      "friend": "pair.other.name"
    },
    "tier": "notable",
    "adjust": "pair.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "friendship-ends",
    "subject": "pair",
    "when": [
      "pair.involvesSelf && pair.majors",
      "!pair.friends",
      "pair.get('before.friends')"
    ],
    "values": {
      "friend": "pair.other.name"
    },
    "tier": "notable",
    "adjust": "pair.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "gains-vassal",
    "subject": "player",
    "when": [
      "player.is.foreignMajor",
      "self.relation(player).masterOf",
      "!self.get('before') || !player.get('before') || (!self.before.relation(player).masterOf && !self.relation(player).coveredByAgreement('masterOf', self.before.relation(player)))"
    ],
    "values": {
      "vassal": "player.name"
    },
    "tier": "major",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "loses-vassal",
    "subject": "player",
    "when": [
      "player.is.foreignMajor",
      "self.get('before')",
      "(() => { const now = self.relation(player); const before = self.before.relation(player); return !now.vassalOf && !now.masterOf && before.masterOf && !now.coveredByAgreement('masterOf', before); })()"
    ],
    "values": {
      "vassal": "player.name"
    },
    "tier": "major",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "mutual-denunciation",
    "subject": "player",
    "window": "recent",
    "when": [
      "player.is.foreignMajor",
      "self.relation(player).denouncedThem",
      "self.relation(player).denouncedByThem",
      "self.get('before') && player.get('before')",
      "self.before.relation(player.before).knows('denouncedThem') && self.before.relation(player.before).knows('denouncedByThem')",
      "!(self.before.relation(player.before).denouncedThem && self.before.relation(player.before).denouncedByThem)"
    ],
    "values": {
      "civilization": "player.name"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "open-borders-granted",
    "summary": "We newly granted another civilization permission to cross our borders.",
    "subject": "player",
    "window": "recent",
    "when": [
      "player.is.foreignMajor",
      "self.get('before')",
      "self.relation(player).openBordersTo",
      "self.before.relation(player).get('openBordersTo') === false",
      "!self.relation(player).coveredByAgreement('openBordersTo', self.before.relation(player))"
    ],
    "values": {
      "civilization": "player.name",
      "capital": "player.knows('capital') && player.capital.knows('name') ? player.capital.name : null"
    },
    "tier": "routine",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "open-borders-received",
    "summary": "Another civilization newly granted us permission to cross its borders.",
    "subject": "player",
    "window": "recent",
    "when": [
      "player.is.foreignMajor",
      "self.get('before')",
      "self.relation(player).openBordersFrom",
      "self.before.relation(player).get('openBordersFrom') === false",
      "!self.relation(player).coveredByAgreement('openBordersFrom', self.before.relation(player))",
      "!(self.relation(player).get('openBordersTo') && self.before.relation(player).get('openBordersTo') === false && !self.relation(player).coveredByAgreement('openBordersTo', self.before.relation(player)))"
    ],
    "values": {
      "civilization": "player.name",
      "capital": "player.knows('capital') && player.capital.knows('name') ? player.capital.name : null"
    },
    "tier": "routine",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  },
  {
    "id": "third-party-peace-deal",
    "summary": "A visible deal includes terms to make peace with a third party.",
    "subject": "event",
    "event": "DealMade",
    "when": [
      "Array.isArray(event.tradedItems)",
      "event.tradedItems.some(item => item.get('itemType') === 'ThirdPartyPeace')",
      "event.get('deal.kind') !== 'comprehensive-agreement'",
      "!event.tradedItems.some(item => item.get('itemType') === 'ThirdPartyWar')"
    ],
    "values": {
      "from": "event.fromPlayer.name",
      "to": "event.toPlayer.name",
      "fromGives": "event.knows('fromGives') && Array.isArray(event.fromGives) ? event.fromGives.join(', ') : null",
      "toGives": "event.knows('toGives') && Array.isArray(event.toGives) ? event.toGives.join(', ') : null",
      "ours": "event.fromPlayer.self || event.toPlayer.self"
    },
    "tier": "ours ? 'notable' : 'routine'",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "third-party-war-deal",
    "summary": "A visible deal includes terms to declare war on a third party.",
    "subject": "event",
    "event": "DealMade",
    "when": [
      "Array.isArray(event.tradedItems)",
      "event.tradedItems.some(item => item.get('itemType') === 'ThirdPartyWar')",
      "event.get('deal.kind') !== 'comprehensive-agreement'"
    ],
    "values": {
      "from": "event.fromPlayer.name",
      "to": "event.toPlayer.name",
      "fromGives": "event.knows('fromGives') && Array.isArray(event.fromGives) ? event.fromGives.join(', ') : null",
      "toGives": "event.knows('toGives') && Array.isArray(event.toGives) ? event.toGives.join(', ') : null",
      "ours": "event.fromPlayer.self || event.toPlayer.self"
    },
    "tier": "ours ? 'major' : 'notable'",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "vassalage-ends",
    "subject": "player",
    "when": [
      "player.is.foreignMajor",
      "self.get('before')",
      "(() => { const now = self.relation(player); const before = self.before.relation(player); return !now.vassalOf && !now.masterOf && before.vassalOf && !now.coveredByAgreement('vassalOf', before); })()"
    ],
    "values": {
      "master": "player.name"
    },
    "tier": "crisis",
    "tags": ["politics", "international"]
  },
  {
    "id": "we-denounce-major",
    "subject": "player",
    "when": [
      "player.is.foreignMajor",
      "self.get('before')",
      "self.relation(player).denouncedThem",
      "self.before.relation(player).get('denouncedThem') === false"
    ],
    "values": {
      "civilization": "player.name"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["politics", "international"]
  }
]
