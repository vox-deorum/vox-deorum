[
  {
    "id": "becomes-vassal",
    "subject": "player",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "self.relation(player).knows('vassalOf')",
      "self.relation(player).vassalOf === true"
    ],
    "values": {
      "master": "player.name"
    },
    "importance": 90,
    "urgent": "true",
    "tags": ["politics", "international"]
  },
  {
    "id": "defensive-pact-ends",
    "subject": "pair",
    "when": [
      "pair.involvesSelf && pair.majors && pair.knows('atWar') && !pair.atWar && pair.knows('pact') && pair.pact === false",
      "pair.other.knows('name')",
      "pair.knows('before') && pair.before.knows('pact') && pair.before.pact === true"
    ],
    "values": {
      "ally": "pair.other.name"
    },
    "importance": 65,
    "tags": ["politics", "international"]
  },
  {
    "id": "defensive-pact-signed",
    "subject": "pair",
    "when": [
      "pair.involvesSelf",
      "pair.other.knows('name')",
      "pair.knows('majors') && pair.majors === true",
      "pair.knows('pact') && pair.pact === true",
      "pair.knows('before') && pair.before.knows('pact') && pair.before.pact === false"
    ],
    "values": {
      "ally": "pair.other.name"
    },
    "importance": 65,
    "tags": ["politics", "international"]
  },
  {
    "id": "denounced-by-major",
    "subject": "player",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "self.relation(player).knows('denouncedByThem')",
      "self.relation(player).denouncedByThem === true"
    ],
    "values": {
      "civilization": "player.name"
    },
    "importance": 60,
    "tags": ["politics", "international"]
  },
  {
    "id": "first-contact",
    "subject": "event",
    "event": "TeamMeet",
    "when": [
      "event.knows('currentTeamId') && event.knows('otherTeamId')",
      "event.currentTeamId != event.otherTeamId",
      "self.knows('teamId')",
      "event.currentTeamId == self.teamId || event.otherTeamId == self.teamId",
      "players.some(p => !p.self && p.knows('teamId') && p.teamId === (event.currentTeamId === self.teamId ? event.otherTeamId : event.currentTeamId) && p.knows('name'))"
    ],
    "values": {
      "otherTeam": "event.currentTeamId == self.teamId ? event.otherTeamId : event.currentTeamId",
      "stranger": "players.filter(p => !p.self && p.knows('teamId') && p.teamId === otherTeam && p.knows('name')).map(p => p.name).join(' and ')",
      "major": "players.some(p => !p.self && p.knows('teamId') && p.teamId == otherTeam && p.knows('major') && p.major === true)"
    },
    "importance": "major ? 70 : 45",
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-defensive-pact",
    "subject": "pair",
    "when": [
      "!pair.involvesSelf && pair.majors && pair.knows('pact') && pair.pact === true",
      "pair.a.knows('name') && pair.b.knows('name')",
      "pair.knows('before') && pair.before.knows('pact') && pair.before.pact === false"
    ],
    "values": {
      "first": "pair.a.name",
      "second": "pair.b.name",
      "withFriend": "(pair.a.knows('friend') && pair.a.friend === true) || (pair.b.knows('friend') && pair.b.friend === true)",
      "withEnemy": "(pair.a.knows('enemy') && pair.a.enemy === true) || (pair.b.knows('enemy') && pair.b.enemy === true)"
    },
    "importance": "withEnemy ? 70 : withFriend ? 60 : 50",
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-defensive-pact-ends",
    "subject": "pair",
    "when": [
      "!pair.involvesSelf && pair.majors && pair.knows('atWar') && !pair.atWar && pair.knows('pact') && pair.pact === false",
      "pair.a.knows('name') && pair.b.knows('name')",
      "pair.knows('before') && pair.before.knows('pact') && pair.before.pact === true"
    ],
    "values": {
      "first": "pair.a.name",
      "second": "pair.b.name",
      "withFriend": "(pair.a.knows('friend') && pair.a.friend === true) || (pair.b.knows('friend') && pair.b.friend === true)",
      "withEnemy": "(pair.a.knows('enemy') && pair.a.enemy === true) || (pair.b.knows('enemy') && pair.b.enemy === true)"
    },
    "importance": "withEnemy ? 60 : withFriend ? 55 : 45",
    "tags": ["politics", "international"]
  },
  {
    "id": "friendship-begins",
    "subject": "pair",
    "window": "recent",
    "when": [
      "pair.involvesSelf",
      "pair.other.knows('name')",
      "pair.majors",
      "pair.knows('friends') && pair.friends === true",
      "pair.knows('before') && pair.before.knows('friends') && pair.before.friends === false",
      "!(pair.knows('pact') && pair.pact === true && pair.before.knows('pact') && pair.before.pact === false)"
    ],
    "values": {
      "friend": "pair.other.name"
    },
    "importance": 55,
    "tags": ["politics", "international"]
  },
  {
    "id": "friendship-ends",
    "subject": "pair",
    "when": [
      "pair.involvesSelf && pair.majors",
      "pair.other.knows('name')",
      "pair.knows('friends') && pair.friends === false",
      "pair.knows('before') && pair.before.knows('friends') && pair.before.friends === true"
    ],
    "values": {
      "friend": "pair.other.name"
    },
    "importance": 60,
    "tags": ["politics", "international"]
  },
  {
    "id": "gains-vassal",
    "subject": "player",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "self.relation(player).knows('masterOf')",
      "self.relation(player).masterOf === true"
    ],
    "values": {
      "vassal": "player.name"
    },
    "importance": 75,
    "tags": ["politics", "international"]
  },
  {
    "id": "loses-vassal",
    "subject": "player",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "player.knows('friend') && self.knows('before')",
      "(() => { const now = self.relation(player); const before = self.before.relation(player); return now.vassalOf === false && now.masterOf === false && before.masterOf === true; })()"
    ],
    "values": {
      "vassal": "player.name"
    },
    "importance": 75,
    "tags": ["politics", "international"]
  },
  {
    "id": "mutual-denunciation",
    "subject": "player",
    "window": "recent",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "self.relation(player).knows('denouncedThem') && self.relation(player).denouncedThem === true",
      "self.relation(player).knows('denouncedByThem') && self.relation(player).denouncedByThem === true",
      "self.knows('before') && player.knows('before')",
      "self.before.relation(player.before).knows('denouncedThem') && self.before.relation(player.before).knows('denouncedByThem')",
      "!(self.before.relation(player.before).denouncedThem && self.before.relation(player.before).denouncedByThem)"
    ],
    "values": {
      "civilization": "player.name"
    },
    "importance": 60,
    "tags": ["politics", "international"]
  },
  {
    "id": "open-borders-granted",
    "subject": "player",
    "window": "recent",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "self.knows('before')",
      "self.relation(player).knows('openBordersTo') && self.relation(player).openBordersTo === true",
      "self.before.relation(player).knows('openBordersTo') && self.before.relation(player).openBordersTo === false"
    ],
    "values": {
      "civilization": "player.name",
      "capital": "player.knows('capital') && player.capital.knows('name') ? player.capital.name : null"
    },
    "importance": 45,
    "tags": ["politics", "international"]
  },
  {
    "id": "open-borders-received",
    "subject": "player",
    "window": "recent",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "self.knows('before')",
      "self.relation(player).knows('openBordersFrom') && self.relation(player).openBordersFrom === true",
      "self.before.relation(player).knows('openBordersFrom') && self.before.relation(player).openBordersFrom === false",
      "!(self.relation(player).knows('openBordersTo') && self.relation(player).openBordersTo === true && self.before.relation(player).knows('openBordersTo') && self.before.relation(player).openBordersTo === false)"
    ],
    "values": {
      "civilization": "player.name",
      "capital": "player.knows('capital') && player.capital.knows('name') ? player.capital.name : null"
    },
    "importance": 45,
    "tags": ["politics", "international"]
  },
  {
    "id": "third-party-peace-deal",
    "subject": "event",
    "event": "DealMade",
    "when": [
      "event.knows('fromPlayer') && event.knows('toPlayer')",
      "event.fromPlayer.knows('name') && event.toPlayer.knows('name')",
      "event.knows('tradedItems') && Array.isArray(event.tradedItems)",
      "event.tradedItems.some(item => item.knows('itemType') && item.itemType === 'ThirdPartyPeace')",
      "!event.tradedItems.some(item => item.knows('itemType') && item.itemType === 'ThirdPartyWar')"
    ],
    "values": {
      "from": "event.fromPlayer.name",
      "to": "event.toPlayer.name",
      "fromGives": "event.knows('fromGives') && Array.isArray(event.fromGives) ? event.fromGives.join(', ') : null",
      "toGives": "event.knows('toGives') && Array.isArray(event.toGives) ? event.toGives.join(', ') : null",
      "ours": "event.fromPlayer.self || event.toPlayer.self"
    },
    "importance": "ours ? 65 : 50",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "third-party-war-deal",
    "subject": "event",
    "event": "DealMade",
    "when": [
      "event.knows('fromPlayer') && event.knows('toPlayer')",
      "event.fromPlayer.knows('name') && event.toPlayer.knows('name')",
      "event.knows('tradedItems') && Array.isArray(event.tradedItems)",
      "event.tradedItems.some(item => item.knows('itemType') && item.itemType === 'ThirdPartyWar')"
    ],
    "values": {
      "from": "event.fromPlayer.name",
      "to": "event.toPlayer.name",
      "fromGives": "event.knows('fromGives') && Array.isArray(event.fromGives) ? event.fromGives.join(', ') : null",
      "toGives": "event.knows('toGives') && Array.isArray(event.toGives) ? event.toGives.join(', ') : null",
      "ours": "event.fromPlayer.self || event.toPlayer.self"
    },
    "importance": "ours ? 70 : 55",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "vassalage-ends",
    "subject": "player",
    "when": [
      "!player.self && player.knows('major') && player.major === true",
      "player.knows('name')",
      "player.knows('friend') && self.knows('before')",
      "(() => { const now = self.relation(player); const before = self.before.relation(player); return now.vassalOf === false && now.masterOf === false && before.vassalOf === true; })()"
    ],
    "values": {
      "master": "player.name"
    },
    "importance": 85,
    "tags": ["politics", "international"]
  },
  {
    "id": "we-denounce-major",
    "subject": "player",
    "when": [
      "!player.self",
      "player.knows('major') && player.major === true",
      "player.knows('name')",
      "self.knows('before')",
      "self.relation(player).knows('denouncedThem') && self.relation(player).denouncedThem === true",
      "self.before.relation(player).knows('denouncedThem') && self.before.relation(player).denouncedThem === false"
    ],
    "values": {
      "civilization": "player.name"
    },
    "importance": 60,
    "tags": ["politics", "international"]
  }
]
