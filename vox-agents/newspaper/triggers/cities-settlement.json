[
  {
    "id": "distant-colony-founded",
    "subject": "event",
    "event": "PlayerCityFounded",
    "when": [
      "event.knows('player') && event.player.self === true",
      "event.knows('city') && event.city.knows('name')",
      "event.city.knows('distance') && event.city.distance.knows('capital')",
      "event.city.distance.capital >= nearby"
    ],
    "values": {
      "distance": "event.city.distance.capital"
    },
    "tier": "notable",
    "adjust": "Math.min(10, distance - nearby)",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "forward-settle",
    "subject": "event",
    "event": ["PlayerCityFounded", "UnitCityFounded"],
    "when": [
      "event.is.forwardSettle",
      "event.is.preferredFounding"
    ],
    "values": {
      "ours": "event.city.nearestOwn.name",
      "distance": "event.distance.own"
    },
    "tier": "notable",
    "adjust": "event.stake.place",
    "urgent": "distance <= 2"
  },
  {
    "id": "our-city-founded",
    "subject": "event",
    "event": ["PlayerCityFounded", "UnitCityFounded"],
    "when": [
      "event.knows('player') && event.player.self === true && event.knows('city') && event.city.knows('name')",
      "event.type === 'PlayerCityFounded' || !event.knows('plot') || !events.some(e => e.type === 'PlayerCityFounded' && e.turn === event.turn && e.knows('player') && e.player.self && e.knows('plot') && e.plot.x === event.plot.x && e.plot.y === event.plot.y)"
    ],
    "tier": "routine",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "settler-departure",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own",
      "city.population < city.before.population",
      "city.trained.some(t => settlers.includes(t.unit))",
      "city.foodPerTurn > 0"
    ],
    "values": {
      "lost": "city.before.population - city.population"
    },
    "tier": "routine",
    "adjust": "10 * lost"
  },
  {
    "id": "foreign-city-founded",
    "subject": "event",
    "event": ["PlayerCityFounded", "UnitCityFounded"],
    "when": [
      "event.knows('player') && event.player.knows('id') && event.player.self === false && event.player.knows('name')",
      "event.knows('city') && event.city.knows('name') && event.city.knows('owner') && event.city.owner.knows('id') && event.city.owner.knows('name') && event.city.foreign === true",
      "event.player.id === event.city.owner.id",
      "event.city.is.nearby",
      "!event.is.forwardSettle",
      "event.is.preferredFounding"
    ],
    "values": {
      "owner": "event.player.name",
      "distance": "event.distance.own"
    },
    "tier": "routine",
    "adjust": "event.stake.place",
    "tags": ["cities", "international"]
  },
  {
    "id": "foreign-city-raises-settlers",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign === true && city.knows('name')",
      "city.knows('owner') && city.owner.knows('id') && city.owner.knows('name')",
      "city.is.nearby",
      "city.knows('trained') && city.trained.some(t => t.knows('unit') && settlers.includes(t.unit))",
      "city.knows('population') && Number.isFinite(city.population)",
      "city.knows('before') && city.before.knows('population') && Number.isFinite(city.before.population) && city.before.knows('owner') && city.before.owner.knows('id') && city.before.owner.id === city.owner.id",
      "city.population < city.before.population",
      "city.knows('foodPerTurn') && Number.isFinite(city.foodPerTurn) && city.foodPerTurn > 0"
    ],
    "values": {
      "lost": "city.before.population - city.population"
    },
    "tier": "routine",
    "adjust": ["city.stake.place", "10 * lost"],
    "tags": ["cities", "international"]
  }
]
