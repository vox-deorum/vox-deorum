[
  {
    "id": "distant-colony-founded",
    "subject": "event",
    "event": "PlayerCityFounded",
    "when": [
      "event.player.self",
      "event.city.name",
      "event.city.distance.capital >= nearby"
    ],
    "values": {
      "distance": "event.city.distance.capital"
    },
    "tier": "notable",
    "adjust": "Math.min(10, distance - nearby)",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-city-founded",
    "subject": "event",
    "event": ["PlayerCityFounded", "UnitCityFounded"],
    "when": [
      "!event.player.self",
      "event.city.name && event.city.owner.name && event.city.foreign",
      "event.player.id === event.city.owner.id",
      "!event.is.forwardSettle",
      "event.is.preferredFounding"
    ],
    "values": {
      "owner": "event.player.name"
    },
    "tier": "routine",
    "adjust": "event.stake.place",
    "tags": ["cities", "international"]
  },
  {
    "id": "foreign-city-raises-settlers",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign && city.name",
      "city.owner.name",
      "city.trained.some(t => settlers.includes(t.get('unit')))",
      "city.get('before.owner.id') === city.owner.id",
      "city.population < city.get('before.population')",
      "city.foodPerTurn > 0"
    ],
    "values": {
      "lost": "city.before.population - city.population"
    },
    "tier": "routine",
    "adjust": ["city.stake.place", "10 * lost"],
    "tags": ["cities", "international"]
  },
  {
    "id": "forward-settle",
    "subject": "event",
    "event": ["PlayerCityFounded", "UnitCityFounded"],
    "when": [
      "event.is.forwardSettle",
      "event.is.preferredFounding"
    ],
    "values": {
      "ours": "event.city.nearestOwn.name",
      "distance": "event.distance.own"
    },
    "tier": "notable",
    "adjust": "event.stake.place",
    "urgent": "distance <= 2"
  },
  {
    "id": "our-city-founded",
    "subject": "event",
    "event": ["PlayerCityFounded", "UnitCityFounded"],
    "when": [
      "event.player.self && event.city.name",
      "event.is.preferredFounding"
    ],
    "tier": "routine",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "settler-departure",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own",
      "city.population < city.before.population",
      "city.trained.some(t => settlers.includes(t.unit))",
      "city.foodPerTurn > 0"
    ],
    "values": {
      "lost": "city.before.population - city.population"
    },
    "tier": "routine",
    "adjust": "10 * lost"
  }
]
