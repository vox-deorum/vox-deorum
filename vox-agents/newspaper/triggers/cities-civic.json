[
  {
    "id": "capital-outgrown",
    "subject": "world",
    "when": "self.cities.some(c => c.get('population') > self.capital.population)",
    "values": {
      "largestPopulation": "Math.max(...self.cities.filter(c => c.get('population') !== undefined).map(c => c.population))",
      "largest": "(() => { const names = self.cities.filter(c => c.get('population') === largestPopulation).map(c => c.name); return names.length <= 2 ? names.join(' and ') : names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1]; })()",
      "tied": "self.cities.filter(c => c.get('population') === largestPopulation).length > 1",
      "capital": "self.capital.name"
    },
    "tier": "routine"
  },
  {
    "id": "cities-share-grievance",
    "subject": "city",
    "when": [
      "city.own",
      "city.unhappiness.top !== null"
    ],
    "group": {
      "by": "city.unhappiness.top",
      "min": 3
    },
    "tier": "notable",
    "adjust": "10 * (count - 3)",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-famine-unrest",
    "subject": "city",
    "when": [
      "city.own",
      "city.unhappiness.top === 'famine'"
    ],
    "values": {
      "faminePopulation": "city.unhappiness.famine"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "city-growth-milestone",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.population >= largeCity && city.own",
      "city.get('before.owner.self')",
      "crossed(city.population, city.get('before.population'), largeCity) || crossed(city.population, city.get('before.population'), metropolis)"
    ],
    "values": {
      "milestone": "crossed(city.population, city.before.population, metropolis) ? 'metropolis' : 'large city'",
      "population": "city.population"
    },
    "tier": "milestone === 'metropolis' ? 'notable' : 'routine'",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "starvation-without-siege",
    "subject": "city",
    "when": [
      "city.own",
      "!self.atWar",
      "city.unhappiness.knows('top') && city.unhappiness.top !== 'famine'",
      "city.foodPerTurn < 0",
      "city.is.starving"
    ],
    "values": {
      "foodPerTurn": "city.foodPerTurn",
      "foodStored": "city.foodStored",
      "shortfall": "-city.foodPerTurn"
    },
    "tier": "notable",
    "adjust": ["city.stake.place", "Math.min(20, 5 * shortfall)"],
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-city-growth-milestone",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.foreign && city.name",
      "city.owner.knows('name')",
      "city.get('before.owner.id') === city.owner.id",
      "crossed(city.population, city.get('before.population'), largeCity) || crossed(city.population, city.get('before.population'), metropolis)"
    ],
    "values": {
      "population": "city.population",
      "milestone": "crossed(city.population, city.before.population, metropolis) ? 'metropolis' : 'large city'"
    },
    "tier": "milestone === 'metropolis' ? 'notable' : 'routine'",
    "adjust": "city.stake.place",
    "tags": ["cities", "international"]
  },
  {
    "id": "foreign-city-hardship",
    "subject": "city",
    "when": [
      "city.foreign && city.name",
      "city.owner.knows('id') && city.owner.knows('name')",
      "(city.get('unhappiness.top') === 'famine' || city.get('unhappiness.top') === 'pillaged') || (city.get('foodPerTurn') < 0 && city.get('foodStored') !== undefined && city.is.starving)"
    ],
    "values": {
      "cause": "city.get('unhappiness.top') === 'famine' ? 'famine' : city.get('unhappiness.top') === 'pillaged' ? 'pillaged' : 'foodShortage'"
    },
    "tier": "notable",
    "adjust": "city.stake.place",
    "tags": ["cities", "international"]
  },
  {
    "id": "city-celebration-begins",
    "subject": "event",
    "event": "CityBeginsWLTKD",
    "when": [
      "event.is.ourCity"
    ],
    "tier": "filler",
    "adjust": "event.city.stake.place",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "foreign-city-celebration-begins",
    "subject": "event",
    "event": "CityBeginsWLTKD",
    "when": [
      "event.is.theirCity"
    ],
    "values": {
      "owner": "event.city.owner.name"
    },
    "tier": "filler",
    "adjust": "event.city.stake.place",
    "tags": ["cities", "international"]
  }
]
