[
  {
    "id": "ally-city-state-attacked",
    "subject": "incident",
    "when": [
      "incident.kind == 'war'",
      "incident.knows('role') && incident.role === 'none'",
      "incident.knows('target') && incident.target.knows('cityState') && incident.target.cityState === true",
      "incident.target.knows('at') && turn - incident.turn < long",
      "incident.target.at(turn - incident.turn + 1).is.alliedCityState"
    ],
    "values": { "ally": "incident.knows('target') && incident.target.knows('name') ? incident.target.name : null", "aggressor": "incident.knows('initiator') && incident.initiator.knows('name') ? incident.initiator.name : null" },
    "importance": 80,
    "tags": ["politics", "military"]
  },
  {
    "id": "ally-city-state-captured",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "event.knows('oldOwner') && event.knows('newOwner')",
      "event.oldOwner.knows('cityState') && event.oldOwner.cityState === true",
      "event.newOwner.knows('major') && event.newOwner.major === true && event.newOwner.self === false",
      "event.knows('isConquest') && event.isConquest === true",
      "event.turn <= turn && turn - event.turn < long",
      "event.oldOwner.at(turn - event.turn + 1).is.alliedCityState"
    ],
    "values": {
      "cityState": "event.oldOwner.knows('name') ? event.oldOwner.name : null",
      "captor": "event.newOwner.knows('name') ? event.newOwner.name : null",
      "cityName": "event.knows('city') && event.city.knows('name') ? event.city.name : null",
      "distance": "event.knows('distance') ? event.distance.own : null"
    },
    "importance": 85,
    "urgent": "event.knows('distance') && event.distance.own <= neighboring",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "city-state-ally-defects",
    "subject": "event",
    "event": "SetAlly",
    "when": [
      "event.oldAllyPlayer.self",
      "event.newAllyPlayer.is.rival",
      "event.minorPlayer.distance <= nearby"
    ],
    "values": { "cityState": "event.minorPlayer.name", "rival": "event.newAllyPlayer.name" },
    "importance": "65"
  },
  {
    "id": "city-state-ally-gained",
    "subject": "event",
    "event": "SetAlly",
    "when": [
      "event.knows('newAllyPlayer') && event.newAllyPlayer.self === true",
      "event.knows('minorPlayer')",
      "!(event.knows('oldAllyPlayer') && event.oldAllyPlayer.self)"
    ],
    "values": { "cityState": "event.minorPlayer.knows('name') ? event.minorPlayer.name : null", "distance": "event.minorPlayer.knows('distance') ? event.minorPlayer.distance : null", "replaced": "event.knows('oldAllyPlayer') && event.oldAllyPlayer.knows('name') ? event.oldAllyPlayer.name : null" },
    "importance": "distance !== null && distance <= nearby ? 70 : 60",
    "tags": ["politics", "international"]
  },
  {
    "id": "city-state-ally-lost",
    "subject": "event",
    "event": "SetAlly",
    "when": [
      "event.knows('oldAllyPlayer') && event.oldAllyPlayer.self === true",
      "event.knows('newAllyPlayerId') && event.newAllyPlayerId === -1",
      "event.knows('minorPlayer')"
    ],
    "values": {
      "cityState": "event.minorPlayer.knows('name') ? event.minorPlayer.name : null",
      "distance": "event.minorPlayer.knows('distance') ? event.minorPlayer.distance : null"
    },
    "importance": "distance !== null && distance <= nearby ? 60 : 50",
    "tags": ["politics", "international"]
  },
  {
    "id": "city-state-ally-switches-to-friend",
    "subject": "event",
    "event": "SetAlly",
    "when": [
      "event.knows('oldAllyPlayer') && event.oldAllyPlayer.self === true",
      "event.knows('newAllyPlayer') && event.newAllyPlayer.self === false && event.newAllyPlayer.knows('major') && event.newAllyPlayer.major === true",
      "event.newAllyPlayer.knows('friend') && event.newAllyPlayer.friend === true",
      "event.knows('minorPlayer') && event.minorPlayer.knows('distance') && event.minorPlayer.distance <= nearby"
    ],
    "values": {
      "cityState": "event.minorPlayer.knows('name') ? event.minorPlayer.name : null",
      "friend": "event.newAllyPlayer.knows('name') ? event.newAllyPlayer.name : null",
      "distance": "event.minorPlayer.distance"
    },
    "importance": "distance <= adjacent ? 60 : 55",
    "tags": ["politics", "international"]
  },
  {
    "id": "city-state-friendship-changes",
    "subject": "event",
    "event": "MinorFriendsChanged",
    "when": [
      "event.knows('majorPlayer') && event.majorPlayer.self === true",
      "event.knows('minorPlayer') && event.minorPlayer.knows('name')",
      "event.knows('isNowFriend') && typeof event.isNowFriend === 'boolean'"
    ],
    "values": {
      "cityState": "event.minorPlayer.knows('name') ? event.minorPlayer.name : null",
      "began": "event.isNowFriend === true",
      "friendship": "event.knows('newFriendship') && Number.isFinite(event.newFriendship) ? event.newFriendship : null"
    },
    "importance": "began ? 55 : 65",
    "tags": ["politics", "international"]
  },
  {
    "id": "city-state-quest-deadline-approaching",
    "subject": "player",
    "when": [
      "player.knows('cityState') && player.cityState === true",
      "player.knows('questDeadlines') && Array.isArray(player.questDeadlines)",
      "player.knows('questObservationTurn') && Number.isSafeInteger(player.questObservationTurn)",
      "player.questObservationTurn <= turn && turn - player.questObservationTurn <= 1",
      "player.questDeadlines.some(deadline => Number.isSafeInteger(deadline) && deadline >= turn && deadline <= turn + 3)"
    ],
    "values": {
      "turnsLeft": "(() => { const next = Math.min(...player.questDeadlines.filter(deadline => Number.isSafeInteger(deadline) && deadline >= turn && deadline <= turn + 3)); return next - turn; })()",
      "cityState": "player.knows('name') ? player.name : null"
    },
    "importance": 45,
    "tags": ["politics", "international"]
  },
  {
    "id": "city-state-timed-quest-observed",
    "subject": "player",
    "when": [
      "player.knows('cityState') && player.cityState === true",
      "player.knows('questDeadlines') && Array.isArray(player.questDeadlines)",
      "player.knows('questObservationTurn') && Number.isSafeInteger(player.questObservationTurn)",
      "player.questObservationTurn <= turn && turn - player.questObservationTurn <= 1",
      "player.knows('before')",
      "player.before.knows('questDeadlines') && Array.isArray(player.before.questDeadlines)",
      "player.questDeadlines.some(deadline => deadline > turn + 3 && !player.before.questDeadlines.includes(deadline))"
    ],
    "values": {
      "turnsLeft": "Math.min(...player.questDeadlines.filter(deadline => deadline > turn + 3 && !player.before.questDeadlines.includes(deadline))) - turn",
      "cityState": "player.knows('name') ? player.name : null"
    },
    "importance": 35,
    "tags": ["politics", "international"]
  },
  {
    "id": "foreign-major-wins-city-state",
    "subject": "event",
    "event": "SetAlly",
    "when": [
      "event.knows('newAllyPlayer') && event.newAllyPlayer.major && !event.newAllyPlayer.self",
      "event.knows('minorPlayer') && event.minorPlayer.knows('distance') && event.minorPlayer.distance <= neighboring",
      "!(event.knows('oldAllyPlayer') && event.oldAllyPlayer.self)"
    ],
    "values": {
      "cityState": "event.minorPlayer.knows('name') ? event.minorPlayer.name : null",
      "civilization": "event.newAllyPlayer.knows('name') ? event.newAllyPlayer.name : null",
      "distance": "event.minorPlayer.distance",
      "replaced": "event.knows('oldAllyPlayer') && event.oldAllyPlayer.knows('name') ? event.oldAllyPlayer.name : null"
    },
    "importance": "distance <= adjacent ? 75 : 62",
    "tags": ["politics", "international"]
  },
  {
    "id": "friendly-city-state-attacked",
    "subject": "incident",
    "when": [
      "incident.kind == 'war'",
      "incident.knows('role') && incident.role === 'none'",
      "incident.knows('target') && incident.target.knows('cityState') && incident.target.cityState === true",
      "incident.target.knows('at') && turn - incident.turn < long",
      "incident.target.at(turn - incident.turn + 1).is.friendlyCityState"
    ],
    "values": {
      "cityState": "incident.knows('target') && incident.target.knows('name') ? incident.target.name : null",
      "aggressor": "incident.knows('initiator') && incident.initiator.knows('name') ? incident.initiator.name : null"
    },
    "importance": 60,
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "friendly-city-state-captured",
    "subject": "event",
    "event": "CityCaptureComplete",
    "when": [
      "event.knows('oldOwner') && event.knows('newOwner')",
      "event.oldOwner.knows('cityState') && event.oldOwner.cityState === true",
      "event.newOwner.knows('major') && event.newOwner.major === true && event.newOwner.self === false",
      "event.knows('isConquest') && event.isConquest === true",
      "event.turn <= turn && turn - event.turn < long",
      "event.oldOwner.at(turn - event.turn + 1).is.friendlyCityState"
    ],
    "values": {
      "cityState": "event.oldOwner.knows('name') ? event.oldOwner.name : null",
      "captor": "event.newOwner.knows('name') ? event.newOwner.name : null",
      "cityName": "event.knows('city') && event.city.knows('name') ? event.city.name : null",
      "distance": "event.knows('distance') ? event.distance.own : null"
    },
    "importance": 70,
    "tags": ["politics", "military", "international"]
  }
]
