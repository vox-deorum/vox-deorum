[
  {
    "id": "our-wonder-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.knows('player') && event.player.self === true",
      "event.knows('building') && typeof event.building === 'string'",
      "event.knows('city') && event.city.knows('wonders') && Array.isArray(event.city.wonders)",
      "event.city.wonders.includes(event.building)"
    ],
    "values": {
      "wonder": "event.building"
    },
    "importance": 70,
    "tags": ["cities", "domestic"]
  },
  {
    "id": "great-works-added",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own",
      "city.knows('greatWorkCount') && Number.isFinite(city.greatWorkCount)",
      "city.knows('before') && city.before.knows('greatWorkCount') && Number.isFinite(city.before.greatWorkCount)",
      "city.before.knows('owner') && city.before.owner.self === true",
      "city.greatWorkCount > city.before.greatWorkCount"
    ],
    "values": {
      "added": "city.greatWorkCount - city.before.greatWorkCount",
      "total": "city.greatWorkCount"
    },
    "importance": "40 + 10 * added",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "enemy-wonder-nearby",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.owner.enemy",
      "city.distance.own <= nearby",
      "city.built.some(b => city.wonders.includes(b.building))"
    ],
    "values": { "wonder": "city.built.find(b => city.wonders.includes(b.building)).building" },
    "importance": "55"
  },
  {
    "id": "great-person-born",
    "subject": "event",
    "event": "UnitCreated",
    "when": [
      "event.knows('person')",
      "event.knows('kind') && event.kind === 'born'"
    ],
    "values": {
      "person": "event.person",
      "unit": "event.knows('unit') ? event.unit : null",
      "civilization": "event.knows('player') && event.player.knows('name') ? event.player.name : null",
      "ours": "event.knows('player') && event.player.self === true"
    },
    "importance": "ours ? 60 : 50",
    "tags": ["politics", "domestic"]
  }
]
