[
  {
    "id": "cultural-influence-becomes-influential-incoming",
    "subject": "player",
    "when": [
      "player.get('culturalInfluenceChanges')?.some(c => c.direction === 'incoming' && c.reachedInfluential && c.get('rival.name'))"
    ],
    "values": {
      "changeIndex": "player.culturalInfluenceChanges.findIndex(c => c.direction === 'incoming' && c.reachedInfluential && c.get('rival.name'))",
      "rival": "player.culturalInfluenceChanges[changeIndex].rival.name",
      "direction": "player.culturalInfluenceChanges[changeIndex].direction",
      "level": "player.culturalInfluenceChanges[changeIndex].level",
      "previousLevel": "player.culturalInfluenceChanges[changeIndex].previousLevel",
      "percentage": "player.culturalInfluenceChanges[changeIndex].percentage",
      "turnsToInfluential": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.get('turnsToInfluential') ?? null; })()",
      "tourismCultureRatio": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.get('tourismCultureRatio') ?? null; })()"
    },
    "tier": "major",
    "adjust": "player.stake.relation",
    "tags": ["culture", "international"]
  },
  {
    "id": "cultural-influence-becomes-influential-outgoing",
    "subject": "player",
    "when": [
      "player.get('culturalInfluenceChanges')?.some(c => c.direction === 'outgoing' && c.reachedInfluential && c.get('rival.name'))"
    ],
    "values": {
      "changeIndex": "player.culturalInfluenceChanges.findIndex(c => c.direction === 'outgoing' && c.reachedInfluential && c.get('rival.name'))",
      "rival": "player.culturalInfluenceChanges[changeIndex].rival.name",
      "direction": "player.culturalInfluenceChanges[changeIndex].direction",
      "level": "player.culturalInfluenceChanges[changeIndex].level",
      "previousLevel": "player.culturalInfluenceChanges[changeIndex].previousLevel",
      "percentage": "player.culturalInfluenceChanges[changeIndex].percentage",
      "turnsToInfluential": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.get('turnsToInfluential') ?? null; })()",
      "tourismCultureRatio": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.get('tourismCultureRatio') ?? null; })()"
    },
    "tier": "major",
    "adjust": "player.stake.relation",
    "tags": ["culture", "international"]
  },
  {
    "id": "cultural-influence-loses-influential-incoming",
    "subject": "player",
    "when": [
      "player.get('culturalInfluenceChanges')?.some(c => c.direction === 'incoming' && (c.previousLevel === 'Influential' || c.previousLevel === 'Dominant') && (c.level === 'Popular' || c.level === 'Familiar' || c.level === 'Exotic') && c.get('rival.name'))"
    ],
    "values": {
      "changeIndex": "player.culturalInfluenceChanges.findIndex(c => c.direction === 'incoming' && (c.previousLevel === 'Influential' || c.previousLevel === 'Dominant') && (c.level === 'Popular' || c.level === 'Familiar' || c.level === 'Exotic') && c.get('rival.name'))",
      "rival": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.rival.name; })()",
      "direction": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c ? c.direction : null; })()",
      "level": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c ? c.level : null; })()",
      "previousLevel": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c ? c.previousLevel : null; })()",
      "percentage": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c ? c.percentage : null; })()"
    },
    "tier": "major",
    "adjust": "player.stake.relation",
    "tags": ["culture", "international"]
  },
  {
    "id": "cultural-influence-loses-influential-outgoing",
    "subject": "player",
    "when": [
      "player.get('culturalInfluenceChanges')?.some(c => c.direction === 'outgoing' && (c.previousLevel === 'Influential' || c.previousLevel === 'Dominant') && (c.level === 'Popular' || c.level === 'Familiar' || c.level === 'Exotic') && c.get('rival.name'))"
    ],
    "values": {
      "changeIndex": "player.culturalInfluenceChanges.findIndex(c => c.direction === 'outgoing' && (c.previousLevel === 'Influential' || c.previousLevel === 'Dominant') && (c.level === 'Popular' || c.level === 'Familiar' || c.level === 'Exotic') && c.get('rival.name'))",
      "rival": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.rival.name; })()",
      "direction": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c ? c.direction : null; })()",
      "level": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c ? c.level : null; })()",
      "previousLevel": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c ? c.previousLevel : null; })()",
      "percentage": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c ? c.percentage : null; })()"
    },
    "tier": "notable",
    "adjust": "player.stake.relation",
    "tags": ["culture", "international"]
  },
  {
    "id": "cultural-influence-trend-turns-incoming",
    "subject": "player",
    "when": [
      "player.get('culturalInfluenceChanges')?.some(c => c.direction === 'incoming' && c.trendChanged && (c.trend === 'Rising' || c.trend === 'Falling') && c.get('rival.name'))",
      "!player.culturalInfluenceChanges.some(c => c.direction === 'incoming' && c.get('rival.name') && (c.reachedInfluential || ((c.previousLevel === 'Influential' || c.previousLevel === 'Dominant') && (c.level === 'Popular' || c.level === 'Familiar' || c.level === 'Exotic'))))"
    ],
    "values": {
      "changeIndex": "player.culturalInfluenceChanges.findIndex(c => c.direction === 'incoming' && c.trendChanged && (c.trend === 'Rising' || c.trend === 'Falling') && c.get('rival.name'))",
      "rival": "player.culturalInfluenceChanges[changeIndex].rival.name",
      "direction": "player.culturalInfluenceChanges[changeIndex].direction",
      "level": "player.culturalInfluenceChanges[changeIndex].level",
      "percentage": "player.culturalInfluenceChanges[changeIndex].percentage",
      "trend": "player.culturalInfluenceChanges[changeIndex].trend",
      "previousTrend": "player.culturalInfluenceChanges[changeIndex].previousTrend",
      "turnsToInfluential": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.get('turnsToInfluential') ?? null; })()",
      "tourismCultureRatio": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.get('tourismCultureRatio') ?? null; })()"
    },
    "tier": "routine",
    "adjust": "player.stake.relation",
    "tags": ["culture", "international"]
  },
  {
    "id": "cultural-influence-trend-turns-outgoing",
    "subject": "player",
    "when": [
      "player.get('culturalInfluenceChanges')?.some(c => c.direction === 'outgoing' && c.trendChanged && (c.trend === 'Rising' || c.trend === 'Falling') && c.get('rival.name'))",
      "!player.culturalInfluenceChanges.some(c => c.direction === 'outgoing' && c.get('rival.name') && (c.reachedInfluential || ((c.previousLevel === 'Influential' || c.previousLevel === 'Dominant') && (c.level === 'Popular' || c.level === 'Familiar' || c.level === 'Exotic'))))"
    ],
    "values": {
      "changeIndex": "player.culturalInfluenceChanges.findIndex(c => c.direction === 'outgoing' && c.trendChanged && (c.trend === 'Rising' || c.trend === 'Falling') && c.get('rival.name'))",
      "rival": "player.culturalInfluenceChanges[changeIndex].rival.name",
      "direction": "player.culturalInfluenceChanges[changeIndex].direction",
      "level": "player.culturalInfluenceChanges[changeIndex].level",
      "percentage": "player.culturalInfluenceChanges[changeIndex].percentage",
      "trend": "player.culturalInfluenceChanges[changeIndex].trend",
      "previousTrend": "player.culturalInfluenceChanges[changeIndex].previousTrend",
      "turnsToInfluential": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.get('turnsToInfluential') ?? null; })()",
      "tourismCultureRatio": "(() => { const c = player.culturalInfluenceChanges[changeIndex]; return c.get('tourismCultureRatio') ?? null; })()"
    },
    "tier": "routine",
    "adjust": "player.stake.relation",
    "tags": ["culture", "international"]
  },
  {
    "id": "enemy-wonder-nearby",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.knows('name')",
      "city.owner.enemy",
      "city.distance.own <= nearby",
      "city.built.some(b => city.wonders?.includes(b.get('building')))"
    ],
    "values": { "wonder": "city.built.find(b => city.wonders.includes(b.get('building'))).building" },
    "tier": "notable",
    "adjust": "city.owner.stake.relation"
  },
  {
    "id": "foreign-wonder-completed",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.knows('name') && city.owner.major && city.foreign",
      "city.wonders?.length > 0",
      "!(city.get('owner.enemy') && city.get('distance.own') <= nearby)",
      "city.built.some(b => city.wonders.includes(b.get('building')))"
    ],
    "values": {
      "wonder": "city.built.find(b => city.wonders.includes(b.get('building'))).building",
      "civilization": "city.owner.name"
    },
    "tier": "notable",
    "adjust": "city.owner.stake.relation",
    "tags": ["culture", "international"]
  },
  {
    "id": "great-person-born",
    "subject": "event",
    "event": "UnitCreated",
    "when": [
      "event.person",
      "event.kind === 'born'"
    ],
    "values": {
      "person": "event.person",
      "unit": "event.get('unit') ?? null",
      "civilization": "event.player.name",
      "ours": "event.player.self"
    },
    "tier": "ours ? 'notable' : 'routine'",
    "adjust": "event.player.stake.relation",
    "tags": ["politics", "domestic"]
  },
  {
    "id": "great-person-died",
    "subject": "event",
    "event": "UnitPrekill",
    "when": [
      "event.person",
      "event.kind === 'died'"
    ],
    "values": {
      "person": "event.person",
      "unit": "event.get('unit') ?? null",
      "civilization": "event.player.name",
      "ours": "event.player.self",
      "killer": "event.get('attackingPlayer.name') ?? null"
    },
    "tier": "ours ? 'notable' : 'routine'",
    "adjust": "event.player.stake.relation",
    "tags": ["politics", "military", "international"]
  },
  {
    "id": "great-person-expended",
    "subject": "event",
    "event": "GreatPersonExpended",
    "when": [
      "event.person",
      "event.kind === 'expended'"
    ],
    "values": {
      "person": "event.person",
      "unit": "event.get('unit') ?? null",
      "civilization": "event.player.name",
      "ours": "event.player.self"
    },
    "tier": "ours ? 'notable' : 'routine'",
    "adjust": "event.player.stake.relation",
    "tags": ["politics"]
  },
  {
    "id": "great-works-added",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own && city.knows('name')",
      "city.get('before.owner.self')",
      "city.greatWorkCount > city.get('before.greatWorkCount')"
    ],
    "values": {
      "added": "city.greatWorkCount - city.before.greatWorkCount",
      "total": "city.greatWorkCount"
    },
    "tier": "notable",
    "adjust": "Math.min(15, 5 * added)",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "great-works-lost",
    "subject": "city",
    "window": "recent",
    "when": [
      "city.own && city.knows('name')",
      "city.get('before.owner.self')",
      "city.greatWorkCount < city.get('before.greatWorkCount')"
    ],
    "values": {
      "lost": "city.before.greatWorkCount - city.greatWorkCount",
      "total": "city.greatWorkCount"
    },
    "tier": "notable",
    "adjust": "Math.min(15, 5 * lost)",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "our-wonder-completed",
    "subject": "event",
    "event": "CityConstructed",
    "when": [
      "event.player.self",
      "event.city.knows('name')",
      "event.city.wonders?.includes(event.building)"
    ],
    "values": {
      "wonder": "event.building"
    },
    "tier": "major",
    "tags": ["cities", "domestic"]
  },
  {
    "id": "tourism-output-leader-changes",
    "subject": "player",
    "window": "short",
    "when": [
      "player.major && player.tourismPerTurn > 0",
      "player.get('before.tourismPerTurn') !== undefined && player.before.rank('tourismPerTurn') > 1",
      "player.rank('tourismPerTurn') === 1",
      "players.some(p => p.id !== player.id && p.major && p.get('tourismPerTurn') !== undefined)"
    ],
    "values": {
      "civilization": "player.name",
      "tourism": "player.tourismPerTurn",
      "tied": "players.some(p => p.id !== player.id && p.get('major') && p.get('tourismPerTurn') === player.tourismPerTurn)"
    },
    "tier": "player.self ? 'major' : 'notable'",
    "tags": ["culture", "international"]
  }
]
