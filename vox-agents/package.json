{
  "name": "vox-agents",
  "version": "1.0.0",
  "description": "LLM-powered strategic AI agents for Civilization V that provide high-level decision making and strategy planning through the Vox Deorum system.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && node ../node_modules/typescript/bin/tsc && npm run build:newspaper && cd ui && npm run build",
    "type-check:newspaper": "tsc --noEmit -p tsconfig.newspaper.json",
    "build:newspaper": "npm run type-check:newspaper && vite build --config newspaper/vite.config.ts && node ../scripts/utilities/package-newspaper-sample.mjs",
    "acquire:texconv": "node ../scripts/utilities/acquire-texconv.mjs",
    "newspaper": "tsx src/newspaper/console.ts",
    "newspaper:preview": "tsx src/newspaper/preview-console.ts",
    "newspaper:screenshots": "tsx newspaper/src/preview/screenshots.ts",
    "newspaper:triggers": "node ../scripts/utilities/list-newspaper-triggers.mjs",
    "newspaper:sort-triggers": "node ../scripts/utilities/sort-newspaper-triggers.mjs",
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "start": "npm run build && npm run start:dist --",
    "start:dist": "node --inspect=0 --import ./dist/instrumentation.js --experimental-loader=@opentelemetry/instrumentation/hook.mjs dist/index.js",
    "strategist": "npm run build && npm run strategist:dist --",
    "strategist:dist": "node --inspect=0 --import ./dist/instrumentation.js --experimental-loader=@opentelemetry/instrumentation/hook.mjs dist/strategist/console.js",
    "telepathist": "npm run build && npm run telepathist:dist --",
    "telepathist:dist": "node --inspect=0 --import ./dist/instrumentation.js --experimental-loader=@opentelemetry/instrumentation/hook.mjs dist/telepathist/console.js",
    "oracle": "npm run build && npm run oracle:dist --",
    "oracle:dist": "node --inspect=0 --import ./dist/instrumentation.js --experimental-loader=@opentelemetry/instrumentation/hook.mjs dist/oracle/console.js",
    "test": "cross-env USE_MOCK=true vitest run",
    "test:mock": "cross-env USE_MOCK=true vitest run",
    "test:real": "cross-env USE_MOCK=false vitest run --passWithNoTests",
    "test:watch": "cross-env USE_MOCK=true vitest",
    "test:ui": "cross-env USE_MOCK=true vitest --ui",
    "test:coverage": "cross-env USE_MOCK=true vitest run --coverage",
    "test:game": "cross-env TEST_TIER=live/game vitest run",
    "test:obs": "cross-env TEST_TIER=live/obs vitest run",
    "test:claude-code": "cross-env TEST_TIER=live/claude-code vitest run",
    "test:newspaper:browser": "cross-env USE_MOCK=true TEST_TIER=browser/newspaper vitest run",
    "archivist": "npm run build && npm run archivist:dist --",
    "archivist:dist": "node --import ./dist/instrumentation.js dist/archivist/console.js",
    "archivist:cluster": "tsx src/archivist/cluster-console.ts",
    "workspace": "npm run build && npm run workspace:dist --",
    "workspace:dist": "node dist/agents/workspace/console.js",
    "narrator": "npm run build && npm run narrator:dist --",
    "narrator:dist": "node --inspect=0 --import ./dist/instrumentation.js --experimental-loader=@opentelemetry/instrumentation/hook.mjs dist/narrators/console.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "docs": "typedoc"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "acorn": "^8.15.0",
    "jsonc-parser": "^3.3.1",
    "just-bash": "^3.6.0",
    "mustache": "^4.2.0",
    "open": "^11.0.0",
    "openai": "^6.35.0",
    "quickjs-wasi": "^3.7.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6"
  }
}
