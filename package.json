{
  "name": "vox-deorum",
  "version": "1.0.0",
  "description": "Vox Deorum - LLM-Enhanced AI for Civilization V using the Community Patch framework",
  "private": true,
  "type": "module",
  "workspaces": [
    "bridge-service",
    "mcp-server",
    "vox-agents"
  ],
  "scripts": {
    "build:all": "npm run build -ws",
    "test:all": "npm run test -ws && npm --prefix vox-agents/ui run test",
    "lint:all": "npm run lint -ws",
    "format:docs": "prettier --write --prose-wrap never \"**/*.md\"",
    "archive:raw": "node scripts/utilities/archive-raw.mjs",
    "update:codex-proxy": "node scripts/utilities/update-codex-proxy.mjs",
    "vp-pr": "node scripts/utilities/vp-pr.mjs",
    "vp-diff": "node scripts/utilities/vp-diff.mjs",
    "update:dll": "node scripts/utilities/update-dll-pin.mjs",
    "update:claude-agent-sdk": "node scripts/utilities/update-claude-agent-sdk.mjs",
    "release": "node scripts/utilities/release.mjs",
    "clean:all": "npm run clean -ws --if-present"
  },
  "author": "John Chen",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=22.23.3"
  },
  "dependencies": {
    "@ai-sdk-tool/parser": "^5.1.6",
    "@ai-sdk/amazon-bedrock": "^5.0.89",
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/google-vertex": "^5.0.88",
    "@ai-sdk/openai": "^4.0.72",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@ai-sdk/provider": "^4.0.17",
    "@ai-sdk/typesafe-ai": "^3.0.4",
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@duckdb/node-api": "^1.4.4-r.3",
    "@google/genai": "^1.51.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.2.0",
    "@opentelemetry/instrumentation": "^0.204.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "ai": "^7.0.108",
    "ai-sdk-provider-claude-code": "^4.3.2",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.5.0",
    "better-sse": "^0.15.1",
    "change-case": "^5.4.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "eventsource": "^4.0.0",
    "express": "^4.21.2",
    "fast-fuzzy": "^1.12.0",
    "guard-timeout": "^2.0.0",
    "ini-api": "^1.2.0",
    "jaison": "~2.0.2",
    "kysely": "^0.28.5",
    "kysely-duckdb": "^0.2.0",
    "multer": "^2.0.2",
    "node-ipc": "^9.2.1",
    "obs-websocket-js": "^5.0.8",
    "p-limit": "^7.2.0",
    "p-queue": "^9.0.0",
    "papaparse": "^5.5.3",
    "pluralize-esm": "^9.0.5",
    "seedrandom": "^3.0.5",
    "tiktoken": "^1.0.22",
    "undici": "^7.30.2",
    "uuid": "^13.0.0",
    "windows-mutex-prebuilt": "^0.5.0",
    "winston": "^3.17.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/eventsource": "^1.1.15",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/node-ipc": "^9.2.3",
    "@types/papaparse": "^5.3.15",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.54.0",
    "jsdom": "^27.4.0",
    "kysely-codegen": "^0.20.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": "$@anthropic-ai/claude-agent-sdk",
    "guarded-fetch": {
      "undici": "$undici"
    },
    "minimatch@^10": "^11.0.5",
    "typedoc": {
      "minimatch": "10.2.6"
    }
  }
}
